// knip (Task #41, Fase K1): informe de código/dependencias sin uso. Se corre con `npm run analizar:muerto` (`knip`).
// Desde la Fase K3 (2026-09-27, noche) es uno de los 7 comandos OBLIGATORIOS del gate de verificación (AGENTS.md), CON
// código de salida — 0 hallazgos es la única corrida en verde; ya no es informativo. El informe clasificado de cada
// hallazgo (histórico, previo a K2/K3) vive en docs/informe-knip-2026-09-27.md.
//
// Regla de esta config: toda exclusión (ignore, ignoreDependencies, ignoreExportsUsedInFile, entry agregada a mano) lleva
// su motivo al lado. Lo que es muerto de verdad NO se ignora acá: tiene que seguir apareciendo en el informe hasta que
// K2 lo borre.
//
// Refrescado el 2026-09-27 (tarde), tras las Fases C y M8-M12d: la clasificación se rehizo contra el código de ese momento
// (ver la sección "Refresco" del informe). No hizo falta ninguna corrección NUEVA de falso positivo ni ninguna entrada
// NUEVA de RESERVADO: los hallazgos nuevos son todos MUERTO REAL (export sobrante o reexportación sin consumidor) y siguen
// apareciendo a propósito. Se verificó que las 5 correcciones de falso positivo de abajo siguen siendo necesarias (sin
// ellas vuelven a salir los 2 archivos, `cookies`/`headers`, `tailwindcss` y el hint de `.css`).
{
  "$schema": "./node_modules/knip/schema-jsonc.json",

  // Entradas que knip NO descubre solo. Las que sí descubre por sus plugins NO se repiten acá (si se listan, knip avisa
  // "Remove redundant entry pattern"): se verificó con la primera corrida que ya detecta
  //   - src/proxy.ts, src/instrumentation.ts y src/instrumentation-client.ts (plugin de Next.js: middleware de Next 16 +
  //     hooks de instrumentación de Sentry),
  //   - prisma/seed.ts (plugin de Prisma, vía `prisma.seed` de package.json y `npm run db:seed`),
  //   - vitest.config.ts y sus tests (plugin de Vitest),
  //   - playwright.config.ts y test/e2e/**/*.spec.ts (plugin de Playwright).
  // Desde E4 (2026-10-03) el repo es un workspace de npm con una app más (`plataforma/`, la consola de plataforma): las entradas y el
  // proyecto del raíz van bajo `workspaces["."]` (si se dejan arriba, knip las aplica TAMBIÉN a `plataforma/`, donde no existen, y avisa).
  "workspaces": {
    ".": {
      // RESERVADO — `@auth/core` llega con `next-auth` (no es dependencia directa). Lo importa SOLO `test/auth/contrato-authjs-vinculacion.test.ts`, por ruta de archivo,
      // para fijar el contrato de Auth.js que E8 necesita (`handleLoginOrRegister`, que el paquete no exporta): si una actualización lo cambia, ese test falla.
      "ignoreDependencies": ["@auth/core"],
  "entry": [
    // Scripts que se corren a mano (con `tsx` o como "test" de una config de Vitest propia): nadie los importa.
    "scripts/*.ts",
    // Igual, en la subcarpeta de los scripts de la consola de plataforma (`npm run plataforma:crear-admin`).
    "scripts/plataforma/*.ts",

    // Las 4 configs de Vitest que NO son la principal (seed de demo, seed de 6 meses, carta de "La Cuadra", invariantes
    // de la demo) y la config de Playwright de la demo. Se declaran como entradas a secas y NO en la sección `vitest` /
    // `playwright` de abajo a propósito: para leerlas como config, knip las EJECUTA, y todas corren al cargarse las
    // guardas de destino de scripts/demo-seed/guardas-destino.ts (tiran si falta MOTOR2_SEED_DATABASE_URL, y las de seed
    // si falta MOTOR2_SEED_CONFIRMAR). Poner esas variables en el script de knip para "calmar" la guarda sería justo el
    // tipo de atajo que esas guardas existen para impedir.
    "vitest.demo-invariantes.config.ts",
    "vitest.seed-6-meses.config.ts",
    "vitest.seed-carta-la-cuadra.config.ts",
    "vitest.seed.config.ts",
    "playwright.demo.config.ts",

    // `globalSetup` de playwright.demo.config.ts: como esa config no se ejecuta (ver arriba), knip no lee la referencia
    // (es un string con la ruta, no un import).
    "test/e2e-demo/global-setup-demo.ts",

    // Módulos que reemplazan a `server-only` y `next/headers` en TODAS las configs de Vitest vía `resolve.alias`
    // (`path.resolve(__dirname, "test/setup/...")`): son strings, no imports, así que knip no ve quién los usa y marcaba
    // el archivo `server-only-stub.ts` como sin uso y los exports `cookies`/`headers` de `next-headers-stub.ts` como sin
    // uso (en realidad los consume todo el código de src/ que importa `next/headers` cuando corre bajo Vitest).
    "test/setup/server-only-stub.ts",
    "test/setup/next-headers-stub.ts",

    // RESERVADO — prisma/fase-a/: schema y config experimentales de la Fase A de
    // multi-tenancy (docs/adr/ADR-004-fase-a-schema-aislado.md), deliberadamente
    // fuera de prisma/schema.prisma para no tocar el Client real ni el Postgres
    // local. Se invocan a mano vía `--schema`/`--config`, nunca importados desde
    // código — igual que el resto de esta lista.
    "prisma/fase-a/schema.prisma",
    "prisma/fase-a/prisma.config.ts",
    // Igual motivo: smoke test manual de esa carpeta, se corre a mano con
    // `npx tsx prisma/fase-a/smoke-test.ts`, nadie lo importa.
    "prisma/fase-a/smoke-test.ts"
  ],

  // Archivos que se analizan: src, test, scripts y prisma. Se incluyen `.css` (el `@import "tailwindcss"` de
  // globals.css es lo que usa la dependencia `tailwindcss`) y `.prisma` (el schema), que knip sabe leer: sin ellos
  // avisa "Compiled extension excluded by project (imports not followed)".
  "project": [
    "src/**/*.{ts,tsx,css}",
    "test/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "prisma/**/*.{ts,prisma}"
  ]
    },

    // La consola de plataforma: sus entradas (app/, proxy.ts) las descubre el plugin de Next.js. Su código importa del núcleo del raíz por el alias `@/`.
    "plataforma": {
      "project": ["src/**/*.{ts,tsx}"],
      // RESERVADO — la consola no importa `@sentry/nextjs` directamente, pero el envío de correo (`src/core/correo` → `src/lib/reportar-error.ts`)
      // lo importa de forma dinámica para avisar de un correo que no salió; ese código se compila DENTRO de la consola, así que su paquete
      // tiene que estar instalado en ese proyecto de Vercel. Sin esta línea, borrar la dependencia rompe el build de la consola en silencio.
      "ignoreDependencies": ["@sentry/nextjs"]
    }
  },


  // RESERVADO — tipos e interfaces exportados que solo se usan dentro de su propio archivo. Casi todos describen la forma
  // de lo que devuelve o recibe una función exportada (filas de reportes, entradas de armar-menu, etc.): son parte de la
  // firma pública del módulo y un consumidor puede necesitar nombrarlos. Quitarles el `export` no borra nada y solo
  // obliga a re-exportarlos el día que alguien los necesite. Los que no se usan NI en su archivo siguen apareciendo.
  // Los VALORES (funciones/constantes) exportados que solo se usan en su archivo NO se ignoran: son "export sobrante"
  // de verdad y quedan en el informe.
  // Refresco 2026-09-27 (tarde): la regla cubre ahora 101 tipos (eran 71). Los 32 nuevos son los `Codigo*`/`Datos*`/
  // `Motivo*`/`Desenlace*` de los schemas de comandos de la Fase M (core/features/{compras,cuentas,traspasos,ventas}/*.schema.ts)
  // y las filas que devuelven las cargas de server/persistencia/pos/: son las piezas del `Resultado*` exportado de cada
  // caso de uso, el mismo criterio de "parte de la firma pública". La regla NO alcanza (y no se agregó nada para ocultarlas)
  // las REEXPORTACIONES de tipo sin consumidor (`export type { X } from "./otro"` en la fachada core/reportes/periodo.ts):
  // no describen ninguna firma del archivo que las reexporta, así que siguen apareciendo como MUERTO REAL (reexportación
  // sobrante, mismo criterio que `CANTIDAD_MAXIMA_POR_ITEM` en core/pos/cuenta.ts).
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
