# Connection string de Neon — la del pooler (pgbouncer=true) para el
# runtime de la app (driver adapter, ver src/lib/db.ts).
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require&pgbouncer=true"
# Conexión directa (sin pooler) — la usan Prisma Migrate/CLI (prisma.config.ts).
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
# ADR-007 (A0): son DOS roles distintos. DATABASE_URL (runtime de la app y de los tests) usa `motor2_app`: sin
# superusuario, sin BYPASSRLS, sin ser dueño de las tablas (con RLS `ENABLE` sin `FORCE` el dueño lo salta).
# DIRECT_URL usa el DUEÑO (`motor2` en local): migrar, TRUNCATE de los E2E, seed. Local: el rol `motor2_app` se crea una
# vez, como superusuario, con scripts/operaciones/crear-rol-motor2-app.sql (la clave se pasa por `-v clave=...`):
#   DATABASE_URL="postgresql://motor2_app:<clave>@localhost:5432/motor2_dev"
#   DIRECT_URL="postgresql://motor2:<clave-del-dueño>@localhost:5432/motor2_dev"

# Auth.js
AUTH_SECRET="" # generar con: npx auth secret
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Bootstrap del primer admin (ver src/core/auth/bootstrap.ts) — lista de
# emails separados por coma. Solo importa mientras no exista ningún admin
# en el sistema; se puede vaciar después sin afectar nada.
BOOTSTRAP_ADMIN_EMAILS=""

# Gate de login (ver src/core/auth/acceso.ts) — dominios de Google
# Workspace separados por coma (ej: "tuempresa.com") que pueden loguear
# sin haber sido dados de alta a mano todavía. Alguien externo con Gmail
# personal igual puede entrar si un admin ya lo cargó en una sucursal.
ALLOWED_EMAIL_DOMAINS=""

# Sentry (observabilidad, ver src/instrumentation.ts) — el DSN no es
# secreto (viaja al navegador a propósito), pero va por env igual para no
# hardcodear un proyecto puntual en el código.
NEXT_PUBLIC_SENTRY_DSN=""

# Autentica los Vercel Cron DIARIOS (ver vercel.json): el que sincroniza el
# IPC (src/app/api/cron/sincronizar-ipc/route.ts) y el que trae el dólar
# oficial (src/app/api/cron/sincronizar-dolar/route.ts). Tiene que estar
# cargada en CADA proyecto de Vercel: sin ella los dos crons responden 401
# en silencio. Generar con: openssl rand -base64 32
CRON_SECRET=""

# Autentica a la carta pública (restaurant-menu-design) cuando lee el catálogo
# por GET /api/carta/[sucursal] (src/app/api/carta/[sucursal]/route.ts), el
# registro de tenants del portal por GET /api/carta/tenants
# (src/app/api/carta/tenants/route.ts) y el tema visual de cada sucursal por
# GET /api/carta/[sucursal]/tema (src/app/api/carta/[sucursal]/tema/route.ts),
# con `Authorization: Bearer <token>`: el mismo token para los tres
# (src/core/carta/autorizar-servicio.ts). Tiene que valer lo mismo que
# MOTOR2_CARTA_TOKEN en el proyecto de Vercel de la carta. Cargarla en CADA
# proyecto de Vercel de motor2: sin ella los tres endpoints responden 401
# siempre (y la carta cae a su menú de respaldo, a la tab "tenant" de su sheet
# maestra y a la tab "Config" de la sheet de cada tenant). Para rotarla sin
# cortar el servicio se admite una lista separada por comas ("nuevo,viejo").
# Generar con:
# openssl rand -base64 32
CARTA_API_TOKEN=""

# Base pública de la carta (restaurant-menu-design), sin barra final — solo para armar los links "Ver en vivo" del Portal
# de sucursales (src/app/(app)/carta/portal/page.tsx). Sin ella, esos links no se muestran (no rompe nada).
CARTA_PORTAL_URL=""

# ADR-006 (docs/adr/ADR-006-carta-como-modulo-interno.md): la carta pública absorbida como módulo interno de motor2.
# Slug de la única empresa real de hoy — mientras Empresa no exista en el schema real (Fase A), la carta pública resuelve
# la empresa comparando contra esta variable (src/core/carta/empresa-carta.ts), no contra la base.
CARTA_EMPRESA_SLUG=""

# Dominio base del subdominio de la carta pública nueva: carta.<CARTA_EMPRESA_SLUG>.<CARTA_DOMINIO_BASE>
# (src/core/carta/host.ts). Sin configurar, la carta solo se sirve por path directo (/carta-publica/...), sin subdominio.
# Se lee AL COMPILAR (rewrites de next.config.ts): tiene que estar en el entorno del build, no solo del arranque.
# En desarrollo local sirve "localhost": http://carta.<empresa>.localhost:3000/ (los navegadores resuelven *.localhost).
CARTA_DOMINIO_BASE=""

# Solo para pruebas y como palanca de emergencia: con "1", la aplicación NO
# intenta ponerse al día sola con el dólar cuando falta la cotización de hoy
# (ver actualizarDolarSiHaceFalta en src/core/reportes/cotizacion-dolar.ts).
# Playwright lo pone en playwright.config.ts para no salir a internet. En
# producción va vacía; ponerla en "1" en Vercel desactiva ese mecanismo sin
# tocar el código.
MOTOR2_SIN_DOLAR_AUTOMATICO=""

# Solo para scripts/benchmark-reportes.ts: base Postgres LOCAL Y APARTE
# (nunca la de DATABASE_URL de arriba, nunca Neon) donde ese script genera
# datos sintéticos masivos para medir reportes. El nombre de la base tiene
# que terminar en "_bench" — el script lo valida y aborta si no. Crear con:
#   psql -h localhost -U postgres -c 'CREATE DATABASE motor2_bench'
#   DIRECT_URL="postgresql://.../motor2_bench" npx prisma migrate deploy
MOTOR2_BENCH_DATABASE_URL=""

# Solo para los E2E de Playwright (playwright.config.ts): base Postgres LOCAL Y
# DEDICADA (nunca la de DATABASE_URL, nunca Neon) que cada corrida vacia por
# completo antes y despues (globalSetup/globalTeardown). El nombre de la base
# tiene que terminar en "_e2e": test/e2e/fixtures/base-e2e.ts valida host local
# y ese sufijo y aborta sin conectarse si no. No hay fallback a DATABASE_URL.
# Esta URL es la del DUEÑO (reset con TRUNCATE y migraciones). El runtime de los E2E (servidor y specs) usa
# MOTOR2_E2E_APP_DATABASE_URL: el rol `motor2_app` sobre la MISMA base (ADR-007, A0); sin fallback al dueño.
# Crear una vez con:
#   psql -h localhost -U postgres -c "CREATE DATABASE motor2_e2e OWNER motor2"
#   DIRECT_URL="postgresql://motor2:motor2@localhost:5432/motor2_e2e" npx prisma migrate deploy
MOTOR2_E2E_DATABASE_URL=""
MOTOR2_E2E_APP_DATABASE_URL=""

# Solo para los E2E: que servidor levanta Playwright. Vacio = "build" (compila el
# artefacto de produccion con `npm run build:e2e`, SIN prisma migrate deploy, y lo
# sirve con `next start`: es lo que se despliega). Otros valores: "start" (reusa el
# ultimo build, para depurar un spec) y "dev" (`next dev`, con overlay y HMR).
# Dejarlo en "dev" debilita el gate de cierre; el spec servidor-en-modo-produccion
# afirma el modo real y la salida imprime "[e2e] Servidor: <modo>".
MOTOR2_E2E_SERVIDOR=""

# Solo para los E2E: puerto donde Playwright levanta el servidor (playwright.config.ts).
# Sin definir = 56471. Sirve para correr varios worktrees en paralelo sin editar el
# archivo: MOTOR2_E2E_PUERTO=56472 npm run test:e2e. Va comentada a proposito: definida
# vacia ("") daria puerto 0 (el default solo aplica si la variable no existe).
# MOTOR2_E2E_PUERTO=56471

# Solo para scripts/seed-demo-pizzeria-6-meses.ts (el guion de 6 meses de "La
# Cuadra", docs/planes-demo-y-claridad-reportes-2026-09-21.md §5): base Postgres
# LOCAL Y DEDICADA (nunca la de DATABASE_URL, nunca Neon) que se llena con 6 meses
# de catalogo + movimientos. El nombre tiene que terminar en "_demo" —
# scripts/demo-seed/guardas-destino.ts valida host local y ese sufijo y aborta sin
# conectarse si no. No es idempotente ni borra nada: para rehacer sobre una base que
# ya tiene la demo hay que recrearla a mano primero. Requiere ademas
# MOTOR2_SEED_CONFIRMAR="si" (confirmacion explicita, nunca desde este archivo).
# Crear una vez con:
#   psql -h localhost -U postgres -c "CREATE DATABASE motor2_demo OWNER motor2"
#   DIRECT_URL="postgresql://motor2:motor2@localhost:5432/motor2_demo" npx prisma migrate deploy
#   DATABASE_URL="postgresql://motor2:motor2@localhost:5432/motor2_demo" npx tsx prisma/seed.ts
# Y correr con:
#   MOTOR2_SEED_DATABASE_URL="postgresql://motor2:motor2@localhost:5432/motor2_demo" \
#   MOTOR2_SEED_CONFIRMAR="si" \
#     npx vitest run --config vitest.seed-6-meses.config.ts
MOTOR2_SEED_DATABASE_URL=""
MOTOR2_SEED_CONFIRMAR=""
MOTOR2_SEED_REHACER=""
