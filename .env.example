# Connection string de Neon — la del pooler (pgbouncer=true) para el
# runtime de la app (driver adapter, ver src/lib/db.ts).
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require&pgbouncer=true"
# Conexión directa (sin pooler) — la usan Prisma Migrate/CLI (prisma.config.ts).
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js
AUTH_SECRET="" # generar con: npx auth secret
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Bootstrap del primer admin (ver src/core/auth/bootstrap.ts) — lista de
# emails separados por coma. Solo importa mientras no exista ningún admin
# en el sistema; se puede vaciar después sin afectar nada.
BOOTSTRAP_ADMIN_EMAILS=""
