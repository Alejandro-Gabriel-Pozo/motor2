# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# mutation testing (Stryker, `npm run mutacion`)
/reports
.stryker-tmp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# worktrees de agentes en background (Agent tool, isolation: "worktree")
.claude/worktrees/

# config local de Claude Code (puede tener permisos con secretos embebidos,
# ej. connection strings de DB) — nunca se commitea
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example se commitea a propósito: documenta las variables
# necesarias, sin valores reales)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (test/e2e)
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
playwright.local.config.ts
