generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================================================================
// IDENTIDAD (Auth.js) — nombres en inglés a propósito: @auth/prisma-adapter
// espera literalmente los modelos User/Account/Session/VerificationToken
// (son los accessors que usa internamente, prisma.user/prisma.account/...).
// Es infraestructura de autenticación, no dominio de negocio — coherente
// con la convención del proyecto (dominio en español, framework en inglés).
// ===================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  /// Kill-switch de cuenta a nivel sistema, distinto de "activo" por sucursal
  /// (ver UsuarioSucursal.activo) — equivalente a poder desactivar a alguien
  /// sin tener que tocar cada una de sus membresías.
  activoGlobal  Boolean   @default(true)
  creadoEn      DateTime  @default(now())

  accounts                  Account[]
  sessions                  Session[]
  sucursales                UsuarioSucursal[]
  operaciones               Operacion[]
  operacionesAnuladas       Operacion[]        @relation("OperacionAnuladaPor")
  conteosFisicos            ConteoFisico[]
  traspasosCreados          TraspasoSucursal[] @relation("TraspasoCreadoPor")
  traspasosDecididosOrigen  TraspasoSucursal[] @relation("TraspasoDecididoOrigen")
  traspasosDecididosDestino TraspasoSucursal[] @relation("TraspasoDecididoDestino")
  traspasosCerrados         TraspasoSucursal[] @relation("TraspasoCerradoPor")
  pagosConsignante          PagoConsignante[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================================================================
// DOMINIO: sucursales, roles y permisos
//
// Un solo negocio, varias sucursales (NO multi-tenant SaaS) — ver Contexto
// del plan. Roles y permisos son un catálogo ÚNICO compartido por todo el
// negocio (decisión confirmada con el dueño); el alcance por sucursal se
// resuelve aparte, en CapacidadSucursal y UsuarioSucursal, nunca como
// columna dentro de la matriz de permisos — patrón validado contra ERPNext
// ("User Permission" / "Company Restriction") frente a Dolibarr, que no
// tiene ningún gate de este tipo dentro de una misma empresa.
// ===================================================================

model Sucursal {
  id       String   @id @default(cuid())
  /// Equivalente a Hosterias.Nombre (Sucursales.js) — nombre visible único.
  nombre   String   @unique
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  /// Feature opcional apagada por defecto (Catalogo.js:2183, clave de Config
  /// "PromocionesHabilitado") — no todos los clientes arman combos; ver
  /// PromocionProducto abajo (porción Reportes).
  promocionesHabilitadas Boolean @default(false)

  usuarios             UsuarioSucursal[]
  capacidades          CapacidadSucursal[]
  secciones            Seccion[]
  operaciones          Operacion[]
  conteosFisicos       ConteoFisico[]
  preciosLocales       PrecioLocalProducto[]
  stockMinimos         StockMinimoProducto[]
  promociones          PromocionProducto[]
  traspasosComoOrigen  TraspasoSucursal[]    @relation("TraspasoOrigen")
  traspasosComoDestino TraspasoSucursal[]    @relation("TraspasoDestino")
  pagosConsignante     PagoConsignante[]
}

model Rol {
  id     String  @id @default(cuid())
  /// Catálogo único para todo el negocio — guardar siempre en minúscula,
  /// mismo criterio que ROLES_VALIDOS/obtenerRolesActivos_ en Core.js.
  nombre String  @unique
  activo Boolean @default(true)

  usuarios UsuarioSucursal[]
  permisos PermisoRol[]
}

/// Reemplaza el 1:1 "un usuario, una hostería" de hoy por N:M: una persona
/// puede tener rol distinto en cada sucursal donde participa. Análogo al
/// patrón "User Permission" de ERPNext (usuario restringido/asignado a
/// valores específicos de una dimensión), aplicado acá a Sucursal.
model UsuarioSucursal {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  rolId      String
  rol        Rol      @relation(fields: [rolId], references: [id])
  /// Equivalente a la columna "Activo" de la hoja Usuarios.
  activo     Boolean  @default(true)
  notas      String?
  creadoEn   DateTime @default(now())

  @@unique([usuarioId, sucursalId])
}

/// Catálogo de acciones gateables — clave global definida por el código
/// (no por cada sucursal), migrado 1:1 desde las semillas de
/// inicializarHojaPermisosSiFalta (Core.js:1293-1356).
model Accion {
  clave       String @id
  descripcion String

  permisos    PermisoRol[]
  capacidades CapacidadSucursal[]
}

/// Matriz única rol × acción para todo el negocio (normaliza la hoja
/// Permisos, hoy "Roles Editar"/"Roles Ver" como CSV en una celda).
/// Invariante de negocio (Core.js:1534, "Ver ⊇ Editar"): puedeEditar=true
/// implica puedeVer=true — se hace cumplir en la capa de aplicación
/// (actualizarPermisoDesdeAdmin, equivalente a actualizarPermisoDesdePanel).
model PermisoRol {
  id          String  @id @default(cuid())
  rolId       String
  rol         Rol     @relation(fields: [rolId], references: [id])
  accionClave String
  accion      Accion  @relation(fields: [accionClave], references: [clave])
  puedeVer    Boolean @default(false)
  puedeEditar Boolean @default(false)

  @@unique([rolId, accionClave])
}

/// Switch "esta acción está habilitada en esta sucursal", independiente del
/// rol — equivalente directo a CapacidadesSucursal (Sucursales.js) y al
/// patrón "Company Restriction" de ERPNext. sucursalId NULL = fila default
/// (mismo significado que "Sucursal" vacío hoy, Sucursales.js:594-601);
/// la migración inicial agrega un índice único parcial para permitir como
/// máximo UNA fila default por acción (ver migration.sql).
model CapacidadSucursal {
  id          String    @id @default(cuid())
  accionClave String
  accion      Accion    @relation(fields: [accionClave], references: [clave])
  sucursalId  String?
  sucursal    Sucursal? @relation(fields: [sucursalId], references: [id])
  habilitado  Boolean

  @@unique([accionClave, sucursalId])
}

// ===================================================================
// CATÁLOGO: productos, insumos/grupos, categorías, unidades,
// presentaciones, proveedores, recetas.
//
// Todo esto es Catálogo Central (HOJAS_CATALOGO_CENTRAL, Core.js/
// Catalogo.js) — compartido por todas las sucursales. Por eso NINGÚN
// modelo de acá abajo tiene sucursalId: el alcance por sucursal se
// resuelve, como en el resto del sistema, en CapacidadSucursal (gate de
// la Accion), nunca acá.
// ===================================================================

enum TipoProducto {
  MP
  PV
}

enum MagnitudUnidad {
  PESO
  VOLUMEN
  CANTIDAD
}

/// Reemplaza Hoja listado + Productos (Catalogo.js:213-344): en Sheets eran
/// dos hojas porque Apps Script no tiene transacciones/FK reales y
/// necesitaba una vista de lectura rápida aparte de la fuente de escritura.
/// Acá no hace falta: una sola tabla es fuente de verdad Y de lectura. Esto
/// elimina de raíz reconstruirProductosDesdeListado (Catalogo.js:72-177) y
/// la acción de permiso 'reconstruir_productos'.
model Producto {
  id     String       @id @default(cuid())
  /// Clave real, fija desde el alta. Autogenerada como `${tipo}_<uuid6>` si
  /// no se pasa a mano (Catalogo.js:1151) — ver src/core/catalogo/generar-codigo.ts.
  codigo String       @unique
  nombre String
  tipo   TipoProducto

  /// "Uso" (Catalogo.js:1053-1062) NO se persiste: es 100% derivable de
  /// `tipo` (MP siempre COMPRA, PV siempre VENTA, sesión "eliminar
  /// COMPRA+VENTA") — ver src/core/catalogo/producto.ts::usoDeTipo().

  /// Rubro comercial (Catalogo.js:2969-2989) — sin relación con Unidad.magnitud.
  categoriaId String?
  categoria   CategoriaProducto? @relation(fields: [categoriaId], references: [id])

  unidadCompraId   String?
  unidadCompra     Unidad? @relation("ProductoUnidadCompra", fields: [unidadCompraId], references: [id])
  unidadStockId    String
  unidadStock      Unidad  @relation("ProductoUnidadStock", fields: [unidadStockId], references: [id])
  /// Unidades de stock por 1 unidad de compra (Catalogo.js:1083/1095): > 0.
  factorConversion Decimal @default(1) @db.Decimal(14, 4)

  activo        Boolean @default(true)
  observaciones String?

  /// Solo tiene sentido si tipo=MP (Catalogo.js:951, 1723-1726) — un PV no
  /// se compra, no tiene Insumo. Se valida en la capa de aplicación, con el
  /// mismo criterio no-bloqueante que hoy (avisa, no impide el alta).
  insumoId String?
  insumo   Insumo? @relation(fields: [insumoId], references: [id])

  precioVenta Decimal @default(0) @db.Decimal(14, 2)

  /// Elegibilidad de receta (Catalogo.js:1723-1726): PV siempre elegible;
  /// MP solo si seProduce=true (se fabrica por lote, ej. una salsa base).
  seProduce Boolean @default(false)

  esConsignacion          Boolean    @default(false)
  proveedorConsignacionId String?
  proveedorConsignacion   Proveedor? @relation("ProveedorConsignacionDe", fields: [proveedorConsignacionId], references: [id])
  precioConsignacion      Decimal?   @default(0) @db.Decimal(14, 2)

  creadoEn DateTime @default(now())

  presentaciones       Presentacion[]
  proveedorPorProducto ProveedorPorProducto[]
  recetaVersiones      RecetaVersion[]        @relation("RecetaVersionProducto")
  usadoComoIngrediente RecetaIngrediente[]    @relation("RecetaIngredienteInsumo")
  movimientos          MovimientoStock[]
  conteosFisicos       ConteoFisico[]
  preciosLocales       PrecioLocalProducto[]
  stockMinimos         StockMinimoProducto[]
  promociones          PromocionProducto[]
  traspasos            TraspasoSucursal[]

  @@index([insumoId])
  @@index([categoriaId])
}

/// Nombre interno histórico "Familia" (Catalogo.js:180-197) — de cara al
/// usuario ya es "Insumo" desde v2.3.0; se adopta el nombre nuevo también
/// acá para no arrastrar la confusión al código nuevo.
model Insumo {
  id     String  @id @default(cuid())
  nombre String  @unique
  activo Boolean @default(true)

  /// Relación PLANA 1:1 (hoy "Grupos de Familia", una fila por Insumo) — no
  /// forma parte del árbol en sí, solo cuelga de un nodo de Grupo.
  grupoId String?
  grupo   Grupo?  @relation(fields: [grupoId], references: [id])

  productos Producto[]

  @@index([grupoId])
}

/// Árbol de Grupos sin límite de niveles (self-referencing), inspirado en
/// ERPNext Item Group (Catalogo.js:2410-2429). La prevención de ciclos
/// (creariaCicloGrupo_, Catalogo.js:2483-2489) NO es representable como
/// constraint de Postgres — se porta como función de aplicación (ver
/// src/core/catalogo/grupo.ts).
model Grupo {
  id           String  @id @default(cuid())
  nombre       String  @unique
  activo       Boolean @default(true)
  grupoPadreId String?
  grupoPadre   Grupo?  @relation("GrupoArbol", fields: [grupoPadreId], references: [id])
  hijos        Grupo[] @relation("GrupoArbol")

  insumos Insumo[]

  @@index([grupoPadreId])
}

/// Rubro comercial (Catalogo.js:2969-2989) — catálogo cerrado simple,
/// aplica a CUALQUIER producto (MP o PV). Sin jerarquía, sin relación con
/// el árbol de Grupo (ese agrupa Insumos, no productos de venta).
model CategoriaProducto {
  id        String     @id @default(cuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]
}

/// Catálogo cerrado (Catalogo.js:2634-2810). `magnitud` es solo
/// organizativo/default de decimales — NO valida conversión real entre
/// unidades (esa validación fuerte real es validarUnidadInsumo_: todos los
/// productos de un mismo Insumo deben compartir exactamente unidadStock).
model Unidad {
  id        String         @id @default(cuid())
  nombre    String         @unique
  magnitud  MagnitudUnidad
  activa    Boolean        @default(true)
  /// 0-6, validado en la capa de aplicación (Catalogo.js:2777).
  decimales Int            @default(2)

  productosPorUnidadCompra Producto[]             @relation("ProductoUnidadCompra")
  productosPorUnidadStock  Producto[]             @relation("ProductoUnidadStock")
  presentaciones           Presentacion[]
  proveedorPorProducto     ProveedorPorProducto[]
  recetaIngredientes       RecetaIngrediente[]
  recetaVersionesPorRendimiento RecetaVersion[] @relation("RecetaVersionRendimientoUnidad")
  recetaVersionesPorRacion      RecetaVersion[] @relation("RecetaVersionRacionUnidad")
}

/// Presentaciones de compra ALTERNATIVAS a la default de Producto
/// (unidadCompra/factorConversion propios) — Catalogo.js:3322-3472.
model Presentacion {
  id               String   @id @default(cuid())
  productoId       String
  producto         Producto @relation(fields: [productoId], references: [id])
  unidadCompraId   String
  unidadCompra     Unidad   @relation(fields: [unidadCompraId], references: [id])
  factorConversion Decimal  @db.Decimal(14, 4)
  activa           Boolean  @default(true)

  @@unique([productoId, unidadCompraId])
}

/// Maestro de Proveedores (Catalogo.js:3677-3775).
model Proveedor {
  id              String  @id @default(cuid())
  /// `PRV_<uuid6>` (Catalogo.js:3737) — mismo patrón de generación/colisión
  /// que Producto.codigo.
  codigo          String  @unique
  nombre          String  @unique
  contacto        String?
  telefono        String?
  email           String?
  cuit            String?
  condicionesPago String?
  notas           String?
  activo          Boolean @default(true)

  productosConsignados Producto[]             @relation("ProveedorConsignacionDe")
  proveedorPorProducto ProveedorPorProducto[]
  operaciones          Operacion[]
  pagosConsignante     PagoConsignante[]
}

/// Pago registrado a un proveedor de consignación, para saldar (parcial o
/// totalmente) el "Debido por consignante" de reportes/consignacion.ts.
/// Append-only, igual que el resto del Kardex: nunca se editan/borran las
/// líneas LIQUIDACION_CONSIGNACION para "saldarlas" — esto es un registro
/// aparte, y el reporte resta SUM(pagos) de SUM(liquidaciones) por
/// proveedor para llegar al saldo debido real.
model PagoConsignante {
  id          String    @id @default(cuid())
  sucursalId  String
  sucursal    Sucursal  @relation(fields: [sucursalId], references: [id])
  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])
  importe     Decimal   @db.Decimal(14, 4)
  fecha       DateTime
  notas       String?
  usuarioId   String
  usuario     User      @relation(fields: [usuarioId], references: [id])
  creadoEn    DateTime  @default(now())

  @@index([sucursalId, proveedorId])
}

/// Relación proveedor↔producto con precio normalizado a "precio por unidad
/// de stock" (Catalogo.js:3210-3320). Clave real: (producto, proveedor,
/// unidad de compra).
///
/// El UNIQUE de abajo + un upsert atómico (INSERT ... ON CONFLICT DO
/// UPDATE, ver src/server/actions/proveedor-por-producto.ts) hacen
/// ESTRUCTURALMENTE IMPOSIBLE la carrera cross-hostería documentada en el
/// propio código de Apps Script (Catalogo.js:3278-3294: dos sucursales
/// comprando el mismo insumo casi simultáneo duplicaban esta fila, hoy
/// mitigado DESPUÉS de escribir por fusionarDuplicadosProveedorPorProducto_,
/// Catalogo.js:3303-3320) — acá no hay nada que detectar ni fusionar.
model ProveedorPorProducto {
  id                   String    @id @default(cuid())
  productoId           String
  producto             Producto  @relation(fields: [productoId], references: [id])
  proveedorId          String
  proveedor            Proveedor @relation(fields: [proveedorId], references: [id])
  unidadCompraId       String
  unidadCompra         Unidad    @relation(fields: [unidadCompraId], references: [id])
  /// Precio "crudo" tal como lo cobra el proveedor en esa unidad de compra.
  precioUnitario       Decimal   @default(0) @db.Decimal(14, 4)
  /// Normalizado a precio por unidad de stock del producto — permite
  /// comparar presentaciones distintas del mismo Insumo.
  precioPorUnidadStock Decimal   @default(0) @db.Decimal(14, 4)
  ultimaCompra         DateTime  @default(now())
  /// Cómo llama ESTE proveedor a este producto (su propio código o
  /// nombre de catálogo) — nunca existió ni en la planilla vieja, que
  /// solo guardaba nuestro propio código. Puramente informativo, para
  /// reconocerlo más fácil al recargar una compra futura.
  referenciaProveedor  String?

  @@unique([productoId, proveedorId, unidadCompraId])
}

/// Versionado append-only real (Catalogo.js:1690-1779): NUNCA se pisa ni
/// borra una versión — una venta pasada referencia esa versión para
/// costeo/auditoría (Catalogo.js:1696-1706). `version` es un entero simple;
/// la vigente es SIEMPRE MAX(version) para ese producto, derivado, nunca
/// un flag a mantener transaccionalmente.
model RecetaVersion {
  id         String   @id @default(cuid())
  /// El plato (PV) o la MP con seProduce=true.
  productoId String
  producto   Producto @relation("RecetaVersionProducto", fields: [productoId], references: [id])
  version    Int
  creadoEn   DateTime @default(now())

  ingredientes RecetaIngrediente[]
  pasos        RecetaPaso[]

  /// Cabecera informativa — grounded contra Fudo (POS de gastronomía real,
  /// docs/grounding-ficha-tecnica-tandoor.md §6). Todo opcional: no rompe
  /// ninguna receta ya cargada, y no bloquea el guardado si se deja vacío.
  /// Viaja en la MISMA versión que ingredientes/pasos a propósito — es
  /// parte de la misma "foto" de qué receta exacta se usó (ver
  /// razonamiento completo en el documento, sección "Interacción con el
  /// versionado append-only").
  rendimientoCantidad Decimal? @db.Decimal(14, 4)
  rendimientoUnidadId String?
  rendimientoUnidad   Unidad?  @relation("RecetaVersionRendimientoUnidad", fields: [rendimientoUnidadId], references: [id])
  racionesCantidad    Int?
  /// Tamaño de CADA ración — distinto de rendimientoCantidad (lo que
  /// produce la receta ENTERA). Ej.: rendimiento "1 unidad" (la pizza
  /// entera), racionesCantidad 8, racionTamano 150 (gramos cada porción).
  racionTamano             Decimal? @db.Decimal(14, 4)
  racionUnidadId           String?
  racionUnidad             Unidad?  @relation("RecetaVersionRacionUnidad", fields: [racionUnidadId], references: [id])
  tiempoPreparacionMinutos Int?
  tiempoCoccionMinutos     Int?
  comentarios              String?
  /// Cómo se sirve el plato — distinto de los pasos de cocción (Fudo
  /// separa "Pasos del procedimiento" de "Presentación o emplatado").
  presentacionEmplatado String?
  notasAdicionales      String?
  /// Texto libre, un renglón = un ítem (ej. "Horno pizzero") — no amerita
  /// un catálogo de equipos propio, ver §6 del documento de grounding.
  equipamientoNecesario String?

  @@unique([productoId, version])
}

model RecetaIngrediente {
  id               String        @id @default(cuid())
  recetaVersionId  String
  recetaVersion    RecetaVersion @relation(fields: [recetaVersionId], references: [id], onDelete: Cascade)
  /// La MP consumida — FK real a Producto. Reemplaza el "renombrar por
  /// nombre en Recetas" de renombrarProductoEnHistorial_ (Catalogo.js:
  /// 1270-1314): renombrar un producto ahora es un UPDATE de una fila.
  insumoProductoId String
  insumoProducto   Producto      @relation("RecetaIngredienteInsumo", fields: [insumoProductoId], references: [id])
  cantidad         Decimal       @db.Decimal(14, 4)
  unidadId         String
  unidad           Unidad        @relation(fields: [unidadId], references: [id])
  mermaPorcentaje  Decimal       @default(0) @db.Decimal(6, 2)
  observaciones    String?

  enPasos RecetaPasoIngrediente[]

  @@index([insumoProductoId])
}

/// Paso de preparación — grounded contra Tandoor Recipes (`Step`) y Fudo
/// (docs/grounding-ficha-tecnica-tandoor.md). La mayoría de los pasos van
/// a ser instrucciones de texto simple sin ingredientes propios (Fudo ni
/// lo ofrece) — `ingredientes` (la sub-lista vía RecetaPasoIngrediente) es
/// la excepción puntual ("marinar con esto, salsa aparte"), no la norma.
model RecetaPaso {
  id              String        @id @default(cuid())
  recetaVersionId String
  recetaVersion   RecetaVersion @relation(fields: [recetaVersionId], references: [id], onDelete: Cascade)
  orden           Int
  nombre          String?
  instruccion     String
  minutos         Int?

  ingredientes RecetaPasoIngrediente[]

  @@index([recetaVersionId])
}

/// Tabla puente, no un FK simple en RecetaIngrediente — un mismo
/// ingrediente puede participar de más de un paso (ej. "sal" en dos
/// preparaciones distintas de la misma receta), mismo criterio que el M2M
/// real de Tandoor (`Step.ingredients`). No repite cantidad/unidad/merma —
/// eso sigue viviendo solo en RecetaIngrediente, el paso solo referencia.
model RecetaPasoIngrediente {
  id                  String            @id @default(cuid())
  recetaPasoId        String
  recetaPaso          RecetaPaso        @relation(fields: [recetaPasoId], references: [id], onDelete: Cascade)
  recetaIngredienteId String
  recetaIngrediente   RecetaIngrediente @relation(fields: [recetaIngredienteId], references: [id], onDelete: Cascade)

  @@unique([recetaPasoId, recetaIngredienteId])
}

// ===================================================================
// MOVIMIENTOS: Kardex (libro mayor de stock), operaciones, secciones,
// conteo físico y precio local por sucursal.
//
// A diferencia de Core/Catálogo (Catálogo Central, SIN sucursalId),
// TODO acá vive scopeado por sucursal — reemplaza el modelo viejo de
// "1 container de Apps Script = 1 sucursal, 1 Kardex propio" por
// sucursalId como columna real en una sola base compartida.
//
// Diseño en dos niveles, análogo a ERPNext (Stock Entry → Stock Ledger
// Entry), pero sin una tabla de "detalle" redundante: Operacion es el
// encabezado (lo que el usuario INICIÓ — gatea el permiso de Movimientos.js
// ACCION_POR_PROCESO_), MovimientoStock es cada línea del libro mayor (el
// EFECTO real sobre el stock: 1 fila = 1 movimiento con signo).
//
// Ver docs/plan-migracion.md, sección "Plan de la porción Movimientos",
// para la investigación completa (anclas archivo:línea) y las decisiones.
// ===================================================================

/// Los procesos gateables de ACCION_POR_PROCESO_ (Movimientos.js:510-525),
/// más LIQUIDACION_CONSIGNACION (Movimientos.js:250-258: generada SOLA por
/// confirmarRegistrarVenta_ConLock_/confirmarRegistrarMovimientos al
/// producir, nunca un proceso que un usuario elija — por eso no tiene
/// Accion propia en src/core/permisos/acciones.ts) y RECLASIFICACION
/// (Stock.js:1899-1991 — agregada en la porción Stock; NUNCA pasa por
/// TRANSICIONES en Apps Script porque no es una "acción de Permisos" con
/// su propio filtroTipo/exigeSeccion/etc., sino la primitiva de split
/// genérico del Conteo Físico — se gatea con 'proceso_control', mismo
/// permiso que Conteo Físico, no con una Accion propia).
///
/// TRANSFERENCIA_SALIDA_SUCURSAL/TRANSFERENCIA_ENTRADA_SUCURSAL/
/// REINGRESO_TRANSFERENCIA_SUCURSAL (Sucursales.js, porción Traspasos
/// entre sucursales) agregados acá — igual que RECLASIFICACION
/// (porción Stock), ninguno pasa por el motor genérico
/// (`registrarMovimiento`)/`TRANSICIONES`-como-entrada-de-ACCION_POR_PROCESO:
/// tienen su propio server action (`src/server/actions/traspasos.ts`),
/// gateado directo con `proceso_transferencia_sucursal` — la entrada en
/// `TRANSICIONES` (transiciones.ts) existe solo para que
/// `esSignoFijo`/`tieneStockReal` puedan resolverlas igual que cualquier
/// otro proceso al construir `MovimientoStock.cantidad` firmado.
enum Proceso {
  COMPRA
  PRODUCCION
  CONSUMO
  AJUSTE
  CONTROL
  TRANSFERENCIA
  MERMA
  VENTA
  DEVOLUCION_CONSIGNACION
  LIQUIDACION_CONSIGNACION
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  RECLASIFICACION
  TRANSFERENCIA_SALIDA_SUCURSAL
  TRANSFERENCIA_ENTRADA_SUCURSAL
  REINGRESO_TRANSFERENCIA_SUCURSAL
}

/// MOTIVOS_MERMA (Movimientos.js:56). En Apps Script esto se guardaba
/// plegado como texto dentro de "Movimiento detalle" ("no hace falta
/// cambiar el esquema" — el motivo real de esa limitación); acá hay schema
/// real, así que es una columna tipada de Operacion en vez de texto a
/// parsear para poder agrupar (Reportes.js: generarReportePerdidas_).
enum MotivoMerma {
  VENCIDO
  ROTO_O_CAIDO
  MAL_PREPARADO_O_QUEMADO
  /// Nombre aclarado a propósito en v-actual de Apps Script (BUGFIX A-3,
  /// AUDITORIA-movimientos.md): devuelto pero NO revendible → resta stock
  /// de verdad. Si es revendible, es DEVOLUCION_CLIENTE (proceso propio,
  /// signoStock +1), nunca este motivo.
  DEVOLUCION_CLIENTE_NO_REVENDIBLE
  ROBO_O_FALTANTE
  OTRO
}

/// DESTINOS_CONSUMO (Movimientos.js:59) — mismo criterio que MotivoMerma.
enum DestinoConsumo {
  PERSONAL
  DEGUSTACION_CORTESIA
  EVENTO
  ELABORACION_INTERNA
  OTRO
}

/// ACCIONES_CONTEO_FISICO (Stock.js:1066-1088).
enum AccionConteo {
  AJUSTAR
  FALTA_MOVIMIENTO
  DESCARTAR
}

/// Estados de ConteoFisico.estado (Stock.js: 'Resuelto'/'Pendiente'/
/// 'Descartado'/'Cancelado' — este último de cancelarConteoFisico,
/// Stock.js:2097-2141).
enum EstadoConteo {
  RESUELTO
  PENDIENTE
  DESCARTADO
  CANCELADO
}

/// Reemplaza HOJA_SECCIONES (Stock.js:1316-1415) — antes una hoja POR
/// CONTENEDOR (cada sucursal ya tenía sus propias Secciones porque cada
/// una era un spreadsheet separado); acá sucursalId es una columna real
/// porque ya no hay un contenedor propio que la implique.
model Seccion {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  nombre     String
  activa     Boolean  @default(true)

  operacionesTransferenciaDestino Operacion[]           @relation("OperacionSeccionDestino")
  movimientos                     MovimientoStock[]
  conteosFisicos                  ConteoFisico[]
  stockMinimos                    StockMinimoProducto[]
  traspasosComoSeccionOrigen      TraspasoSucursal[]    @relation("TraspasoSeccionOrigen")
  traspasosComoSeccionDestino     TraspasoSucursal[]    @relation("TraspasoSeccionDestino")

  /// Único índice funcional case/espacio-insensible por sucursal (mismo
  /// criterio que Producto/Proveedor/Insumo/... en la porción Catálogo) —
  /// agregar a mano en la migración generada, ver README.
  @@unique([sucursalId, nombre])
}

/// Encabezado de una confirmación de movimiento — agrupa 1+ líneas de
/// MovimientoStock que se escribieron JUNTAS en un solo confirm() (mismo
/// alcance que "ID Operación" en Kardex, Movimientos.js:963-974, pero como
/// FK real en vez de un UUID de texto compartido a ciegas entre filas).
///
/// GRANULARIDAD (importante, difiere por proceso — ver el comentario de
/// confirmarRegistrarMovimientos vs. confirmarRegistrarVenta_ConLock_ en
/// Movimientos.js): Compra/Ajuste/Consumo/Producción/Merma/Transferencia/
/// Devolución×2/Control → UNA Operacion cubre TODO el lote confirmado en
/// una sola llamada (varios productos). Venta → una Operacion POR CADA
/// venta individual del lote (cada línea vendida es su propio evento
/// económico, con su propia Liquidación de consignación si aplica) — un
/// solo confirmarRegistrarVenta con 3 ítems crea 3 filas Operacion, no 1.
///
/// `proceso` acá es el INICIADO por el usuario (lo que gatea el permiso,
/// ACCION_POR_PROCESO_) — NO necesariamente el de cada línea: una
/// Operacion de PRODUCCION o VENTA genera líneas hijas con OTRO proceso en
/// MovimientoStock.proceso (CONSUMO por cada MP de receta, y
/// LIQUIDACION_CONSIGNACION si esa MP es consignación) — ver el docstring
/// de MovimientoStock.proceso.
model Operacion {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  proceso    Proceso
  fecha      DateTime

  /// Compra/DevolucionProveedor (a quién se compra/devuelve) o Venta ("a
  /// quién se vende" — Movimientos.js:1769 usa 'Mostrador' como texto
  /// libre por defecto cuando no hay proveedor real; se modela como
  /// nullable en vez de forzar un Proveedor "Mostrador" ficticio).
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  nroFactura  String?

  /// Solo Transferencia (Movimientos.js:425-431, TRANSICIONES.TRANSFERENCIA
  /// no tiene exigeSeccion porque el origen YA es un campo obligatorio
  /// propio, distinto del "elegí sección" de los procesos que reparten
  /// stock existente). El origen de cada línea ya sale de
  /// MovimientoStock.seccionId — este campo es solo para no perder cuál
  /// era el destino elegido a nivel de la operación completa.
  seccionDestinoId String?
  seccionDestino   Seccion? @relation("OperacionSeccionDestino", fields: [seccionDestinoId], references: [id])

  /// Solo MERMA (Movimientos.js:56, MOTIVOS_MERMA) / CONSUMO
  /// (Movimientos.js:59, DESTINOS_CONSUMO) respectivamente — null para
  /// cualquier otro proceso, validado en la capa de aplicación (mismo
  /// criterio no-bloqueante-por-constraint que el resto del proyecto usa
  /// para reglas condicionadas por otro campo, ej. Producto.insumoId).
  motivo       MotivoMerma?
  destino      DestinoConsumo?
  /// Texto libre adicional (ctx.detalleLibre, Movimientos.js:767) — en
  /// Apps Script terminaba plegado dentro de "Movimiento detalle" de cada
  /// fila; acá queda en su propia columna, una vez por operación.
  detalleLibre String?

  /// NUEVO respecto a Apps Script: no existía ninguna columna "Usuario" en
  /// Kardex (Session.getActiveUser() del script deployado no se guardaba
  /// en ningún lado salvo en ConteosFisicos) — acá SÍ hay autenticación
  /// real por persona (Auth.js, porción Core), así que se agrega a
  /// propósito: saber quién registró cada operación es valioso y ahora es
  /// gratis, no es una expansión de alcance de esta porción.
  usuarioId String
  usuario   User   @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now())

  /// Solo VENTA — cuándo (y quién) la anuló con anularVenta. null = vigente.
  /// Mismo criterio append-only que ConteoFisico/cancelarConteoFisico:
  /// nunca se edita/borra esta fila ni sus MovimientoStock originales, el
  /// stock se corrige con una Operacion AJUSTE nueva aparte — esto solo
  /// marca la venta como anulada, para no poder anularla dos veces y para
  /// que Trazabilidad no la muestre como vigente.
  anuladaEn    DateTime?
  anuladaPorId String?
  anuladaPor   User?     @relation("OperacionAnuladaPor", fields: [anuladaPorId], references: [id])

  /// I3 — idempotencia (docs/auditoria-motor2-plan-i3-idempotencia-2026-09-17.md
  /// §2, §8, §11): UUID generado por el cliente al abrir el formulario,
  /// reenviado tal cual en reintentos del mismo intento de envío.
  /// Nulleable durante el rollout gradual (§9.3) — una Operacion sin
  /// clave simplemente no participa del mecanismo de deduplicación.
  /// Validada en la capa de aplicación como UUID (§11.1) antes de llegar
  /// acá. Único GLOBAL (no compuesto con sucursalId/proceso — §2.2,
  /// corregido tras revisión: el compuesto dejaba reutilizar la misma
  /// clave entre procesos distintos sin ningún choque).
  claveIdempotencia String?

  /// I3 — hash SHA-256 del payload validado que efectivamente se
  /// procesó (incluye sucursalId y un identificador de proceso — §11.2),
  /// para distinguir "mismo intento reenviado" de "clave reutilizada con
  /// datos distintos" (§3) sin comparar objetos JSON campo por campo.
  payloadHash String?

  /// I3 — Opción B (§4.5): mensaje de éxito ya formateado, persistido
  /// tal cual se devolvió al cliente la primera vez. Se relee sin
  /// reprocesar nada ante un duplicado — evita reconstruir lógica
  /// condicional de negocio (avisoConversion, liquidación de
  /// consignación) en un segundo lugar del código.
  resultadoMensaje String?

  movimientos MovimientoStock[]

  @@index([sucursalId, proceso, fecha])
  @@unique([claveIdempotencia])
}

/// Reemplaza Kardex/"Hoja 7" (Core.js:601, CONFIG.SHEETS.HISTORIAL) — el
/// libro mayor real. 1 fila = 1 movimiento de stock, YA CON EL SIGNO
/// APLICADO en `cantidad`.
///
/// DECISIÓN CLAVE (fuente única del signo, de una vez): en Apps Script
/// `cantidad` se guardaba SIN signo para los procesos de signo fijo
/// (Compra/Consumo/Venta/Merma/...) y el signo se aplicaba recién AL LEER
/// (signoDeProceso_() en acumularMovimientoEnSaldoMap_, Stock.js:214-231)
/// — eso es EXACTAMENTE lo que causó el bug de MERMA en v2.1.0
/// (Movimientos.js:433-455: se agregó MERMA a TRANSICIONES con signoStock
/// -1, pero la lista de signos vivía duplicada aparte y nadie la
/// actualizó — una merma se registraba pero no descontaba nada). Acá NO
/// hay una segunda fuente que mantener sincronizada: `cantidad` se graba
/// YA multiplicada por el signo del proceso en el momento de escribir (ver
/// el `Proceso`/TRANSICIONES-equivalente en código, a implementar en
/// src/core/movimientos/), así que el saldo de cualquier producto/sección/
/// lote es SIEMPRE `SUM(cantidad)` — sin excepción por proceso, sin tabla
/// paralela, sin lookup al leer.
///
/// `proceso` es el efecto REAL de esta línea puntual — para la mayoría de
/// las Operacion es igual a Operacion.proceso, pero DIFIERE en las dos que
/// generan hijos (Movimientos.js: generaConsumoDeReceta): una Operacion
/// PRODUCCION escribe 1 línea proceso=PRODUCCION (+lo producido) y N
/// líneas proceso=CONSUMO (−cada MP de receta, con LIQUIDACION_CONSIGNACION
/// extra si esa MP es consignación); una Operacion VENTA escribe 1 línea
/// proceso=VENTA (el PV vendido) + N líneas proceso=CONSUMO + Liquidación
/// si aplica. Ver signoDeProceso_/esDeltaConSignoLibre_ (Movimientos.js:
/// 452-485) para qué procesos son signo fijo vs. delta con signo libre —
/// para AJUSTE/CONTROL/TRANSFERENCIA el valor YA viene con el signo que
/// cargó/calculó el usuario, ninguna multiplicación adicional al escribir.
///
/// Kardex es APPEND-ONLY, siempre — ni renombrar un producto (ver
/// Producto.codigo como FK real de abajo, ya no hace falta reescribir
/// filas viejas como renombrarProductoEnHistorial_) ni cancelar un conteo
/// (Stock.js:2077-2141) editan una fila existente: cancelar escribe una
/// fila de REVERSIÓN nueva con el mismo ConteoFisico enlazado.
model MovimientoStock {
  id          String    @id @default(cuid())
  operacionId String
  operacion   Operacion @relation(fields: [operacionId], references: [id])

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  seccionId  String
  seccion    Seccion  @relation(fields: [seccionId], references: [id])
  proceso    Proceso

  /// Ya con signo — ver el docstring del modelo. + entra, − sale.
  cantidad        Decimal   @db.Decimal(14, 4)
  /// FEFO simplificado (Stock.js:403-425, IDEA-conteo-fisico-por-lote.md):
  /// a propósito NO hay una entidad "Lote" separada ni tracking FIFO real
  /// — es la misma simplificación deliberada de Apps Script, portada tal
  /// cual (una salida sin lote elegido asume el que vence antes; si eso
  /// queda mal, se corrige con Conteo Físico/Reclasificación).
  loteVencimiento DateTime? @db.Date

  /// Texto calculado por línea (conversión de unidad, peso real, etc. —
  /// Movimientos.js:766-812) — el CÓMO, no el POR QUÉ (eso es
  /// Operacion.motivo/destino/detalleLibre).
  detalle String

  /// Precio Total = importe real de ESTA línea (Compra: lo que dice la
  /// factura para esa línea; Venta: cantidadVendida × precioVenta vigente
  /// al momento — Movimientos.js:1287). 0 para líneas que no representan
  /// un hecho financiero propio (Consumo, Transferencia, Ajuste/Control).
  precioTotal          Decimal @default(0) @db.Decimal(14, 2)
  /// Precio por unidad de STOCK — permite comparar compras en
  /// presentaciones distintas del mismo producto (mismo criterio que
  /// ProveedorPorProducto.precioPorUnidadStock, porción Catálogo).
  precioPorUnidadStock Decimal @default(0) @db.Decimal(14, 4)

  /// Solo proceso VENTA, desde 2026-09-17: costo de la receta del PV
  /// (calcularCostosYMargenes, BOM recursivo) resuelto EN EL MOMENTO de
  /// vender — no se recalcula después. Existe para que Reportes → Período
  /// pueda comparar cada venta contra el costo que regía ESE día, en vez de
  /// contra el costo de reposición de HOY (ver docs/comparativa-ux-erpnext-
  /// dolibarr.md §7.3/§9, "margen nominal" vs "margen real"). `null` en dos
  /// casos: ventas de antes de este campo (no hay forma de reconstruirlo
  /// retroactivo sin una serie histórica de costos), o el costeo estaba
  /// incompleto en el momento de vender (mismo criterio que costoIncompleto
  /// en costos.ts — no se inventa un número parcial).
  costoUnitarioVenta Decimal? @db.Decimal(14, 4)

  /// Solo si esta línea la generó un ajuste de Conteo Físico (incluida su
  /// eventual reversión al cancelar) — reemplaza la correlación por texto
  /// "idOperacion === idConteo" (Stock.js:2129, Kardex e HOJA_CONTEOS_FISICOS
  /// comparten el mismo UUID a ciegas) por una FK real.
  conteoFisicoId String?
  conteoFisico   ConteoFisico? @relation(fields: [conteoFisicoId], references: [id])

  /// Solo si esta línea la generó un paso de un Traspaso entre sucursales
  /// (salida/entrada/reingreso) — mismo criterio que `conteoFisicoId`: FK
  /// real en vez de comparar el "ID Operación" de texto contra el ID del
  /// traspaso (Sucursales.js pasaba `idTraspaso` como `idOperacion` a
  /// ciegas, ver escribirMovimientoTransferenciaSucursal_).
  traspasoSucursalId String?
  traspasoSucursal   TraspasoSucursal? @relation(fields: [traspasoSucursalId], references: [id])

  creadoEn DateTime @default(now())

  /// Clave de lectura real: "¿cuánto hay de este producto, en esta
  /// sección, de este lote?" — SUM(cantidad) filtrando por estos 3 campos.
  /// A diferencia de Apps Script (HOJA_STOCK, una hoja materializada
  /// mantenida a mano por aplicarMovimientosAStockIncremental_ porque
  /// rescanear TODO Kardex en cada venta se volvía proporcional a la
  /// historia completa de la hostería, Stock.js:268-294), acá Postgres
  /// puede sumar sobre este índice en tiempo real sin necesidad de
  /// mantener una segunda tabla a mano — si el volumen real lo justifica
  /// más adelante, una vista materializada (REFRESH bajo demanda, o
  /// mantenida por trigger) es una optimización de la porción Stock, no
  /// una tabla que Movimientos tenga que duplicar y sincronizar él mismo.
  @@index([productoId, seccionId, loteVencimiento])
  @@index([operacionId])
}

/// Reemplaza HOJA_CONTEOS_FISICOS/"ConteosFisicos" (Stock.js:1043-1141) —
/// la bitácora de auditoría de cada conteo (separada del Kardex: un
/// conteo con acción FALTA_MOVIMIENTO o DESCARTAR no mueve stock, pero
/// igual queda registrado que se contó).
model ConteoFisico {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  fecha      DateTime

  productoId      String
  producto        Producto  @relation(fields: [productoId], references: [id])
  seccionId       String
  seccion         Seccion   @relation(fields: [seccionId], references: [id])
  /// El LOTE contado (puede quedar vacío: "total, sin lote puntual" — ver
  /// Stock.js:1094-1103), no la fecha del conteo (esa es `fecha` arriba).
  loteVencimiento DateTime? @db.Date

  saldoSistema Decimal @db.Decimal(14, 4)
  conteoReal   Decimal @db.Decimal(14, 4)
  /// = conteoReal − saldoSistema, guardado (no recalculado) porque es
  /// histórico: referencia el saldo del momento del conteo, no el actual.
  diferencia   Decimal @db.Decimal(14, 4)

  accion  AccionConteo
  estado  EstadoConteo
  detalle String?

  usuarioId String
  usuario   User   @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now())

  /// 0, 1 (ajuste original) o 2 (ajuste + reversión al cancelar) líneas de
  /// Kardex generadas por este conteo — ver el docstring de
  /// MovimientoStock.conteoFisicoId.
  movimientos MovimientoStock[]

  @@index([sucursalId, productoId, seccionId])
}

/// Reemplaza HOJA_PRECIO_LOCAL/"Precio Local" (Catalogo.js:2043-2077) —
/// HUECO REAL encontrado investigando Venta (armarPreviaVentaDesdeItems_,
/// Movimientos.js:1751-1759, lee precioVenta YA resuelto con override
/// local vía resolverPrecioVenta_): la porción Catálogo nunca modeló esto
/// porque en Apps Script vive en la hoja LOCAL de cada hostería (no en
/// HOJAS_CATALOGO_CENTRAL), no porque no hiciera falta — sin esto, Venta
/// no puede calcular el precio real cobrado por sucursal. Se agrega acá,
/// no en Catálogo, porque el único consumidor funcional es Venta.
/// `precio_local` ya está seedeado en ACCIONES (acciones.ts) desde Core,
/// anticipando esta porción.
model PrecioLocalProducto {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  precio     Decimal  @db.Decimal(14, 2)
  /// Local si está cargado Y habilitado; si no, fallback a
  /// Producto.precioVenta (mismo criterio que resolverPrecioVenta_,
  /// Catalogo.js:2072-2077) — no se borra la fila al deshabilitar, mismo
  /// patrón que el resto del catálogo (activo/habilitado, nunca DELETE).
  habilitado Boolean  @default(true)

  @@unique([sucursalId, productoId])
}

// ===================================================================
// STOCK: mínimos por sucursal/sección y la primitiva de Reclasificación.
//
// A diferencia de Apps Script (HOJA_STOCK/StockConsolidado/StockFamilia/
// AlertasStock — hojas MATERIALIZADAS, recalculadas enteras en cada
// recalcularX(), porque rescanear Kardex en cada lectura era proporcional
// a toda la historia acumulada), acá esas 3 vistas NO son tablas: son
// consultas en vivo sobre MovimientoStock/ConteoFisico (ver
// src/core/stock/*.ts) — el mismo argumento que ya justificó no
// materializar el saldo simple en la porción Movimientos (ver el
// docstring de MovimientoStock) aplica con más razón acá: Postgres agrega
// en tiempo real sobre índices reales, no hay necesidad de una segunda
// copia de los datos que se pueda desincronizar del Kardex. Lo único que
// esta porción agrega de verdad como TABLA es la configuración de Stock
// Mínimo (dato que el sistema no puede derivar de ningún otro lado).
// ===================================================================

/// Reemplaza HOJA_STOCK_MINIMO/"Stock Minimo" (Catalogo.js:1922-2019) —
/// mismo patrón que PrecioLocalProducto: vive local a cada sucursal (no es
/// Catálogo Central). `seccionId` nulo = fila "global" de esa sucursal
/// (aplica salvo que haya una fila más específica para esa sección) —
/// mismo criterio de resolución que resolverStockMinimo_ (gana la fila de
/// la sección exacta si existe, si no la global). El índice único parcial
/// para "como máximo una fila global por sucursal+producto" se agrega a
/// mano en la migración (mismo criterio que CapacidadSucursal.sucursalId
/// NULL) — ver README.
model StockMinimoProducto {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  seccionId  String?
  seccion    Seccion? @relation(fields: [seccionId], references: [id])
  minimo     Decimal  @db.Decimal(14, 4)

  @@unique([productoId, seccionId])
}

// ===================================================================
// REPORTES: el resto de la porción (período, costos, pérdidas,
// devoluciones, vencimientos, diferencias de ajuste, salud por producto,
// trazabilidad, historial por producto, etc.) es 100% lectura en vivo
// sobre Operacion/MovimientoStock/ConteoFisico/RecetaVersion ya existentes
// — no agrega ninguna tabla nueva (ver src/core/reportes/*.ts). Promociones
// y Combos es la única excepción real: es un catálogo LOCAL (por sucursal,
// no Catálogo Central — la misma "Menú ejecutivo" puede ser promoción en
// una sucursal y plato normal en otra, Catalogo.js:2170-2173) que el
// sistema no puede derivar de ningún otro dato.
// ===================================================================

/// Reemplaza HOJA_PROMOCIONES/"Promociones" (Catalogo.js:2182-2251) — qué
/// PV cuenta como Promoción/Combo para obtenerReportePromociones_
/// (src/core/reportes/promociones.ts). Fila ausente = no marcado (mismo
/// criterio que "no aparece en el mapa" de Apps Script); no se borra al
/// desmarcar, se pone `activa=false` (mismo patrón que el resto del
/// catálogo).
model PromocionProducto {
  id         String   @id @default(cuid())
  sucursalId String
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  activa     Boolean  @default(true)

  @@unique([sucursalId, productoId])
}

// ===================================================================
// TRASPASOS ENTRE SUCURSALES (Sucursales.js) — última porción funcional.
//
// DIFERENCIA CLAVE con Apps Script: ahí cada sucursal ("hostería") es un
// proyecto Apps Script + planilla separado, sin ningún canal de ejecución
// directo entre proyectos — por eso `TraspasosSucursales` es una tabla del
// Catálogo Central que cada lado lee/escribe de forma asincrónica (una
// bandeja), y hace falta un registro aparte (`Hosterias`) + una hoja
// Config local (`NombreHosteria`) solo para que cada proyecto sepa "quién
// es". Acá, motor2 es una única app Next.js sobre una única base
// Postgres — todas las sucursales ya son filas reales de `Sucursal`
// (Core), visibles a cualquier request autenticado, y un usuario ya sabe
// "quién es" vía su `ContextoUsuario.sucursalId` (la sucursal ACTIVA de su
// sesión, misma noción que "esta hostería" en Apps Script). No hace falta
// portar ni el registro de hosterías ni el nombre configurable — el WORKFLOW
// de aprobación (que SÍ importa: el stock no se teletransporta, alguien
// tiene que confirmar que lo recibió) es lo único que se porta.
// ===================================================================

/// PULL (el Destino pide) vs. PUSH (el Origen manda directo) — decide qué
/// lado creó la fila y en qué estado arranca (Sucursales.js:19-25).
enum IniciadoPorTraspaso {
  ORIGEN
  DESTINO
}

/// Ciclo completo (Sucursales.js:19-25, comentario de cabecera):
/// PULL: SOLICITADA -(Origen aprueba)-> ENVIADA -(Destino acepta)-> ACEPTADA
///                   -(Origen rechaza)-> RECHAZADA_ORIGEN (fin, nunca tocó stock)
/// PUSH: ENVIADA (ya con el stock afuera al crearse) -(Destino acepta)-> ACEPTADA
///                                                    -(Destino rechaza)-> RECHAZADA_DESTINO -(Origen confirma reingreso)-> CERRADA
enum EstadoTraspaso {
  SOLICITADA
  ENVIADA
  ACEPTADA
  RECHAZADA_ORIGEN
  RECHAZADA_DESTINO
  CERRADA
  /// Quien creó una solicitud PULL (SOLICITADA) la cancela ella misma,
  /// antes de que Origen decida — nunca tocó stock, así que no hace falta
  /// ningún reingreso. Distinto de RECHAZADA_ORIGEN (decisión de Origen).
  CANCELADA
}

/// Reemplaza HOJA_TRASPASOS_SUCURSALES/"TraspasosSucursales"
/// (Sucursales.js:175-193) — mismas 22 columnas, ahora con FKs reales en
/// vez de texto (nombre de sucursal, código de producto) y sin la
/// redundancia "Codigo"/"Unidad" (ya resuelven vía `producto`/
/// `producto.unidadStock`). `seccionOrigenId`/`seccionDestinoId` quedan
/// null hasta que ese lado decide (recién Origen sabe de qué Sección sale
/// al aprobar/enviar; recién Destino sabe a cuál entra al aceptar).
model TraspasoSucursal {
  id       String   @id @default(cuid())
  creadoEn DateTime @default(now())

  origenSucursalId  String
  origenSucursal    Sucursal @relation("TraspasoOrigen", fields: [origenSucursalId], references: [id])
  destinoSucursalId String
  destinoSucursal   Sucursal @relation("TraspasoDestino", fields: [destinoSucursalId], references: [id])

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Decimal  @db.Decimal(14, 4)

  seccionOrigenId  String?
  seccionOrigen    Seccion? @relation("TraspasoSeccionOrigen", fields: [seccionOrigenId], references: [id])
  seccionDestinoId String?
  seccionDestino   Seccion? @relation("TraspasoSeccionDestino", fields: [seccionDestinoId], references: [id])

  iniciadoPor IniciadoPorTraspaso
  estado      EstadoTraspaso      @default(SOLICITADA)

  creadoPorId String
  creadoPor   User    @relation("TraspasoCreadoPor", fields: [creadoPorId], references: [id])
  detalle     String?

  /// Decisión de ORIGEN: aprobar+enviar una Solicitada (PULL), o rechazarla
  /// (-> RECHAZADA_ORIGEN). En un envío directo (PUSH) esto se llena YA en
  /// el momento de crear la fila (Origen decidió mandar, no hay nada que
  /// "aprobar" después).
  fechaDecisionOrigen DateTime?
  decididoPorOrigenId String?
  decididoPorOrigen   User?     @relation("TraspasoDecididoOrigen", fields: [decididoPorOrigenId], references: [id])
  motivoRechazoOrigen String?

  /// Decisión de DESTINO: aceptar una Enviada (-> ACEPTADA), o rechazarla
  /// (-> RECHAZADA_DESTINO, todavía no devuelve el stock — eso lo confirma
  /// Origen aparte, `fechaCierre`/`cerradoPor` abajo).
  fechaDecisionDestino DateTime?
  decididoPorDestinoId String?
  decididoPorDestino   User?     @relation("TraspasoDecididoDestino", fields: [decididoPorDestinoId], references: [id])
  motivoRechazoDestino String?

  /// Solo se llena si Destino rechazó y Origen confirmó el reingreso a su
  /// propio stock (-> CERRADA) — el único otro cierre real (ACEPTADA) no
  /// necesita un campo aparte, el `estado` ya lo dice.
  fechaCierre  DateTime?
  cerradoPorId String?
  cerradoPor   User?     @relation("TraspasoCerradoPor", fields: [cerradoPorId], references: [id])

  movimientos MovimientoStock[]

  @@index([origenSucursalId, estado])
  @@index([destinoSucursalId, estado])
}

// ===================================================================
// ÍNDICES ECONÓMICOS — Método 1 de ajuste de margen (docs/comparativa-
// ux-erpnext-dolibarr.md §9/§10), retroactivo pero con dependencia
// externa: a diferencia de MovimientoStock.costoUnitarioVenta (Método 3,
// congela el costo al vender, solo hacia adelante), esto ajusta el
// INGRESO histórico a poder adquisitivo de HOY vía el IPC del INDEC, así
// que sí sirve para ventas ya cargadas.
// ===================================================================

/// Un valor de índice por mes calendario — se sincroniza desde la API de
/// series de tiempo del Ministerio de Economía (apis.datos.gob.ar, serie
/// 101.1_I2NG_2016_M_22, IPC GBA Nivel General base dic-2016), nunca a
/// mano. Un mes ya guardado NUNCA se reescribe (el IPC de un mes cerrado
/// no cambia) — sincronizarIPC (core/reportes/indices-economicos.ts) solo
/// inserta los meses que todavía no están.
model IndicePrecio {
  id       String   @id @default(cuid())
  mes      DateTime @unique @db.Date
  valor    Decimal  @db.Decimal(12, 4)
  creadoEn DateTime @default(now())
}
