generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

// ===================================================================
// IDENTIDAD (Auth.js) — nombres en inglés a propósito: @auth/prisma-adapter
// espera literalmente los modelos User/Account/Session/VerificationToken
// (son los accessors que usa internamente, prisma.user/prisma.account/...).
// Es infraestructura de autenticación, no dominio de negocio — coherente
// con la convención del proyecto (dominio en español, framework en inglés).
// ===================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  /// Kill-switch de cuenta a nivel sistema, distinto de "activo" por sucursal
  /// (ver UsuarioSucursal.activo) — equivalente a poder desactivar a alguien
  /// sin tener que tocar cada una de sus membresías.
  activoGlobal  Boolean   @default(true)
  creadoEn      DateTime  @default(now())

  accounts                   Account[]
  sessions                   Session[]
  sucursales                 UsuarioSucursal[]
  operaciones                Operacion[]
  operacionesAnuladas        Operacion[]          @relation("OperacionAnuladaPor")
  conteosFisicos             ConteoFisico[]
  invitacionesAceptadas      Invitacion[]         @relation("InvitacionAceptadaPor")
  invitacionesHechas         Invitacion[]         @relation("InvitacionInvitadoPor")
  invitacionesSucursalHechas InvitacionSucursal[]
  agregadosDeCuenta          AgregadoDeCuenta[]
  reclasificacionesDeRenglon ReclasificacionRenglon[]
  distribucionesDeCostoCreadas DistribucionCostoVersion[]
  versionesDeOpcionCreadas   VersionDeOpcion[]
  opcionesApagadasEnSucursal OpcionApagadaEnSucursal[]
  entradasDelDiaActualizadas EntradaDelDiaDeCupo[]
  recetasDeCombinacionCreadas RecetaDeCombinacionVersion[]
  ventas                     Venta[]
  facturasProvCreadas        FacturaProveedor[]   @relation("FacturaProveedorCreadaPor")
  facturasProvConfirmadas    FacturaProveedor[]   @relation("FacturaProveedorConfirmadaPor")
  facturasProvAnuladas       FacturaProveedor[]   @relation("FacturaProveedorAnuladaPor")
  notasDeCreditoCreadas      NotaCreditoProveedor[] @relation("NotaCreditoProveedorCreadaPor")
  notasDeCreditoAnuladas     NotaCreditoProveedor[] @relation("NotaCreditoProveedorAnuladaPor")
  partesRecibidas FacturaProveedorSucursal[] @relation("FacturaProveedorParteRecibidaPor")
  traspasosCreados           TraspasoSucursal[]   @relation("TraspasoCreadoPor")
  traspasosDecididosOrigen   TraspasoSucursal[]   @relation("TraspasoDecididoOrigen")
  traspasosDecididosDestino  TraspasoSucursal[]   @relation("TraspasoDecididoDestino")
  traspasosCerrados          TraspasoSucursal[]   @relation("TraspasoCerradoPor")
  pagosConsignante           PagoConsignante[]
  registrosAuditoria         RegistroAuditoria[]
  cuentasAbiertas            Cuenta[]             @relation("CuentaAbiertaPor")
  cuentasCerradas            Cuenta[]             @relation("CuentaCerradaPor")
  cuentaItemsCreados         CuentaItem[]         @relation("CuentaItemCreadoPor")
  ejemplaresTicketEmitidos   EjemplarTicket[]     @relation("EjemplarTicketEmitidoPor")
  promosCreadas              PromoCuenta[]
  empresas                   UsuarioEmpresa[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================================================================
// DOMINIO: sucursales, roles y permisos
//
// Instalación multiempresa-capable (ADR-007), activada con UNA empresa: cada
// tabla de dominio lleva `empresaId` (default `app_empresa_actual()`, que con
// una sola empresa activa devuelve esa) y las referencias entre ellas son FK
// compuestas [empresaId, xId]. Rol/PermisoRol/Unidad son por empresa (D3).
// RLS (migración 2, A6): política `aislamiento_empresa` en esas tablas; el rol de
// ejecución `motor2_app` la cumple y el dueño la salta (`ENABLE`, sin `FORCE`).
// Prisma no expresa políticas: viven solo en la migración, no acá.
// Dentro de una empresa, el alcance por sucursal se resuelve aparte, en
// CapacidadSucursal y UsuarioSucursal, nunca como columna dentro de la matriz
// de permisos — patrón validado contra ERPNext ("User Permission" / "Company
// Restriction") frente a Dolibarr, que no tiene ningún gate de este tipo
// dentro de una misma empresa. Globales (sin empresaId): User, Account,
// Session, VerificationToken, Accion, IndicePrecio, CotizacionDolar.
// ===================================================================

model Sucursal {
  id        String   @id @default(cuid())
  empresaId String   @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  /// Equivalente a Hosterias.Nombre (Sucursales.js) — nombre visible único.
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  /// Cupo de mesas ABIERTAS a la vez en esta sucursal (módulo POS, docs/plan-comensales-y-limite-mesas-2026-09-26.md). `null` (default) =
  /// sin límite. Se cuenta como "abierta" toda `Cuenta` con `cerradaEn IS NULL` de una mesa de esta sucursal — no la cantidad de `Mesa`
  /// dadas de alta. Se edita con el mismo permiso que da de alta mesas (`pos_mesas`, Editar — src/server/actions/pos/mesas.ts). Bajarlo
  /// por debajo de las mesas ya abiertas NO cierra ninguna: solo bloquea aperturas nuevas hasta que se libere o cierre alguna
  /// (`abrirCuenta`, chequeo dentro de la misma transacción serializable que crea la `Cuenta`).
  maxMesasAbiertas Int?

  usuarios                 UsuarioSucursal[]
  capacidades              CapacidadSucursal[]
  secciones                Seccion[]
  operaciones              Operacion[]
  conteosFisicos           ConteoFisico[]
  preciosLocales           PrecioLocalProducto[]
  stockMinimos             StockMinimoProducto[]
  seccionesHabituales      SeccionHabitualProducto[]
  frecuenciasConteo        FrecuenciaConteoProducto[]
  disponibilidadesProducto DisponibilidadProducto[]
  traspasosComoOrigen      TraspasoSucursal[]            @relation("TraspasoOrigen")
  traspasosComoDestino     TraspasoSucursal[]            @relation("TraspasoDestino")
  pagosConsignante         PagoConsignante[]
  registrosAuditoria       RegistroAuditoria[]
  promosCarta              PromoCartaSucursal[]
  descuentosProducto       DescuentoProductoSucursal[]
  publica                  SucursalPublica?
  temaCarta                TemaCartaSucursal?
  mesas                    Mesa[]
  rendimientosLocales      RendimientoLocalIngrediente[]
  recetasPropias           RecetaSucursal[]
  contenidosCarta          ContenidoCartaProducto[]
  generosCarta             GeneroCarta[]
  itemsAgrupadosCarta      ItemAgrupadoCarta[]
  opcionesAgrupadasCarta   OpcionItemAgrupadoCarta[]
  versionesDeRecetaPropia  RecetaVersion[]               @relation("RecetaVersionSucursal")
  ejemplaresTicket         EjemplarTicket[]
  ventas                   Venta[]
  facturaProveedorPartes   FacturaProveedorSucursal[]
  imputacionesDeGasto      ImputacionDeGasto[]
  imputacionesDeNotaCredito NotaCreditoProveedorImputacion[]
  planesDeCostos           PlanDeCostosSucursal[]
  preciosLocalesDeOpcion   PrecioLocalDeOpcion[]
  opcionesApagadas         OpcionApagadaEnSucursal[]
  entradasDelDia           EntradaDelDiaDeCupo[]
  preciosLocalesDeCombinacion PrecioLocalDeCombinacion[]
  invitacionSucursals      InvitacionSucursal[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
}

model Rol {
  id        String  @id @default(cuid())
  empresaId String  @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  /// Catálogo único para todo el negocio — guardar siempre en minúscula,
  /// mismo criterio que ROLES_VALIDOS/obtenerRolesActivos_ en Core.js.
  nombre    String
  /// Identidad estable de un rol de SISTEMA ("admin", "operador"); null en un rol creado a mano. El nombre se puede cambiar (bloque G3), la clave no:
  /// es lo que el código compara para saber QUÉ rol es. Una empresa tiene a lo sumo un rol por clave.
  clave     String?
  activo    Boolean @default(true)

  usuarios UsuarioSucursal[]
  permisos PermisoRol[]

  invitaciones InvitacionSucursal[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, clave])
  @@unique([empresaId, id])
}

/// Reemplaza el 1:1 "un usuario, una hostería" de hoy por N:M: una persona
/// puede tener rol distinto en cada sucursal donde participa. Análogo al
/// patrón "User Permission" de ERPNext (usuario restringido/asignado a
/// valores específicos de una dimensión), aplicado acá a Sucursal.
model UsuarioSucursal {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  rolId      String
  rol        Rol      @relation(fields: [empresaId, rolId], references: [empresaId, id])
  /// Equivalente a la columna "Activo" de la hoja Usuarios.
  activo     Boolean  @default(true)
  notas      String?
  creadoEn   DateTime @default(now())

  @@unique([usuarioId, sucursalId])
  @@unique([empresaId, id])
}

/// Catálogo de acciones gateables — clave global definida por el código
/// (no por cada sucursal), migrado 1:1 desde las semillas de
/// inicializarHojaPermisosSiFalta (Core.js:1293-1356).
model Accion {
  clave       String @id
  descripcion String

  permisos    PermisoRol[]
  capacidades CapacidadSucursal[]
}

/// Matriz única rol × acción para todo el negocio (normaliza la hoja
/// Permisos, hoy "Roles Editar"/"Roles Ver" como CSV en una celda).
/// Invariante de negocio (Core.js:1534, "Ver ⊇ Editar"): puedeEditar=true
/// implica puedeVer=true — se hace cumplir en la capa de aplicación
/// (actualizarPermisoDesdeAdmin, equivalente a actualizarPermisoDesdePanel).
model PermisoRol {
  id          String  @id @default(cuid())
  empresaId   String  @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa @relation(fields: [empresaId], references: [id])
  rolId       String
  rol         Rol     @relation(fields: [empresaId, rolId], references: [empresaId, id])
  accionClave String
  accion      Accion  @relation(fields: [accionClave], references: [clave])
  puedeVer    Boolean @default(false)
  puedeEditar Boolean @default(false)

  @@unique([rolId, accionClave])
  @@unique([empresaId, id])
}

/// Switch "esta acción está habilitada en esta sucursal", independiente del
/// rol — equivalente directo a CapacidadesSucursal (Sucursales.js) y al
/// patrón "Company Restriction" de ERPNext. sucursalId NULL = fila default
/// (mismo significado que "Sucursal" vacío hoy, Sucursales.js:594-601);
/// la migración inicial agrega un índice único parcial para permitir como
/// máximo UNA fila default por acción (ver migration.sql).
model CapacidadSucursal {
  id          String    @id @default(cuid())
  empresaId   String    @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  accionClave String
  accion      Accion    @relation(fields: [accionClave], references: [clave])
  sucursalId  String?
  sucursal    Sucursal? @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  habilitado  Boolean

  @@unique([accionClave, sucursalId])
  @@unique([empresaId, id])
}

/// Auditoría administrativa (A3, Pivote 6 — docs/auditoria-motor2-pivotes-
/// 2026-09-16.md "Pivote 6", docs/auditoria-motor2-fase6-seguridad-
/// 2026-09-18.md): catálogo/precios/permisos no pasan por el Kardex y no
/// tenían NINGÚN rastro de quién cambió qué y cuándo — ni siquiera un
/// `updatedAt` genérico. Registro append-only GENÉRICO (nunca se edita ni
/// se borra una fila) — no una tabla de historial por modelo tipo
/// `RecetaVersion`: cada fila es UN cambio de UN campo escalar puntual
/// (un precio, un booleano de permiso), no una estructura compuesta, así
/// que alcanza para reconstruir el valor vigente en cualquier momento
/// pasado ordenando por `creadoEn`, sin necesidad de versionar la fila
/// entera. `entidadId` es una referencia liviana (sin FK real — apunta a
/// modelos distintos según `entidad`, y el registro tiene que sobrevivir
/// aunque la fila referenciada se borre en el futuro) — `descripcion` ya
/// viene armada y legible al momento de escribir, para no depender de un
/// JOIN futuro contra una fila que podría ya no existir.
model RegistroAuditoria {
  id            String    @id @default(cuid())
  empresaId     String    @default(dbgenerated("app_empresa_actual()"))
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  /// "Producto" | "PrecioLocalProducto" | "PermisoRol" | "CapacidadSucursal" | "Rol" | "Operacion"
  entidad       String
  entidadId     String
  /// Legible de entrada, ej. `Producto "Pan Francés": precio de venta`.
  descripcion   String
  /// Nombre técnico del campo cambiado, ej. "precioVenta" — para filtrar/agrupar.
  campo         String
  valorAnterior String?
  valorNuevo    String?
  actorId       String
  actor         User      @relation(fields: [actorId], references: [id])
  /// Sucursal relevante si el cambio es específico de una (ej. Precio
  /// Local, Capacidad por sucursal) — null si es global (ej. Producto,
  /// Rol, Permisos, que son Catálogo Central sin alcance por sucursal).
  sucursalId    String?
  sucursal      Sucursal? @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  creadoEn      DateTime  @default(now())

  @@unique([empresaId, id])
  @@index([entidad, entidadId])
  @@index([actorId])
  @@index([creadoEn])
}

// ===================================================================
// CATÁLOGO: productos, insumos/grupos, categorías, unidades,
// presentaciones, proveedores, recetas.
//
// Todo esto es Catálogo Central (HOJAS_CATALOGO_CENTRAL, Core.js/
// Catalogo.js) — compartido por todas las sucursales. Por eso NINGÚN
// modelo de acá abajo tiene sucursalId: el alcance por sucursal se
// resuelve, como en el resto del sistema, en CapacidadSucursal (gate de
// la Accion), nunca acá.
// ===================================================================

enum TipoProducto {
  MP
  PV
}

enum MagnitudUnidad {
  PESO
  VOLUMEN
  CANTIDAD
}

/// Reemplaza Hoja listado + Productos (Catalogo.js:213-344): en Sheets eran
/// dos hojas porque Apps Script no tiene transacciones/FK reales y
/// necesitaba una vista de lectura rápida aparte de la fuente de escritura.
/// Acá no hace falta: una sola tabla es fuente de verdad Y de lectura. Esto
/// elimina de raíz reconstruirProductosDesdeListado (Catalogo.js:72-177) y
/// la acción de permiso 'reconstruir_productos'.
model Producto {
  id        String       @id @default(cuid())
  empresaId String       @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa      @relation(fields: [empresaId], references: [id])
  /// Clave real, fija desde el alta. Autogenerada como `${tipo}_<uuid6>` si
  /// no se pasa a mano (Catalogo.js:1151) — ver src/core/catalogo/generar-codigo.ts.
  codigo    String
  nombre    String
  tipo      TipoProducto

  /// "Uso" (Catalogo.js:1053-1062) NO se persiste: es 100% derivable de
  /// `tipo` (MP siempre COMPRA, PV siempre VENTA, sesión "eliminar
  /// COMPRA+VENTA"). Donde hace falta, se deriva de `tipo` en el momento.

  /// Rubro comercial (Catalogo.js:2969-2989) — sin relación con Unidad.magnitud.
  categoriaId String?
  categoria   CategoriaProducto? @relation(fields: [empresaId, categoriaId], references: [empresaId, id])

  unidadCompraId   String?
  unidadCompra     Unidad? @relation("ProductoUnidadCompra", fields: [empresaId, unidadCompraId], references: [empresaId, id])
  unidadStockId    String
  unidadStock      Unidad  @relation("ProductoUnidadStock", fields: [empresaId, unidadStockId], references: [empresaId, id])
  /// Unidades de stock por 1 unidad de compra (Catalogo.js:1083/1095): > 0.
  factorConversion Decimal @default(1) @db.Decimal(14, 4)

  observaciones String?

  /// Solo tiene sentido si tipo=MP (Catalogo.js:951, 1723-1726) — un PV no
  /// se compra, no tiene Insumo. Se valida en la capa de aplicación, con el
  /// mismo criterio no-bloqueante que hoy (avisa, no impide el alta).
  insumoId String?
  insumo   Insumo? @relation(fields: [empresaId, insumoId], references: [empresaId, id])

  /// Con IVA incluido (D-IVA): lo que paga el cliente. El neto sin IVA se deduce con la alícuota, no se guarda.
  precioVenta Decimal @default(0) @db.Decimal(14, 2)

  /// Fase 4 de la ola «precio y carta» (ADR-035): cómo se vende. `DIRECTO` (default): tiene su precio (`precioVenta`). `BASE_CONFIGURABLE`: se vende por opción, el precio final está en cada
  /// opción de su grupo de medida en ABSOLUTO y `precioVenta` se CONSERVA pero queda bloqueado (no se cobra ni se edita). Lista cerrada (`MODOS_DE_VENTA` en src/core/opciones/tipos.ts) con los
  /// CHECK "Producto_modoDeVenta_check" y "Producto_modoDeVenta_base_check" (solo un PV que no se produce) que agrega la migración a mano (Prisma no declara CHECK).
  modoDeVenta String @default("DIRECTO")

  /// M0-IVA: alícuota de IVA con la que se VENDE este producto y la que trae la factura de proveedor cuando se COMPRA. Código semántico de lista cerrada
  /// (`ALICUOTAS_IVA` en src/core/fiscal/iva.ts), con los CHECK "Producto_alicuotaIvaVenta_check" y "Producto_alicuotaIvaCompra_check" que agrega la
  /// migración a mano (Prisma no declara CHECK). NULL = «sin declarar» (ninguna fila existente recibe un valor deducido). Que la de venta solo tenga
  /// sentido en un PV y la de compra en una MP se valida en la capa de aplicación (Etapa C), no en la base.
  alicuotaIvaVenta  String?
  alicuotaIvaCompra String?

  /// Venta fraccionada (Task #25, docs/plan-venta-fraccionada-2026-09-26.md): excepción de venta PUNTUAL de este PV — ej. 0.5
  /// para "esta pizza se vende de a 1 o de a media". null (default) = comportamiento actual, sin cambios (una unidad entera por
  /// línea). Solo tiene sentido si tipo=PV (se valida en la capa de aplicación, `validarPasoVenta`, src/core/catalogo/venta-
  /// fraccionada.ts). Migración puramente aditiva, sin backfill.
  ///
  /// R3 (la precondición que cuida `validarPasoVenta`): el paso NUNCA amplía la precisión de algo con STOCK REAL — si este
  /// producto "se produce" (`seProduce`, stock propio en el Kardex), sus decimales tienen que entrar en los que admite su
  /// `unidadStock` (si no, se rechaza al guardar); si no se produce (se cocina al momento, sin fila propia en el Kardex), el
  /// paso es libre. Dos transiciones cuidan esto DESPUÉS del alta: marcar `seProduce` en un producto con un paso ya
  /// inconsistente, y bajar `Unidad.decimales` por debajo de lo que algún producto "se produce" con paso necesita — las dos se
  /// revalidan y bloquean (ver `actualizarProducto`/`actualizarDecimalesUnidad`).
  pasoVenta Decimal? @db.Decimal(14, 4)

  /// Elegibilidad de receta (Catalogo.js:1723-1726): PV siempre elegible;
  /// MP solo si seProduce=true (se fabrica por lote, ej. una salsa base).
  seProduce Boolean @default(false)

  esConsignacion          Boolean    @default(false)
  proveedorConsignacionId String?
  proveedorConsignacion   Proveedor? @relation("ProveedorConsignacionDe", fields: [empresaId, proveedorConsignacionId], references: [empresaId, id])
  precioConsignacion      Decimal?   @default(0) @db.Decimal(14, 2)

  creadoEn DateTime @default(now())

  presentaciones            Presentacion[]
  proveedorPorProducto      ProveedorPorProducto[]
  recetaVersiones           RecetaVersion[]             @relation("RecetaVersionProducto")
  recetasPorSucursal        RecetaSucursal[]
  usadoComoIngrediente      RecetaIngrediente[]         @relation("RecetaIngredienteInsumo")
  movimientos               MovimientoStock[]
  conteosFisicos            ConteoFisico[]
  preciosLocales            PrecioLocalProducto[]
  stockMinimos              StockMinimoProducto[]
  seccionesHabituales       SeccionHabitualProducto[]
  frecuenciasConteo         FrecuenciaConteoProducto[]
  disponibilidades          DisponibilidadProducto[]
  traspasos                 TraspasoSucursal[]
  contenidosCarta           ContenidoCartaProducto[]
  descuentosCarta           DescuentoProductoSucursal[]
  opcionesItemAgrupadoCarta OpcionItemAgrupadoCarta[]
  cuentaItems               CuentaItem[]
  consumosQueLoSustituyen   MovimientoStock[]           @relation("MovimientoSustituyeA")
  renglonesDeFactura        FacturaProveedorRenglon[]
  gruposAdmitidos           ProductoAdmiteGrupo[]
  opcionesAdmitidas         ProductoAdmiteOpcion[]
  /// GO-1: la opción de venta que este producto respalda como ANCLA de un ADICIONAL (1 a 1 por el único `(empresaId, productoId)`).
  opcionQueRespalda         OpcionDeGrupo?
  preciosLocalesDeOpcion    PrecioLocalDeOpcion[]
  consumosDeOpcionComoInsumo ConsumoDeOpcion[] @relation("ConsumoDeOpcionInsumo")
  consumosDeOpcionQueLoReemplazan ConsumoDeOpcion[] @relation("ConsumoDeOpcionReemplazo")
  /// GO-3: las entradas de cupos de combos (LISTA) y los platos del día (DEL_DIA) en que figura este producto.
  entradasDeCupo            EntradaDeCupo[]
  entradasDelDia            EntradaDelDiaDeCupo[]
  /// GO-3: las combinaciones de sus ejes y las recetas de combinación que lo usan como insumo.
  combinaciones             CombinacionDeProducto[]
  insumoEnRecetasDeCombinacion RecetaDeCombinacionIngrediente[] @relation("RecetaDeCombinacionInsumo")

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@index([insumoId])
  @@index([categoriaId])
}

/// Disponibilidad de un producto del Catálogo Central EN UNA SUCURSAL
/// (decisión del dueño 2026-09-23): reemplaza el booleano GLOBAL
/// `Producto.activo`, que sacaba un producto de TODO el negocio de una
/// vez. El producto en sí (nombre, código, unidad, receta, precio de
/// lista) sigue siendo central y compartido: lo único que se vuelve
/// local es "¿se usa acá?".
///
/// FILA AUSENTE = NO DISPONIBLE. Es lo contrario al criterio de
/// PrecioLocalProducto/StockMinimoProducto/FrecuenciaConteoProducto
/// (donde "no hay fila" = valor por defecto benigno) y es a propósito:
/// la decisión 2 dice que un producto dado de alta SIN el tilde "Activo
/// en todas las sucursales" no tiene que aparecer en las demás "hasta
/// que un admin de ESA sucursal lo active ahí a mano" — eso solo se
/// cumple si la ausencia significa "no". Por eso el alta materializa
/// filas (todas las sucursales, o solo la del alta) y la migración
/// inicial hace backfill: sin backfill, todo el catálogo existente
/// desaparecería de todas las pantallas al aplicar la migración.
///
/// `disponible = false` y "sin fila" significan lo mismo para el
/// sistema (los colapsa `resolverDisponibilidad`, src/core/catalogo/
/// disponibilidad-producto.ts — un solo criterio, no dos). Se conserva
/// la fila en false en vez de borrarla, igual que el resto del catálogo
/// (activo/habilitado, nunca DELETE): la diferencia solo se usa para el
/// rastro de auditoría ("nunca se configuró acá" vs. "se apagó acá").
///
/// Sin precedente directo en ERPNext ni Dolibarr: los dos tienen la
/// tabla producto × depósito (Item Reorder / llx_product_warehouse_
/// properties) y ninguno le puso un booleano de disponibilidad; lo más
/// cercano es Item.restrict_to_companies + Company Restriction de
/// ERPNext, un nivel más arriba (Company ≙ Sucursal acá). Ver
/// docs/grounding-disponibilidad-por-sucursal-2026-09-23.md.
model DisponibilidadProducto {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  disponible Boolean

  @@unique([sucursalId, productoId])
  @@unique([empresaId, id])
}

/// Nombre interno histórico "Familia" (Catalogo.js:180-197) — de cara al
/// usuario ya es "Insumo" desde v2.3.0; se adopta el nombre nuevo también
/// acá para no arrastrar la confusión al código nuevo.
model Insumo {
  id        String  @id @default(cuid())
  empresaId String  @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean @default(true)

  /// Relación PLANA 1:1 (hoy "Grupos de Familia", una fila por Insumo) — no
  /// forma parte del árbol en sí, solo cuelga de un nodo de Grupo.
  grupoId String?
  grupo   Grupo?  @relation(fields: [empresaId, grupoId], references: [empresaId, id])

  productos   Producto[]
  sustitutoEn SustitutoRecetaIngrediente[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
  @@index([grupoId])
}

/// Árbol de Grupos sin límite de niveles (self-referencing), inspirado en
/// ERPNext Item Group (Catalogo.js:2410-2429). La prevención de ciclos
/// (creariaCicloGrupo_, Catalogo.js:2483-2489) NO es representable como
/// constraint de Postgres — se porta como función de aplicación (ver
/// src/core/catalogo/grupo.ts).
model Grupo {
  id           String  @id @default(cuid())
  empresaId    String  @default(dbgenerated("app_empresa_actual()"))
  empresa      Empresa @relation(fields: [empresaId], references: [id])
  nombre       String
  activo       Boolean @default(true)
  grupoPadreId String?
  grupoPadre   Grupo?  @relation("GrupoArbol", fields: [empresaId, grupoPadreId], references: [empresaId, id])
  hijos        Grupo[] @relation("GrupoArbol")

  insumos Insumo[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
  @@index([grupoPadreId])
}

/// Rubro comercial (Catalogo.js:2969-2989) — catálogo cerrado simple,
/// aplica a CUALQUIER producto (MP o PV). Sin jerarquía, sin relación con
/// el árbol de Grupo (ese agrupa Insumos, no productos de venta).
model CategoriaProducto {
  id        String     @id @default(cuid())
  empresaId String     @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean    @default(true)
  productos Producto[]

  margenesObjetivo MargenObjetivo[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
}

/// Food cost objetivo (2026-10-01, decisión del dueño): el tope de la porción del precio de carta, con IVA incluido igual que `Producto.precioVenta`, que puede irse en comida y
/// bebida. `categoriaId` NULL = el de TODA la empresa; con categoría, el de esa categoría (gana sobre el de la empresa). Sin ninguna
/// fila rige la constante `FOOD_COST_OBJETIVO_PCT`. Lo edita SOLO administración (`margen_objetivo_editar`). La migración agrega a mano
/// (Prisma no los declara): un índice único parcial para permitir UNA sola fila de empresa (`categoriaId IS NULL`) y un CHECK que fuerza
/// 0 < foodCostObjetivoPct < 100.
model MargenObjetivo {
  id                  String             @id @default(cuid())
  empresaId           String             @default(dbgenerated("app_empresa_actual()"))
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  categoriaId         String?
  categoria           CategoriaProducto? @relation(fields: [empresaId, categoriaId], references: [empresaId, id])
  foodCostObjetivoPct Decimal            @db.Decimal(5, 2)

  @@unique([empresaId, categoriaId])
  @@unique([empresaId, id])
}

/// Catálogo cerrado (Catalogo.js:2634-2810). `magnitud` es solo
/// organizativo/default de decimales — NO valida conversión real entre
/// unidades (esa validación fuerte real es validarUnidadInsumo_: todos los
/// productos de un mismo Insumo deben compartir exactamente unidadStock).
model Unidad {
  id        String         @id @default(cuid())
  empresaId String         @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa        @relation(fields: [empresaId], references: [id])
  nombre    String
  magnitud  MagnitudUnidad
  activa    Boolean        @default(true)
  /// 0-6, validado en la capa de aplicación (Catalogo.js:2777).
  decimales Int            @default(2)

  productosPorUnidadCompra      Producto[]             @relation("ProductoUnidadCompra")
  productosPorUnidadStock       Producto[]             @relation("ProductoUnidadStock")
  presentaciones                Presentacion[]
  proveedorPorProducto          ProveedorPorProducto[]
  recetaIngredientes            RecetaIngrediente[]
  recetaVersionesPorRendimiento RecetaVersion[]        @relation("RecetaVersionRendimientoUnidad")
  recetaVersionesPorRacion      RecetaVersion[]        @relation("RecetaVersionRacionUnidad")
  consumosDeOpcion              ConsumoDeOpcion[]
  ingredientesDeRecetaDeCombinacion RecetaDeCombinacionIngrediente[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
}

/// Presentaciones de compra ALTERNATIVAS a la default de Producto
/// (unidadCompra/factorConversion propios) — Catalogo.js:3322-3472.
model Presentacion {
  id               String   @id @default(cuid())
  empresaId        String   @default(dbgenerated("app_empresa_actual()"))
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  productoId       String
  producto         Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  unidadCompraId   String
  unidadCompra     Unidad   @relation(fields: [empresaId, unidadCompraId], references: [empresaId, id])
  factorConversion Decimal  @db.Decimal(14, 4)
  activa           Boolean  @default(true)

  @@unique([productoId, unidadCompraId])
  @@unique([empresaId, id])
}

/// Maestro de Proveedores (Catalogo.js:3677-3775).
model Proveedor {
  id              String  @id @default(cuid())
  empresaId       String  @default(dbgenerated("app_empresa_actual()"))
  empresa         Empresa @relation(fields: [empresaId], references: [id])
  /// `PRV_<uuid6>` (Catalogo.js:3737) — mismo patrón de generación/colisión
  /// que Producto.codigo.
  codigo          String
  nombre          String
  contacto        String?
  telefono        String?
  email           String?
  cuit            String?
  condicionesPago String?
  notas           String?
  activo          Boolean @default(true)
  /// Clasificación del proveedor (M1, C20): qué le compramos. Tres estados válidos: productos, servicios o ambos; «ninguno» lo impide el CHECK
  /// `Proveedor_ofrece_productos_o_servicios_chk` ("ofreceProductos" OR "ofreceServicios"), que Prisma no modela (misma convención que los CHECK de la Tanda 6).
  /// Los proveedores existentes nacen «productos» (decisión del dueño, 2026-10-06). Migración 20261015110000_proveedor_ofrece_productos_y_servicios.
  ofreceProductos Boolean @default(true)
  ofreceServicios Boolean @default(false)
  /// M3e (C36): la condición del proveedor frente al IVA (`CONDICIONES_IVA` de src/core/fiscal/iva.ts, la misma lista que `Empresa.condicionIva`; CHECK "Proveedor_condicionIva_check"). NULL = «no declarada»: quien la lea falla cerrado.
  condicionIva    String?

  productosConsignados Producto[]             @relation("ProveedorConsignacionDe")
  proveedorPorProducto ProveedorPorProducto[]
  operaciones          Operacion[]
  pagosConsignante     PagoConsignante[]
  facturasProveedor    FacturaProveedor[]
  notasDeCredito       NotaCreditoProveedor[]
  puntosDeVenta        PuntoDeVentaDeProveedor[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, nombre])
  @@unique([empresaId, cuit])
  @@unique([empresaId, id])
}

/// Pago registrado a un proveedor de consignación, para saldar (parcial o
/// totalmente) el "Debido por consignante" de reportes/consignacion.ts.
/// Append-only, igual que el resto del Kardex: nunca se editan/borran las
/// líneas LIQUIDACION_CONSIGNACION para "saldarlas" — esto es un registro
/// aparte, y el reporte resta SUM(pagos) de SUM(liquidaciones) por
/// proveedor para llegar al saldo debido real.
model PagoConsignante {
  id          String    @id @default(cuid())
  empresaId   String    @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  sucursalId  String
  sucursal    Sucursal  @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  proveedorId String
  proveedor   Proveedor @relation(fields: [empresaId, proveedorId], references: [empresaId, id])
  importe     Decimal   @db.Decimal(14, 4)
  fecha       DateTime
  notas       String?
  usuarioId   String
  usuario     User      @relation(fields: [usuarioId], references: [id])
  creadoEn    DateTime  @default(now())

  /// I3 — idempotencia (Task #41, M14, mismo mecanismo que `Operacion`, ver esas columnas más abajo en este archivo): UUID generado
  /// por el cliente al abrir el modal de pago, reenviado tal cual en reintentos del mismo intento de envío. Nullable durante el
  /// rollout gradual (mismo criterio que `Operacion.claveIdempotencia`) — un pago sin clave simplemente no participa del mecanismo de
  /// deduplicación. Único GLOBAL. Validada en la capa de aplicación como UUID antes de llegar acá.
  claveIdempotencia String? @unique

  /// I3 — hash SHA-256 del payload validado que efectivamente se procesó (incluye sucursalId), para distinguir "mismo intento
  /// reenviado" de "clave reutilizada con datos distintos" sin comparar objetos JSON campo por campo.
  payloadHash String?

  /// I3 — Opción B: mensaje de éxito ya formateado, persistido en el MISMO `create` (a diferencia de `Operacion`, acá el mensaje se
  /// conoce ANTES del insert — proveedor e importe ya están resueltos — así que no hace falta un segundo `update` posterior).
  resultadoMensaje String?

  @@unique([empresaId, id])
  @@index([sucursalId, proveedorId])
}

/// Relación proveedor↔producto con precio normalizado a "precio por unidad
/// de stock" (Catalogo.js:3210-3320). Clave real: (producto, proveedor,
/// unidad de compra).
///
/// El UNIQUE de abajo + un upsert atómico (INSERT ... ON CONFLICT DO
/// UPDATE, ver src/server/actions/proveedor-por-producto.ts) hacen
/// ESTRUCTURALMENTE IMPOSIBLE la carrera cross-hostería documentada en el
/// propio código de Apps Script (Catalogo.js:3278-3294: dos sucursales
/// comprando el mismo insumo casi simultáneo duplicaban esta fila, hoy
/// mitigado DESPUÉS de escribir por fusionarDuplicadosProveedorPorProducto_,
/// Catalogo.js:3303-3320) — acá no hay nada que detectar ni fusionar.
model ProveedorPorProducto {
  id                   String    @id @default(cuid())
  empresaId            String    @default(dbgenerated("app_empresa_actual()"))
  empresa              Empresa   @relation(fields: [empresaId], references: [id])
  productoId           String
  producto             Producto  @relation(fields: [empresaId, productoId], references: [empresaId, id])
  proveedorId          String
  proveedor            Proveedor @relation(fields: [empresaId, proveedorId], references: [empresaId, id])
  unidadCompraId       String
  unidadCompra         Unidad    @relation(fields: [empresaId, unidadCompraId], references: [empresaId, id])
  /// Precio "crudo" tal como lo cobra el proveedor en esa unidad de compra.
  precioUnitario       Decimal   @default(0) @db.Decimal(14, 4)
  /// Normalizado a precio por unidad de stock del producto — permite
  /// comparar presentaciones distintas del mismo Insumo.
  precioPorUnidadStock Decimal   @default(0) @db.Decimal(14, 4)
  ultimaCompra         DateTime  @default(now())
  /// Cómo llama ESTE proveedor a este producto (su propio código o
  /// nombre de catálogo) — nunca existió ni en la planilla vieja, que
  /// solo guardaba nuestro propio código. Puramente informativo, para
  /// reconocerlo más fácil al recargar una compra futura.
  referenciaProveedor  String?

  @@unique([productoId, proveedorId, unidadCompraId])
  @@unique([empresaId, id])
}

/// Cliente con % de descuento fijo (Task #14, docs/plan-clientes-descuento-2026-09-26.md): catálogo CENTRAL, sin `sucursalId` —
/// mismo criterio que `Proveedor` (una hostería con varias sucursales suele compartir sus clientes frecuentes). D1: un único
/// `descuentoPorcentaje` por cliente, no varía por categoría de producto. Nunca se borra (`activo`, igual que `Proveedor.activo`):
/// una `Cuenta` ya cerrada referencia su cliente para siempre (FK RESTRICT en `Cuenta.clienteId`/`Operacion.clienteId`).
///
/// El % que efectivamente se cobró queda CONGELADO en `Cuenta.descuentoPorcentaje` al asignar el cliente a la cuenta (D7) — cambiar
/// `descuentoPorcentaje` acá nunca reescribe una cuenta ya abierta ni una ya cerrada.
model Cliente {
  id                  String   @id @default(cuid())
  empresaId           String   @default(dbgenerated("app_empresa_actual()"))
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  nombre              String
  /// 0 ≤ % < 100 (D4, validarPorcentajeDescuento) — Decimal(5,2): hasta 999,99, sobra para un porcentaje.
  descuentoPorcentaje Decimal  @db.Decimal(5, 2)
  activo              Boolean  @default(true)
  creadoEn            DateTime @default(now())

  cuentas     Cuenta[]
  operaciones Operacion[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
}

/// Versionado append-only real (Catalogo.js:1690-1779): NUNCA se pisa ni
/// borra una versión — una venta pasada referencia esa versión para
/// costeo/auditoría (Catalogo.js:1696-1706). `version` es un entero simple;
/// la vigente es SIEMPRE MAX(version) para ese producto, derivado, nunca
/// un flag a mantener transaccionalmente.
model RecetaVersion {
  id                String    @id @default(cuid())
  empresaId         String    @default(dbgenerated("app_empresa_actual()"))
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  /// El plato (PV) o la MP con seProduce=true.
  productoId        String
  producto          Producto  @relation("RecetaVersionProducto", fields: [empresaId, productoId], references: [empresaId, id])
  version           Int
  creadoEn          DateTime  @default(now())
  /// NULL = la receta CENTRAL del producto (la de toda la empresa). Con valor = una versión de la receta PROPIA de esa sucursal
  /// (ADR-009, familia override): la numeración de `version` es independiente por (producto, sucursal) y la unicidad la dan dos
  /// índices únicos parciales hechos a mano en la migración (Prisma no los declara).
  sucursalId        String?
  sucursal          Sucursal? @relation("RecetaVersionSucursal", fields: [empresaId, sucursalId], references: [empresaId, id])
  /// Solo en versiones propias: la versión CENTRAL vigente en la que se basó (o que había cuando se creó). Sirve para avisar «la central
  /// cambió» cuando hay una central más nueva; nunca se aplica nada solo. Dato derivado, sin FK: la versión central es append-only.
  basadaEnVersionId String?

  ingredientes RecetaIngrediente[]
  pasos        RecetaPaso[]

  /// Cabecera informativa — grounded contra Fudo (POS de gastronomía real,
  /// docs/grounding-ficha-tecnica-tandoor.md §6). Todo opcional: no rompe
  /// ninguna receta ya cargada, y no bloquea el guardado si se deja vacío.
  /// Viaja en la MISMA versión que ingredientes/pasos a propósito — es
  /// parte de la misma "foto" de qué receta exacta se usó (ver
  /// razonamiento completo en el documento, sección "Interacción con el
  /// versionado append-only").
  rendimientoCantidad      Decimal? @db.Decimal(14, 4)
  rendimientoUnidadId      String?
  rendimientoUnidad        Unidad?  @relation("RecetaVersionRendimientoUnidad", fields: [empresaId, rendimientoUnidadId], references: [empresaId, id])
  racionesCantidad         Int?
  /// Tamaño de CADA ración — distinto de rendimientoCantidad (lo que
  /// produce la receta ENTERA). Ej.: rendimiento "1 unidad" (la pizza
  /// entera), racionesCantidad 8, racionTamano 150 (gramos cada porción).
  racionTamano             Decimal? @db.Decimal(14, 4)
  racionUnidadId           String?
  racionUnidad             Unidad?  @relation("RecetaVersionRacionUnidad", fields: [empresaId, racionUnidadId], references: [empresaId, id])
  tiempoPreparacionMinutos Int?
  tiempoCoccionMinutos     Int?
  comentarios              String?
  /// Cómo se sirve el plato — distinto de los pasos de cocción (Fudo
  /// separa "Pasos del procedimiento" de "Presentación o emplatado").
  presentacionEmplatado    String?
  notasAdicionales         String?
  /// Texto libre, un renglón = un ítem (ej. "Horno pizzero") — no amerita
  /// un catálogo de equipos propio, ver §6 del documento de grounding.
  equipamientoNecesario    String?

  // La unicidad de (productoId, sucursalId, version) son DOS índices únicos parciales (migración receta_propia_por_sucursal): uno con
  // sucursalId NULL (la central) y otro con sucursalId NOT NULL. Postgres trata NULL como distinto de NULL en un UNIQUE común.
  @@unique([empresaId, id])
  @@index([productoId, sucursalId])
}

/// Receta propia de una sucursal para un producto (ADR-009, familia override). Una fila por (sucursal, producto) cuando la sucursal la
/// creó alguna vez; `habilitada` dice si rige (la receta vigente de ESA sucursal pasa a ser la propia) o si la sucursal volvió a la central
/// (las versiones propias quedan como historial, no se borran). SIN fila = rige la central (más las calibraciones por sucursal).
model RecetaSucursal {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  habilitada Boolean  @default(true)

  @@unique([sucursalId, productoId])
  @@unique([empresaId, id])
}

model RecetaIngrediente {
  id               String        @id @default(cuid())
  empresaId        String        @default(dbgenerated("app_empresa_actual()"))
  empresa          Empresa       @relation(fields: [empresaId], references: [id])
  recetaVersionId  String
  recetaVersion    RecetaVersion @relation(fields: [empresaId, recetaVersionId], references: [empresaId, id], onDelete: Cascade)
  /// La MP consumida — FK real a Producto. Reemplaza el "renombrar por
  /// nombre en Recetas" de renombrarProductoEnHistorial_ (Catalogo.js:
  /// 1270-1314): renombrar un producto ahora es un UPDATE de una fila.
  insumoProductoId String
  insumoProducto   Producto      @relation("RecetaIngredienteInsumo", fields: [empresaId, insumoProductoId], references: [empresaId, id])
  cantidad         Decimal       @db.Decimal(14, 4)
  unidadId         String
  unidad           Unidad        @relation(fields: [empresaId, unidadId], references: [empresaId, id])
  mermaPorcentaje  Decimal       @default(0) @db.Decimal(6, 2)
  observaciones    String?

  enPasos             RecetaPasoIngrediente[]
  sustitutos          SustitutoRecetaIngrediente[]
  rendimientosLocales RendimientoLocalIngrediente[]

  @@unique([empresaId, id])
  @@index([insumoProductoId])
}

/// Insumos que pueden reemplazar a la MP de UNA línea de receta cuando ella y sus hermanos se agotan en la venta
/// (docs/plan-sustitucion-insumos-receta-2026-09-26.md). Por línea, no por Insumo global. Viaja con la versión de la
/// receta (append-only).
model SustitutoRecetaIngrediente {
  id                  String            @id @default(cuid())
  empresaId           String            @default(dbgenerated("app_empresa_actual()"))
  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  recetaIngredienteId String
  recetaIngrediente   RecetaIngrediente @relation(fields: [empresaId, recetaIngredienteId], references: [empresaId, id], onDelete: Cascade)
  insumoSustitutoId   String
  insumoSustituto     Insumo            @relation(fields: [empresaId, insumoSustitutoId], references: [empresaId, id])
  orden               Int

  @@unique([recetaIngredienteId, insumoSustitutoId], map: "SustitutoRecetaIngrediente_ingrediente_insumo_key")
  @@unique([recetaIngredienteId, orden])
  @@unique([empresaId, id])
  @@index([insumoSustitutoId])
}

/// Paso de preparación — grounded contra Tandoor Recipes (`Step`) y Fudo
/// (docs/grounding-ficha-tecnica-tandoor.md). La mayoría de los pasos van
/// a ser instrucciones de texto simple sin ingredientes propios (Fudo ni
/// lo ofrece) — `ingredientes` (la sub-lista vía RecetaPasoIngrediente) es
/// la excepción puntual ("marinar con esto, salsa aparte"), no la norma.
model RecetaPaso {
  id              String        @id @default(cuid())
  empresaId       String        @default(dbgenerated("app_empresa_actual()"))
  empresa         Empresa       @relation(fields: [empresaId], references: [id])
  recetaVersionId String
  recetaVersion   RecetaVersion @relation(fields: [empresaId, recetaVersionId], references: [empresaId, id], onDelete: Cascade)
  orden           Int
  nombre          String?
  instruccion     String
  minutos         Int?

  ingredientes RecetaPasoIngrediente[]

  @@unique([empresaId, id])
  @@index([recetaVersionId])
}

/// Tabla puente, no un FK simple en RecetaIngrediente — un mismo
/// ingrediente puede participar de más de un paso (ej. "sal" en dos
/// preparaciones distintas de la misma receta), mismo criterio que el M2M
/// real de Tandoor (`Step.ingredients`). No repite cantidad/unidad/merma —
/// eso sigue viviendo solo en RecetaIngrediente, el paso solo referencia.
model RecetaPasoIngrediente {
  id                  String            @id @default(cuid())
  empresaId           String            @default(dbgenerated("app_empresa_actual()"))
  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  recetaPasoId        String
  recetaPaso          RecetaPaso        @relation(fields: [empresaId, recetaPasoId], references: [empresaId, id], onDelete: Cascade)
  recetaIngredienteId String
  recetaIngrediente   RecetaIngrediente @relation(fields: [empresaId, recetaIngredienteId], references: [empresaId, id], onDelete: Cascade)

  @@unique([recetaPasoId, recetaIngredienteId])
  @@unique([empresaId, id])
}

// ===================================================================
// MOVIMIENTOS: Kardex (libro mayor de stock), operaciones, secciones,
// conteo físico y precio local por sucursal.
//
// A diferencia de Core/Catálogo (Catálogo Central, SIN sucursalId),
// TODO acá vive scopeado por sucursal — reemplaza el modelo viejo de
// "1 container de Apps Script = 1 sucursal, 1 Kardex propio" por
// sucursalId como columna real en una sola base compartida.
//
// Diseño en dos niveles, análogo a ERPNext (Stock Entry → Stock Ledger
// Entry), pero sin una tabla de "detalle" redundante: Operacion es el
// encabezado (lo que el usuario INICIÓ — gatea el permiso de Movimientos.js
// ACCION_POR_PROCESO_), MovimientoStock es cada línea del libro mayor (el
// EFECTO real sobre el stock: 1 fila = 1 movimiento con signo).
//
// Ver docs/plan-migracion.md, sección "Plan de la porción Movimientos",
// para la investigación completa (anclas archivo:línea) y las decisiones.
// ===================================================================

/// Los procesos gateables de ACCION_POR_PROCESO_ (Movimientos.js:510-525),
/// más LIQUIDACION_CONSIGNACION (Movimientos.js:250-258: generada SOLA por
/// confirmarRegistrarVenta_ConLock_/confirmarRegistrarMovimientos al
/// producir, nunca un proceso que un usuario elija — por eso no tiene
/// Accion propia en src/core/permisos/acciones.ts) y RECLASIFICACION
/// (Stock.js:1899-1991 — agregada en la porción Stock; NUNCA pasa por
/// TRANSICIONES en Apps Script porque no es una "acción de Permisos" con
/// su propio filtroTipo/exigeSeccion/etc., sino la primitiva de split
/// genérico del Conteo Físico — se gatea con 'proceso_control', mismo
/// permiso que Conteo Físico, no con una Accion propia).
///
/// TRANSFERENCIA_SALIDA_SUCURSAL/TRANSFERENCIA_ENTRADA_SUCURSAL/
/// REINGRESO_TRANSFERENCIA_SUCURSAL (Sucursales.js, porción Traspasos
/// entre sucursales) agregados acá — igual que RECLASIFICACION
/// (porción Stock), ninguno pasa por el motor genérico
/// (`registrarMovimiento`)/`TRANSICIONES`-como-entrada-de-ACCION_POR_PROCESO:
/// tienen su propio server action (`src/server/actions/traspasos.ts`),
/// gateado directo con `proceso_transferencia_sucursal` — la entrada en
/// `TRANSICIONES` (transiciones.ts) existe solo para que
/// `esSignoFijo`/`tieneStockReal` puedan resolverlas igual que cualquier
/// otro proceso al construir `MovimientoStock.cantidad` firmado.
enum Proceso {
  COMPRA
  PRODUCCION
  CONSUMO
  AJUSTE
  CONTROL
  TRANSFERENCIA
  MERMA
  VENTA
  DEVOLUCION_CONSIGNACION
  LIQUIDACION_CONSIGNACION
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  RECLASIFICACION
  TRANSFERENCIA_SALIDA_SUCURSAL
  TRANSFERENCIA_ENTRADA_SUCURSAL
  REINGRESO_TRANSFERENCIA_SUCURSAL
}

/// Catálogo administrable de motivos de Merma (plan "motivos de Consumo/Merma como catálogo administrable",
/// 2026-09-23) — reemplazó al enum fijo `MotivoMerma` de antes (renombrado `MotivoMermaLegacy` en la migración expand
/// P3, borrado en la migración contract P8): antes, agregar un motivo nuevo pedía código + migración; ahora es un
/// alta más, con el permiso `motivos_movimiento`. Mismo patrón que `CategoriaProducto`/`Insumo`/`Grupo`: nunca
/// DELETE — desactivar lo saca del selector de Merma, pero un movimiento histórico sigue mostrando su motivo.
model MotivoMerma {
  id          String      @id @default(cuid())
  empresaId   String      @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  nombre      String
  descripcion String?
  activo      Boolean     @default(true)
  operaciones Operacion[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
}

/// Catálogo administrable de destinos de Consumo — ver el docstring de `MotivoMerma`, mismo patrón.
model DestinoConsumo {
  id          String      @id @default(cuid())
  empresaId   String      @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  nombre      String
  descripcion String?
  activo      Boolean     @default(true)
  operaciones Operacion[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
}

/// ACCIONES_CONTEO_FISICO (Stock.js:1066-1088).
enum AccionConteo {
  AJUSTAR
  FALTA_MOVIMIENTO
  DESCARTAR
}

/// Estados de ConteoFisico.estado (Stock.js: 'Resuelto'/'Pendiente'/
/// 'Descartado'/'Cancelado' — este último de cancelarConteoFisico,
/// Stock.js:2097-2141).
enum EstadoConteo {
  RESUELTO
  PENDIENTE
  DESCARTADO
  CANCELADO
}

/// Reemplaza HOJA_SECCIONES (Stock.js:1316-1415) — antes una hoja POR
/// CONTENEDOR (cada sucursal ya tenía sus propias Secciones porque cada
/// una era un spreadsheet separado); acá sucursalId es una columna real
/// porque ya no hay un contenedor propio que la implique.
model Seccion {
  id                      String   @id @default(cuid())
  empresaId               String   @default(dbgenerated("app_empresa_actual()"))
  empresa                 Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId              String
  sucursal                Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  nombre                  String
  activa                  Boolean  @default(true)
  /// ¿El cierre de cuenta del POS puede descontar de acá AUTOMÁTICAMENTE cuando la sección habitual de un producto no alcanza
  /// (o el producto no tiene habitual)? Default true: todas sirven de respaldo sin configurar nada (decisión del dueño 2026-09-25:
  /// hoy no se excluye ninguna, pero queda la herramienta). No afecta a la sección HABITUAL de un producto (la preferencia
  /// explícita manda) ni a la venta de mostrador (ahí la sección la elige una persona). Ver docs/plan-seccion-habitual-stock-2026-09-25.md.
  sirveDeRespaldoEnVentas Boolean  @default(true)

  operacionesTransferenciaDestino Operacion[]               @relation("OperacionSeccionDestino")
  movimientos                     MovimientoStock[]
  conteosFisicos                  ConteoFisico[]
  stockMinimos                    StockMinimoProducto[]
  seccionesHabituales             SeccionHabitualProducto[]
  traspasosComoSeccionOrigen      TraspasoSucursal[]        @relation("TraspasoSeccionOrigen")
  traspasosComoSeccionDestino     TraspasoSucursal[]        @relation("TraspasoSeccionDestino")

  /// Único índice funcional case/espacio-insensible por sucursal (mismo
  /// criterio que Producto/Proveedor/Insumo/... en la porción Catálogo) —
  /// agregar a mano en la migración generada, ver README.
  @@unique([sucursalId, nombre])
  @@unique([empresaId, id])
}

/// Encabezado de una confirmación de movimiento — agrupa 1+ líneas de
/// MovimientoStock que se escribieron JUNTAS en un solo confirm() (mismo
/// alcance que "ID Operación" en Kardex, Movimientos.js:963-974, pero como
/// FK real en vez de un UUID de texto compartido a ciegas entre filas).
///
/// GRANULARIDAD (importante, difiere por proceso — ver el comentario de
/// confirmarRegistrarMovimientos vs. confirmarRegistrarVenta_ConLock_ en
/// Movimientos.js): Compra/Ajuste/Consumo/Producción/Merma/Transferencia/
/// Devolución×2/Control → UNA Operacion cubre TODO el lote confirmado en
/// una sola llamada (varios productos). Venta → una Operacion POR CADA
/// venta individual del lote (cada línea vendida es su propio evento
/// económico, con su propia Liquidación de consignación si aplica) — un
/// solo confirmarRegistrarVenta con 3 ítems crea 3 filas Operacion, no 1.
///
/// `proceso` acá es el INICIADO por el usuario (lo que gatea el permiso,
/// ACCION_POR_PROCESO_) — NO necesariamente el de cada línea: una
/// Operacion de PRODUCCION o VENTA genera líneas hijas con OTRO proceso en
/// MovimientoStock.proceso (CONSUMO por cada MP de receta, y
/// LIQUIDACION_CONSIGNACION si esa MP es consignación) — ver el docstring
/// de MovimientoStock.proceso.
model Operacion {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  proceso    Proceso
  fecha      DateTime

  /// Compra/DevolucionProveedor (a quién se compra/devuelve) o Venta ("a
  /// quién se vende" — Movimientos.js:1769 usa 'Mostrador' como texto
  /// libre por defecto cuando no hay proveedor real; se modela como
  /// nullable en vez de forzar un Proveedor "Mostrador" ficticio).
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [empresaId, proveedorId], references: [empresaId, id])

  /// Cliente con descuento de una venta de mesa (Task #14, docs/plan-clientes-descuento-2026-09-26.md, punto 3/4): NO reusa
  /// `proveedorId` a propósito — ese campo ya documentado como "a quién se vende" nunca se usó, y mezclaría el catálogo de
  /// proveedores con el de clientes. FK RESTRICT: una Operacion vieja sigue apuntando a su Cliente aunque se lo desactive.
  /// SOLO mesas en v1 (D6): `registrarVenta`, la venta de mostrador, todavía no pasa `clienteId` — el campo ya existe para que
  /// esa extensión, cuando llegue, no pida otra migración.
  clienteId String?
  cliente   Cliente? @relation(fields: [empresaId, clienteId], references: [empresaId, id])

  /// La `PromoCuenta` de la que esta Operacion VENTA es un COMPONENTE (Task #16, docs/plan-promo-combo-2026-09-26.md, paso 7):
  /// hay UNA Operacion por componente neto, igual que hoy hay una por línea. `null` = una venta suelta de siempre (o
  /// cualquier proceso que no sea VENTA de mesa). FK RESTRICT: una Operacion vieja sigue apuntando a su promo aunque se
  /// anule (D4: `anularVenta` anula TODAS las Operaciones hermanas de la misma `PromoCuenta`, nunca las borra). SOLO mesas en
  /// v1 (D7, mismo criterio que `clienteId`): `registrarVenta` (mostrador) nunca lo pasa.
  promoCuentaId String?
  promoCuenta   PromoCuenta? @relation(fields: [empresaId, promoCuentaId], references: [empresaId, id])

  /// Índice único parcial "Operacion_factura_unica_vigente_key" (sucursalId, proveedorId, nroFactura) WHERE
  /// nroFactura IS NOT NULL AND proceso = 'COMPRA' AND anuladaEn IS NULL — definido FUERA de este schema (Prisma
  /// no declara índices parciales, ver prisma/migrations/20260921230000_factura_unica_vigente/ y el precedente
  /// 20260915034450_indices_manuales/). Arbitra la condición de carrera de factura de compra duplicada bajo
  /// concurrencia real — el chequeo de aplicación (registrarMovimiento) es solo el camino rápido para el caso
  /// secuencial. Solo cuentan las compras VIGENTES: una compra anulada deja libre su N.º de factura. NO cubre:
  /// compras sin proveedor, ni diferencias de formato/mayúsculas en el número.
  nroFactura String?

  /// Solo Transferencia (Movimientos.js:425-431, TRANSICIONES.TRANSFERENCIA
  /// no tiene exigeSeccion porque el origen YA es un campo obligatorio
  /// propio, distinto del "elegí sección" de los procesos que reparten
  /// stock existente). El origen de cada línea ya sale de
  /// MovimientoStock.seccionId — este campo es solo para no perder cuál
  /// era el destino elegido a nivel de la operación completa.
  seccionDestinoId String?
  seccionDestino   Seccion? @relation("OperacionSeccionDestino", fields: [empresaId, seccionDestinoId], references: [empresaId, id])

  /// Solo MERMA / CONSUMO respectivamente — null para cualquier otro
  /// proceso, validado en la capa de aplicación (mismo criterio
  /// no-bloqueante-por-constraint que el resto del proyecto usa para
  /// reglas condicionadas por otro campo, ej. Producto.insumoId). FK al
  /// catálogo administrable `MotivoMerma`/`DestinoConsumo` (plan "motivos
  /// de Consumo/Merma como catálogo administrable", 2026-09-23) — antes un
  /// enum fijo (`motivo`/`destino`, columnas que existieron entre P3 y P8,
  /// llamadas `motivoLegacy`/`destinoLegacy` en ese tramo transitorio;
  /// dropeadas en la migración contract P8 junto con los enums `*Legacy`).
  motivoId     String?
  motivo       MotivoMerma?    @relation(fields: [empresaId, motivoId], references: [empresaId, id])
  destinoId    String?
  destino      DestinoConsumo? @relation(fields: [empresaId, destinoId], references: [empresaId, id])
  /// Texto libre adicional (ctx.detalleLibre, Movimientos.js:767) — en
  /// Apps Script terminaba plegado dentro de "Movimiento detalle" de cada
  /// fila; acá queda en su propia columna, una vez por operación.
  detalleLibre String?

  /// NUEVO respecto a Apps Script: no existía ninguna columna "Usuario" en
  /// Kardex (Session.getActiveUser() del script deployado no se guardaba
  /// en ningún lado salvo en ConteosFisicos) — acá SÍ hay autenticación
  /// real por persona (Auth.js, porción Core), así que se agrega a
  /// propósito: saber quién registró cada operación es valioso y ahora es
  /// gratis, no es una expansión de alcance de esta porción.
  usuarioId String
  usuario   User   @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now())

  /// VENTA (anularVenta) y COMPRA (anularCompra) — cuándo (y quién) la anuló. null = vigente.
  /// Mismo criterio append-only que ConteoFisico/cancelarConteoFisico:
  /// nunca se edita/borra esta fila ni sus MovimientoStock originales, el
  /// stock se corrige con una Operacion AJUSTE nueva aparte — esto solo
  /// marca la venta como anulada, para no poder anularla dos veces y para
  /// que Trazabilidad no la muestre como vigente.
  anuladaEn    DateTime?
  anuladaPorId String?
  anuladaPor   User?     @relation("OperacionAnuladaPor", fields: [anuladaPorId], references: [id])

  /// I3 — idempotencia (docs/auditoria-motor2-plan-i3-idempotencia-2026-09-17.md
  /// §2, §8, §11): UUID generado por el cliente al abrir el formulario,
  /// reenviado tal cual en reintentos del mismo intento de envío.
  /// Nulleable durante el rollout gradual (§9.3) — una Operacion sin
  /// clave simplemente no participa del mecanismo de deduplicación.
  /// Validada en la capa de aplicación como UUID (§11.1) antes de llegar
  /// acá. Único GLOBAL (no compuesto con sucursalId/proceso — §2.2,
  /// corregido tras revisión: el compuesto dejaba reutilizar la misma
  /// clave entre procesos distintos sin ningún choque).
  claveIdempotencia String?

  /// I3 — hash SHA-256 del payload validado que efectivamente se
  /// procesó (incluye sucursalId y un identificador de proceso — §11.2),
  /// para distinguir "mismo intento reenviado" de "clave reutilizada con
  /// datos distintos" (§3) sin comparar objetos JSON campo por campo.
  payloadHash String?

  /// I3 — Opción B (§4.5): mensaje de éxito ya formateado, persistido
  /// tal cual se devolvió al cliente la primera vez. Se relee sin
  /// reprocesar nada ante un duplicado — evita reconstruir lógica
  /// condicional de negocio (avisoConversion, liquidación de
  /// consignación) en un segundo lugar del código.
  resultadoMensaje String?

  /// M2 (Paquete 2): en una AJUSTE que es la reversión por anulación de una venta o una compra, la `Operacion` que revierte. Reemplaza al reconocimiento POR TEXTO de la
  /// descripción (`PREFIJO_REVERSION_VENTA`/`_COMPRA`, src/core/movimientos/anulaciones.ts). `null` = no es una reversión (o es una anterior a M2: el relleno la enlaza aparte).
  /// ÚNICA por (empresa, operación): una operación se revierte UNA sola vez, y ese índice único es el árbitro de dos anulaciones a la vez. CHECK en la base: solo en AJUSTE y
  /// nunca a sí misma. Que sea de la misma sucursal que la revertida lo controla la aplicación. Nada de `src/` la escribe todavía (Etapa C).
  revierteAOperacionId String?
  revierteAOperacion   Operacion? @relation("OperacionRevierteA", fields: [empresaId, revierteAOperacionId], references: [empresaId, id], onDelete: Restrict)
  /// La reversión de ESTA operación (a lo sumo una; ver `revierteAOperacionId`).
  reversion            Operacion? @relation("OperacionRevierteA")

  /// M2: el motivo (texto libre, no vacío, hasta 200) con que se anuló esta operación. Solo si está anulada (`anuladaEn`). `null` = sin motivo registrado (anuladas antes de M2).
  motivoAnulacion String?

  /// M2: en una MERMA, la VENTA anulada cuyo género no se recuperó (la merma sale de esa anulación). Única: una venta anulada genera a lo sumo una merma. CHECK en la base: solo en MERMA y nunca a sí misma.
  mermaPorAnulacionDeId String?
  mermaPorAnulacionDe   Operacion? @relation("OperacionMermaPorAnulacion", fields: [empresaId, mermaPorAnulacionDeId], references: [empresaId, id], onDelete: Restrict)
  /// La merma que generó la anulación de ESTA venta (a lo sumo una).
  mermaPorAnulacion     Operacion? @relation("OperacionMermaPorAnulacion")

  /// M2: en una VENTA, la venta que reemplaza (anular y rehacer unidades). Única: una operación se reemplaza una sola vez.
  reemplazaAOperacionId String?
  reemplazaAOperacion   Operacion? @relation("OperacionReemplazaA", fields: [empresaId, reemplazaAOperacionId], references: [empresaId, id], onDelete: Restrict)
  /// La venta que reemplazó a ESTA (a lo sumo una).
  reemplazadaPor        Operacion? @relation("OperacionReemplazaA")

  /// M2: la cabecera `Venta` a la que pertenece esta línea de venta (una `Operacion` VENTA por línea; la cabecera las agrupa). `null` = anterior a M2 o aún sin cabecera. Solo en VENTA
  /// (CHECK en la base). FK RESTRICT: una cabecera con líneas no se borra (de hecho, `Venta` no se borra nunca). Que la sucursal de la línea y la de su cabecera coincidan NO lo
  /// controla la base (una clave foránea entre tablas de empresa lleva exactamente (empresaId, x)): lo controla la aplicación (Etapa C). Nada de `src/` la escribe todavía.
  ventaId String?
  venta   Venta?  @relation(fields: [empresaId, ventaId], references: [empresaId, id], onDelete: Restrict)

  /// GO-1: la operación de venta PADRE de la de un ADICIONAL (la del producto al que se agregó). NULL en toda operación de hoy. Solo una VENTA, que no es su propio padre ni lleva promo (CHECK `Operacion_padre_solo_venta_chk`); inmutable (disparador
  /// `Operacion_padre_inmutable_chk`). No es única (un padre puede tener varios adicionales). Que el padre sea de la misma sucursal y de la misma venta lo controla la aplicación (GO-2), igual que en `ventaId`.
  operacionPadreId String?
  operacionPadre   Operacion?  @relation("OperacionPadre", fields: [empresaId, operacionPadreId], references: [empresaId, id], onDelete: Restrict)
  operacionesHijas Operacion[] @relation("OperacionPadre")

  movimientos MovimientoStock[]

  /// Paquete 3 (M3b): la parte de factura de proveedor de la que salió esta compra (a lo sumo una; `FacturaProveedorSucursal.operacionId` es único). `null` = una compra anterior a las facturas repartidas.
  facturaProveedorParte FacturaProveedorSucursal?

  /// Paquete 4 (M6): la imputación de una nota de crédito de proveedor que acredita esta devolución (`DEVOLUCION_PROVEEDOR`); a lo sumo una (`NotaCreditoProveedorImputacion.operacionDevolucionId` es único con la empresa).
  notaCreditoImputacion NotaCreditoProveedorImputacion?

  /// POS: ítems de cuenta cuya venta es esta Operación (los enlaza `cerrarCuenta`, src/server/actions/pos/cuenta.ts).
  cuentaItems CuentaItem[]

  @@unique([claveIdempotencia])
  @@unique([empresaId, id])
  @@unique([empresaId, revierteAOperacionId])
  @@unique([empresaId, mermaPorAnulacionDeId])
  @@unique([empresaId, reemplazaAOperacionId])
  @@index([sucursalId, proceso, fecha])
  @@index([promoCuentaId])
  @@index([ventaId])
  @@index([operacionPadreId])
}

/// Reemplaza Kardex/"Hoja 7" (Core.js:601, CONFIG.SHEETS.HISTORIAL) — el
/// libro mayor real. 1 fila = 1 movimiento de stock, YA CON EL SIGNO
/// APLICADO en `cantidad`.
///
/// DECISIÓN CLAVE (fuente única del signo, de una vez): en Apps Script
/// `cantidad` se guardaba SIN signo para los procesos de signo fijo
/// (Compra/Consumo/Venta/Merma/...) y el signo se aplicaba recién AL LEER
/// (signoDeProceso_() en acumularMovimientoEnSaldoMap_, Stock.js:214-231)
/// — eso es EXACTAMENTE lo que causó el bug de MERMA en v2.1.0
/// (Movimientos.js:433-455: se agregó MERMA a TRANSICIONES con signoStock
/// -1, pero la lista de signos vivía duplicada aparte y nadie la
/// actualizó — una merma se registraba pero no descontaba nada). Acá NO
/// hay una segunda fuente que mantener sincronizada: `cantidad` se graba
/// YA multiplicada por el signo del proceso en el momento de escribir (ver
/// el `Proceso`/TRANSICIONES-equivalente en código, a implementar en
/// src/core/movimientos/), así que el saldo de cualquier producto/sección/
/// lote es SIEMPRE `SUM(cantidad)` — sin excepción por proceso, sin tabla
/// paralela, sin lookup al leer.
///
/// `proceso` es el efecto REAL de esta línea puntual — para la mayoría de
/// las Operacion es igual a Operacion.proceso, pero DIFIERE en las dos que
/// generan hijos (Movimientos.js: generaConsumoDeReceta): una Operacion
/// PRODUCCION escribe 1 línea proceso=PRODUCCION (+lo producido) y N
/// líneas proceso=CONSUMO (−cada MP de receta, con LIQUIDACION_CONSIGNACION
/// extra si esa MP es consignación); una Operacion VENTA escribe 1 línea
/// proceso=VENTA (el PV vendido) + N líneas proceso=CONSUMO + Liquidación
/// si aplica. Ver signoDeProceso_/esDeltaConSignoLibre_ (Movimientos.js:
/// 452-485) para qué procesos son signo fijo vs. delta con signo libre —
/// para AJUSTE/CONTROL/TRANSFERENCIA el valor YA viene con el signo que
/// cargó/calculó el usuario, ninguna multiplicación adicional al escribir.
///
/// Kardex es APPEND-ONLY, siempre — ni renombrar un producto (ver
/// Producto.codigo como FK real de abajo, ya no hace falta reescribir
/// filas viejas como renombrarProductoEnHistorial_) ni cancelar un conteo
/// (Stock.js:2077-2141) editan una fila existente: cancelar escribe una
/// fila de REVERSIÓN nueva con el mismo ConteoFisico enlazado.
model MovimientoStock {
  id          String    @id @default(cuid())
  empresaId   String    @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  operacionId String
  operacion   Operacion @relation(fields: [empresaId, operacionId], references: [empresaId, id])

  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  seccionId  String
  seccion    Seccion  @relation(fields: [empresaId, seccionId], references: [empresaId, id])
  proceso    Proceso

  /// Ya con signo — ver el docstring del modelo. + entra, − sale.
  cantidad        Decimal   @db.Decimal(14, 4)
  /// FEFO simplificado (Stock.js:403-425, IDEA-conteo-fisico-por-lote.md):
  /// a propósito NO hay una entidad "Lote" separada ni tracking FIFO real
  /// — es la misma simplificación deliberada de Apps Script, portada tal
  /// cual (una salida sin lote elegido asume el que vence antes; si eso
  /// queda mal, se corrige con Conteo Físico/Reclasificación).
  loteVencimiento DateTime? @db.Date

  /// Texto calculado por línea (conversión de unidad, peso real, etc. —
  /// Movimientos.js:766-812) — el CÓMO, no el POR QUÉ (eso es
  /// Operacion.motivo/destino/detalleLibre).
  detalle String

  /// Precio Total = importe real de ESTA línea (Compra: lo pagado por esa
  /// línea, CON IVA incluido (D-IVA; el desglose llega con la factura de
  /// proveedor, M3); Venta: cantidadVendida × precioVenta vigente
  /// al momento — Movimientos.js:1287). 0 para líneas que no representan
  /// un hecho financiero propio (Consumo, Transferencia, Ajuste/Control).
  precioTotal          Decimal @default(0) @db.Decimal(14, 2)
  /// Precio por unidad de STOCK — permite comparar compras en
  /// presentaciones distintas del mismo producto (mismo criterio que
  /// ProveedorPorProducto.precioPorUnidadStock, porción Catálogo).
  precioPorUnidadStock Decimal @default(0) @db.Decimal(14, 4)

  /// Solo proceso VENTA, desde 2026-09-17: costo de la receta del PV
  /// (calcularCostosYMargenes, BOM recursivo) resuelto EN EL MOMENTO de
  /// vender — no se recalcula después. Existe para que Reportes → Período
  /// pueda comparar cada venta contra el costo que regía ESE día, en vez de
  /// contra el costo de reposición de HOY (ver docs/comparativa-ux-erpnext-
  /// dolibarr.md §7.3/§9, "margen nominal" vs "margen real"). `null` en dos
  /// casos: ventas cargadas sin este dato (anteriores al campo, o cargadas por fuera de la aplicación), o el costeo estaba
  /// incompleto en el momento de vender (mismo criterio que costoIncompleto
  /// en costos.ts — no se inventa un número parcial). La COLUMNA se queda en null: el reporte de Período reconstruye ese costo
  /// aparte, con el historial de compras (ver src/core/reportes/costo-historico.ts), y lo rotula «reconstruido».
  ///
  /// Sustitución de insumos (docs/plan-sustitucion-insumos-receta-2026-09-26.md, D7): cuando una fila CONSUMO salió de un insumo
  /// SUSTITUTO (ver `sustituyeAProductoId` abajo), este costo sigue siendo el TEÓRICO de la receta, anclado al producto principal —
  /// mismo criterio que un consumo de un simple hermano del mismo Insumo. Si el sustituto cuesta bastante distinto del principal
  /// (a diferencia de los hermanos, que suelen parecerse), el margen de Reportes → Período puede quedar sub/sobreestimado en esas
  /// ventas puntuales; el costo REAL del producto efectivamente consumido ya lo usa `src/core/reportes/perdidas.ts` por separado.
  /// Un reporte de "costo real vs. teórico por sustitución" queda como seguimiento posible, apoyado en `sustituyeAProductoId`.
  costoUnitarioVenta Decimal? @db.Decimal(14, 4)

  /// Precio de LISTA de esta línea, SOLO cuando difiere de lo cobrado (Task #14, docs/plan-clientes-descuento-2026-09-26.md, punto 3):
  /// se llena únicamente en la fila proceso VENTA de una venta con descuento de cliente (`precioPorUnidadStock` de esa misma fila
  /// queda con lo COBRADO, como siempre). `null` = lista y cobrado coinciden (sin descuento, o cualquier proceso que no sea VENTA) —
  /// no se llena redundante con el mismo valor. Existe para poder medir cuánto se "regaló" (precio de lista − cobrado) sin perder
  /// ninguno de los dos números: `precioTotal`/`precioPorUnidadStock` de esta misma fila son el importe/precio COBRADO real, la
  /// fuente de los reportes de dinero de siempre (Período, Costos y márgenes) — esta columna es SOLO para el reporte nuevo de
  /// descuentos por cliente (`/reportes/descuentos-clientes`), que la resta contra el costo real (`src/core/reportes/margen-real.ts`).
  precioListaUnitario Decimal? @db.Decimal(14, 2)

  /// Arrastre de redondeo por fracción de venta (Task #27, docs/plan-redondeo-consumo-fraccionado-2026-09-26.md): solo en filas
  /// CONSUMO de una venta (`registrar-venta.ts`, `cargarDeudaDeRedondeo`/`arrastre-redondeo.ts`) y en su reversión (`anularVenta`) —
  /// `null` en todo lo demás, y también en un CONSUMO cuya cantidad exacta ya coincidía con lo escrito (sin ruido que guardar).
  ///
  /// EL PROBLEMA: redondear cada parte de consumo de CADA venta por separado (a los decimales de `Unidad.decimales` del insumo) sin
  /// memoria entre ventas hace que el Kardex se aleje del consumo real cuanto más fraccionada es la venta — con una unidad de 0
  /// decimales, dos ventas de 0,5 escribían 1 + 1 = 2 en vez de 1.
  ///
  /// LA FÓRMULA: `cantidadExacta` es la magnitud EXACTA (con el mismo signo que `cantidad`) de la parte que esta fila representa,
  /// ANTES de redondear — nunca la acumulada. La deuda de un producto en una sucursal, en cualquier momento, es
  /// `D = Σcantidad − ΣcantidadExacta` (sumando solo las filas CONSUMO con `cantidadExacta` no nulo — las nulas aportan 0 por
  /// definición, ya que ahí `cantidad` YA es la magnitud exacta). Antes de escribir una parte nueva, se redondea `D + exacto` (no
  /// `exacto` a secas) a los decimales del insumo, y la deuda pasa a ser `D + exacto − escrito` — así el Kardex sigue siendo enteros
  /// exactos en su unidad (ninguna fila pierde ni gana precisión), pero el TOTAL de la sucursal converge al consumo real en vez de
  /// redondear cada parte de forma independiente. El alcance de la deuda es (sucursal, producto consumido): puede cruzar secciones y
  /// lotes (una sección puede escribir el sobrante que "le tocó" a otra), nunca más de ±1 unidad de la unidad de stock del insumo —
  /// corregible con Conteo Físico, igual que cualquier redondeo de reparto. Columna aditiva, sin backfill: arranca en `null` para
  /// todo lo existente, así que la deuda de cualquier producto antes de este cambio es 0 (arreglo solo hacia adelante).
  cantidadExacta Decimal? @db.Decimal(20, 8)

  /// Solo si esta línea la generó un ajuste de Conteo Físico (incluida su
  /// eventual reversión al cancelar) — reemplaza la correlación por texto
  /// "idOperacion === idConteo" (Stock.js:2129, Kardex e HOJA_CONTEOS_FISICOS
  /// comparten el mismo UUID a ciegas) por una FK real.
  conteoFisicoId String?
  conteoFisico   ConteoFisico? @relation(fields: [empresaId, conteoFisicoId], references: [empresaId, id])

  /// Solo si esta línea la generó un paso de un Traspaso entre sucursales
  /// (salida/entrada/reingreso) — mismo criterio que `conteoFisicoId`: FK
  /// real en vez de comparar el "ID Operación" de texto contra el ID del
  /// traspaso (Sucursales.js pasaba `idTraspaso` como `idOperacion` a
  /// ciegas, ver escribirMovimientoTransferenciaSucursal_).
  traspasoSucursalId String?
  traspasoSucursal   TraspasoSucursal? @relation(fields: [empresaId, traspasoSucursalId], references: [empresaId, id])

  /// Solo filas CONSUMO de una venta cuyo consumo salió de un Insumo SUSTITUTO declarado en la línea de receta: el producto
  /// de la receta al que reemplazó. null en todo lo demás (incluido un consumo de un hermano del mismo Insumo).
  sustituyeAProductoId String?
  sustituyeAProducto   Producto? @relation("MovimientoSustituyeA", fields: [empresaId, sustituyeAProductoId], references: [empresaId, id])

  /// M2 (Paquete 2): en una línea DEVOLUCION_PROVEEDOR, la línea de COMPRA del Kardex que se devuelve (el origen de la devolución). `null` = una devolución sin origen
  /// declarado (todas las anteriores a M2). NO es única: una línea de compra puede devolverse en varias partes; el tope (no devolver más de lo comprado) lo controla la aplicación.
  /// CHECK en la base: solo en DEVOLUCION_PROVEEDOR y nunca a sí misma. Se escribe solo en el INSERT (el Kardex solo agrega). Nada de `src/` la escribe todavía (Etapa C).
  devuelveAMovimientoId String?
  devuelveAMovimiento   MovimientoStock?  @relation("MovimientoDevuelveA", fields: [empresaId, devuelveAMovimientoId], references: [empresaId, id], onDelete: Restrict)
  /// Las devoluciones (parciales o totales) de esta línea de compra.
  devoluciones          MovimientoStock[] @relation("MovimientoDevuelveA")

  /// Paquete 3 (M3b): en una línea de COMPRA, el renglón de factura de proveedor del que salió. `null` = una compra anterior a las facturas repartidas, o cualquier otro proceso (los AJUSTE de una anulación quedan sin renglón).
  /// CHECK en la base: solo en COMPRA. Se escribe solo en el INSERT (el Kardex solo agrega). Nada de `src/` la escribe todavía (Etapa C).
  facturaProveedorRenglonId String?
  facturaProveedorRenglon   FacturaProveedorRenglon? @relation(fields: [empresaId, facturaProveedorRenglonId], references: [empresaId, id], onDelete: Restrict)

  creadoEn DateTime @default(now())

  @@unique([empresaId, id])
  /// Clave de lectura real: "¿cuánto hay de este producto, en esta
  /// sección, de este lote?" — SUM(cantidad) filtrando por estos 3 campos.
  /// A diferencia de Apps Script (HOJA_STOCK, una hoja materializada
  /// mantenida a mano por aplicarMovimientosAStockIncremental_ porque
  /// rescanear TODO Kardex en cada venta se volvía proporcional a la
  /// historia completa de la hostería, Stock.js:268-294), acá Postgres
  /// puede sumar sobre este índice en tiempo real sin necesidad de
  /// mantener una segunda tabla a mano — si el volumen real lo justifica
  /// más adelante, una vista materializada (REFRESH bajo demanda, o
  /// mantenida por trigger) es una optimización de la porción Stock, no
  /// una tabla que Movimientos tenga que duplicar y sincronizar él mismo.
  @@index([productoId, seccionId, loteVencimiento])
  @@index([operacionId])
  @@index([devuelveAMovimientoId])
  @@index([facturaProveedorRenglonId])
}

/// Reemplaza HOJA_CONTEOS_FISICOS/"ConteosFisicos" (Stock.js:1043-1141) —
/// la bitácora de auditoría de cada conteo (separada del Kardex: un
/// conteo con acción FALTA_MOVIMIENTO o DESCARTAR no mueve stock, pero
/// igual queda registrado que se contó).
model ConteoFisico {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  fecha      DateTime

  productoId      String
  producto        Producto  @relation(fields: [empresaId, productoId], references: [empresaId, id])
  seccionId       String
  seccion         Seccion   @relation(fields: [empresaId, seccionId], references: [empresaId, id])
  /// El LOTE contado (puede quedar vacío: "total, sin lote puntual" — ver
  /// Stock.js:1094-1103), no la fecha del conteo (esa es `fecha` arriba).
  loteVencimiento DateTime? @db.Date

  saldoSistema Decimal @db.Decimal(14, 4)
  conteoReal   Decimal @db.Decimal(14, 4)
  /// = conteoReal − saldoSistema, guardado (no recalculado) porque es
  /// histórico: referencia el saldo del momento del conteo, no el actual.
  diferencia   Decimal @db.Decimal(14, 4)

  accion  AccionConteo
  estado  EstadoConteo
  detalle String?

  usuarioId String
  usuario   User   @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now())

  /// 0, 1 (ajuste original) o 2 (ajuste + reversión al cancelar) líneas de
  /// Kardex generadas por este conteo — ver el docstring de
  /// MovimientoStock.conteoFisicoId.
  movimientos MovimientoStock[]

  /// I3 — idempotencia (mismo mecanismo que `PagoConsignante`): UUID que genera el cliente por fila de la grilla y reenvía tal cual
  /// en un reintento. Nullable durante el rollout (un conteo sin clave no participa de la deduplicación). Único GLOBAL. Vive en el
  /// conteo (no en la `Operacion` del ajuste) porque un conteo sin diferencia, o con acción FALTA_MOVIMIENTO/DESCARTAR, no escribe
  /// ninguna `Operacion`.
  claveIdempotencia String? @unique

  /// I3 — SHA-256 del comando validado (incluye sucursalId): distingue "mismo intento reenviado" de "clave reutilizada con otros datos".
  payloadHash String?

  /// I3 — mensaje de éxito ya formateado, escrito en el MISMO `create` (se conoce antes del insert).
  resultadoMensaje String?

  /// M2 (D9): el motivo con que se canceló el conteo. Solo si `estado = CANCELADO` (CHECK en la base), no vacío, hasta 200. `null` = sin motivo registrado (cancelado antes de M2).
  motivoCancelacion String?

  @@unique([empresaId, id])
  @@index([sucursalId, productoId, seccionId])
}

/// Reemplaza HOJA_PRECIO_LOCAL/"Precio Local" (Catalogo.js:2043-2077) —
/// HUECO REAL encontrado investigando Venta (armarPreviaVentaDesdeItems_,
/// Movimientos.js:1751-1759, lee precioVenta YA resuelto con override
/// local vía resolverPrecioVenta_): la porción Catálogo nunca modeló esto
/// porque en Apps Script vive en la hoja LOCAL de cada hostería (no en
/// HOJAS_CATALOGO_CENTRAL), no porque no hiciera falta — sin esto, Venta
/// no puede calcular el precio real cobrado por sucursal. Se agrega acá,
/// no en Catálogo, porque el único consumidor funcional es Venta.
/// `precio_local` ya está seedeado en ACCIONES (acciones.ts) desde Core,
/// anticipando esta porción.
model PrecioLocalProducto {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  precio     Decimal  @db.Decimal(14, 2)
  /// Local si está cargado Y habilitado; si no, fallback a
  /// Producto.precioVenta (mismo criterio que resolverPrecioVenta_,
  /// Catalogo.js:2072-2077) — no se borra la fila al deshabilitar, mismo
  /// patrón que el resto del catálogo (activo/habilitado, nunca DELETE).
  habilitado Boolean  @default(true)

  @@unique([sucursalId, productoId])
  @@unique([empresaId, id])
}

/// Rendimiento calibrado POR SUCURSAL de UNA línea de receta (override liviano, mismo patrón que PrecioLocalProducto).
/// La receta (ingredientes/pasos/unidades) sigue siendo una sola, del Catálogo Central; esto solo guarda la cantidad y/o
/// la merma que ESTA sucursal calibró. Sin fila, o con un campo en null → se usa el valor central de ese campo
/// (rendimientoEfectivo, src/core/catalogo/rendimiento-local.ts). guardarReceta arrastra las filas a cada versión nueva
/// (salvo cambio de unidad o ingrediente quitado, que se descartan y se auditan).
model RendimientoLocalIngrediente {
  id                  String            @id @default(cuid())
  empresaId           String            @default(dbgenerated("app_empresa_actual()"))
  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  recetaIngredienteId String
  recetaIngrediente   RecetaIngrediente @relation(fields: [empresaId, recetaIngredienteId], references: [empresaId, id], onDelete: Cascade)
  sucursalId          String
  sucursal            Sucursal          @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  cantidad            Decimal?          @db.Decimal(14, 4)
  mermaPorcentaje     Decimal?          @db.Decimal(6, 2)
  actualizadoEn       DateTime          @updatedAt

  @@unique([recetaIngredienteId, sucursalId])
  @@unique([empresaId, id])
  @@index([sucursalId])
}

/// Cada cuánto toca volver a contar este producto en esta sucursal.
/// `0` = desactivado, mismo criterio que Odoo `cyclic_inventory_frequency`
/// (addons/stock/models/stock_location.py, rama 17.0 — el único de los
/// sistemas de referencia que modela una agenda de conteo; ERPNext,
/// Dolibarr y Grocy: NO ENCONTRADO). Por sucursal × producto, no por
/// sección: una agenda de conteo es una política operativa de la sucursal,
/// no de una sección puntual (a diferencia de StockMinimoProducto, que sí
/// es por sección — acá esa granularidad no se necesita).
/// La "próxima fecha" NO se persiste — se deriva de ConteoFisico.fecha más
/// reciente + frecuenciaDias (mismo criterio que el resto del sistema: no
/// materializar lo que se puede calcular; ver el docstring de
/// StockMinimoProducto sobre por qué las vistas de stock no son tablas).
/// Fila ausente = sin agenda, mismo criterio de "no hay fila" que
/// PrecioLocalProducto/StockMinimoProducto (docs/plan-rendimiento-recetas-
/// 2026-09-22.md §E, sub-plan S — decisión 2 de §3, conteos físicos
/// periódicos, comprometida por el dueño 2026-09-22).
model FrecuenciaConteoProducto {
  id             String   @id @default(cuid())
  empresaId      String   @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId     String
  sucursal       Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId     String
  producto       Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  frecuenciaDias Int

  @@unique([sucursalId, productoId])
  @@unique([empresaId, id])
}

// ===================================================================
// STOCK: mínimos por sucursal/sección y la primitiva de Reclasificación.
//
// A diferencia de Apps Script (HOJA_STOCK/StockConsolidado/StockFamilia/
// AlertasStock — hojas MATERIALIZADAS, recalculadas enteras en cada
// recalcularX(), porque rescanear Kardex en cada lectura era proporcional
// a toda la historia acumulada), acá esas 3 vistas NO son tablas: son
// consultas en vivo sobre MovimientoStock/ConteoFisico (ver
// src/core/stock/*.ts) — el mismo argumento que ya justificó no
// materializar el saldo simple en la porción Movimientos (ver el
// docstring de MovimientoStock) aplica con más razón acá: Postgres agrega
// en tiempo real sobre índices reales, no hay necesidad de una segunda
// copia de los datos que se pueda desincronizar del Kardex. Lo único que
// esta porción agrega de verdad como TABLA es la configuración de Stock
// Mínimo (dato que el sistema no puede derivar de ningún otro lado).
// ===================================================================

/// Reemplaza HOJA_STOCK_MINIMO/"Stock Minimo" (Catalogo.js:1922-2019) —
/// mismo patrón que PrecioLocalProducto: vive local a cada sucursal (no es
/// Catálogo Central). `seccionId` nulo = fila "global" de esa sucursal
/// (aplica salvo que haya una fila más específica para esa sección) —
/// mismo criterio de resolución que resolverStockMinimo_ (gana la fila de
/// la sección exacta si existe, si no la global). El índice único parcial
/// para "como máximo una fila global por sucursal+producto" se agrega a
/// mano en la migración (mismo criterio que CapacidadSucursal.sucursalId
/// NULL) — ver README.
model StockMinimoProducto {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  seccionId  String?
  seccion    Seccion? @relation(fields: [empresaId, seccionId], references: [empresaId, id])
  minimo     Decimal  @db.Decimal(14, 4)

  @@unique([productoId, seccionId])
  @@unique([empresaId, id])
}

/// Sección HABITUAL de la que sale un producto de venta (PV) en una sucursal — `Seccion` de STOCK (Barra/Cocina/Depósito),
/// NO `SeccionCarta` (categoría del menú). Fila ausente = sin preferencia: el cierre del POS resuelve solo, por vencimiento.
/// Es una preferencia, no una restricción: si ahí no alcanza, se busca en las secciones marcadas como respaldo
/// (docs/plan-seccion-habitual-stock-2026-09-25.md). Se usa aunque la sección no sirva de respaldo (Seccion.sirveDeRespaldoEnVentas).
model SeccionHabitualProducto {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  seccionId  String
  seccion    Seccion  @relation(fields: [empresaId, seccionId], references: [empresaId, id])

  @@unique([sucursalId, productoId])
  @@unique([empresaId, id])
}

// ===================================================================
// REPORTES: el resto de la porción (período, costos, pérdidas,
// devoluciones, vencimientos, diferencias de ajuste, salud por producto,
// trazabilidad, historial por producto, etc.) es 100% lectura en vivo
// sobre Operacion/MovimientoStock/ConteoFisico/RecetaVersion ya existentes
// — no agrega ninguna tabla nueva (ver src/core/reportes/*.ts). Promociones
// y Combos es la única excepción real: es un catálogo LOCAL (por sucursal,
// no Catálogo Central — la misma "Menú ejecutivo" puede ser promoción en
// una sucursal y plato normal en otra, Catalogo.js:2170-2173) que el
// sistema no puede derivar de ningún otro dato.
// ===================================================================

// ===================================================================
// TRASPASOS ENTRE SUCURSALES (Sucursales.js) — última porción funcional.
//
// DIFERENCIA CLAVE con Apps Script: ahí cada sucursal ("hostería") es un
// proyecto Apps Script + planilla separado, sin ningún canal de ejecución
// directo entre proyectos — por eso `TraspasosSucursales` es una tabla del
// Catálogo Central que cada lado lee/escribe de forma asincrónica (una
// bandeja), y hace falta un registro aparte (`Hosterias`) + una hoja
// Config local (`NombreHosteria`) solo para que cada proyecto sepa "quién
// es". Acá, motor2 es una única app Next.js sobre una única base
// Postgres — todas las sucursales ya son filas reales de `Sucursal`
// (Core), visibles a cualquier request autenticado, y un usuario ya sabe
// "quién es" vía su `ContextoUsuario.sucursalId` (la sucursal ACTIVA de su
// sesión, misma noción que "esta hostería" en Apps Script). No hace falta
// portar ni el registro de hosterías ni el nombre configurable — el WORKFLOW
// de aprobación (que SÍ importa: el stock no se teletransporta, alguien
// tiene que confirmar que lo recibió) es lo único que se porta.
// ===================================================================

/// PULL (el Destino pide) vs. PUSH (el Origen manda directo) — decide qué
/// lado creó la fila y en qué estado arranca (Sucursales.js:19-25).
enum IniciadoPorTraspaso {
  ORIGEN
  DESTINO
}

/// Ciclo completo (Sucursales.js:19-25, comentario de cabecera):
/// PULL: SOLICITADA -(Origen aprueba)-> ENVIADA -(Destino acepta)-> ACEPTADA
///                   -(Origen rechaza)-> RECHAZADA_ORIGEN (fin, nunca tocó stock)
/// PUSH: ENVIADA (ya con el stock afuera al crearse) -(Destino acepta)-> ACEPTADA
///                                                    -(Destino rechaza)-> RECHAZADA_DESTINO -(Origen confirma reingreso)-> CERRADA
enum EstadoTraspaso {
  SOLICITADA
  ENVIADA
  ACEPTADA
  RECHAZADA_ORIGEN
  RECHAZADA_DESTINO
  CERRADA
  /// Quien creó una solicitud PULL (SOLICITADA) la cancela ella misma,
  /// antes de que Origen decida — nunca tocó stock, así que no hace falta
  /// ningún reingreso. Distinto de RECHAZADA_ORIGEN (decisión de Origen).
  CANCELADA
}

/// Reemplaza HOJA_TRASPASOS_SUCURSALES/"TraspasosSucursales"
/// (Sucursales.js:175-193) — mismas 22 columnas, ahora con FKs reales en
/// vez de texto (nombre de sucursal, código de producto) y sin la
/// redundancia "Codigo"/"Unidad" (ya resuelven vía `producto`/
/// `producto.unidadStock`). `seccionOrigenId`/`seccionDestinoId` quedan
/// null hasta que ese lado decide (recién Origen sabe de qué Sección sale
/// al aprobar/enviar; recién Destino sabe a cuál entra al aceptar).
model TraspasoSucursal {
  id        String   @id @default(cuid())
  empresaId String   @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  creadoEn  DateTime @default(now())

  origenSucursalId  String
  origenSucursal    Sucursal @relation("TraspasoOrigen", fields: [empresaId, origenSucursalId], references: [empresaId, id])
  destinoSucursalId String
  destinoSucursal   Sucursal @relation("TraspasoDestino", fields: [empresaId, destinoSucursalId], references: [empresaId, id])

  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  cantidad   Decimal  @db.Decimal(14, 4)

  seccionOrigenId  String?
  seccionOrigen    Seccion? @relation("TraspasoSeccionOrigen", fields: [empresaId, seccionOrigenId], references: [empresaId, id])
  seccionDestinoId String?
  seccionDestino   Seccion? @relation("TraspasoSeccionDestino", fields: [empresaId, seccionDestinoId], references: [empresaId, id])

  iniciadoPor IniciadoPorTraspaso
  estado      EstadoTraspaso      @default(SOLICITADA)

  creadoPorId String
  creadoPor   User    @relation("TraspasoCreadoPor", fields: [creadoPorId], references: [id])
  detalle     String?

  /// Decisión de ORIGEN: aprobar+enviar una Solicitada (PULL), o rechazarla
  /// (-> RECHAZADA_ORIGEN). En un envío directo (PUSH) esto se llena YA en
  /// el momento de crear la fila (Origen decidió mandar, no hay nada que
  /// "aprobar" después).
  fechaDecisionOrigen DateTime?
  decididoPorOrigenId String?
  decididoPorOrigen   User?     @relation("TraspasoDecididoOrigen", fields: [decididoPorOrigenId], references: [id])
  motivoRechazoOrigen String?

  /// Decisión de DESTINO: aceptar una Enviada (-> ACEPTADA), o rechazarla
  /// (-> RECHAZADA_DESTINO, todavía no devuelve el stock — eso lo confirma
  /// Origen aparte, `fechaCierre`/`cerradoPor` abajo).
  fechaDecisionDestino DateTime?
  decididoPorDestinoId String?
  decididoPorDestino   User?     @relation("TraspasoDecididoDestino", fields: [decididoPorDestinoId], references: [id])
  motivoRechazoDestino String?

  /// Solo se llena si Destino rechazó y Origen confirmó el reingreso a su
  /// propio stock (-> CERRADA) — el único otro cierre real (ACEPTADA) no
  /// necesita un campo aparte, el `estado` ya lo dice.
  fechaCierre  DateTime?
  cerradoPorId String?
  cerradoPor   User?     @relation("TraspasoCerradoPor", fields: [cerradoPorId], references: [id])

  movimientos MovimientoStock[]

  @@unique([empresaId, id])
  @@index([origenSucursalId, estado])
  @@index([destinoSucursalId, estado])
}

// ===================================================================
// ÍNDICES ECONÓMICOS — Método 1 de ajuste de margen (docs/comparativa-
// ux-erpnext-dolibarr.md §9/§10), retroactivo pero con dependencia
// externa: a diferencia de MovimientoStock.costoUnitarioVenta (Método 3,
// congela el costo al vender, solo hacia adelante), esto ajusta el
// INGRESO histórico a poder adquisitivo de HOY vía el IPC del INDEC, así
// que sí sirve para ventas ya cargadas.
// ===================================================================

/// Un valor de índice por mes calendario — se sincroniza desde la API de
/// series de tiempo del Ministerio de Economía (apis.datos.gob.ar, serie
/// 101.1_I2NG_2016_M_22, IPC GBA Nivel General base dic-2016), nunca a
/// mano. Un mes ya guardado NUNCA se reescribe (el IPC de un mes cerrado
/// no cambia) — sincronizarIPC (core/reportes/indices-economicos.ts) solo
/// inserta los meses que todavía no están.
model IndicePrecio {
  id       String   @id @default(cuid())
  mes      DateTime @unique @db.Date
  valor    Decimal  @db.Decimal(12, 4)
  creadoEn DateTime @default(now())
}

/// Cotización diaria del dólar oficial (Banco Nación) — para ver precios y valores también en dólares. Una fila por día y fuente:
/// el día de hoy se ACTUALIZA durante el día (la última del día queda), a diferencia de IndicePrecio, que no se reescribe.
/// `fuente`: "BNA" (dolarapi.com / argentinadatos.com, oficial del Banco Nación) o "BCRA" (respaldo: solo trae un valor, va en `venta`).
model CotizacionDolar {
  id       String   @id @default(cuid())
  fecha    DateTime @db.Date
  fuente   String
  compra   Decimal? @db.Decimal(12, 4)
  venta    Decimal  @db.Decimal(12, 4)
  creadoEn DateTime @default(now())

  @@unique([fecha, fuente])
}

// ===================================================================
// CARTA: el contenido de la carta pública (restaurant-menu-design la lee
// por GET /api/carta/[sucursal], de solo lectura — ver
// docs/plan-carta-catalogo-2026-09-24.md y
// docs/grounding-unificacion-carta-stock-2026-09-23.md).
//
// Nada de acá cambia el catálogo: el QUÉ se vende (Producto PV), el
// precio (precioVenta / PrecioLocalProducto) y el DÓNDE
// (DisponibilidadProducto) siguen viniendo de donde ya vienen. Estas
// tablas solo agregan lo que la carta necesita y el catálogo no tiene:
// las secciones visuales de la carta, el texto de cara al cliente de cada
// PV y las promos informativas de cada sucursal.
//
// OJO con el nombre: `Seccion` (arriba, MOVIMIENTOS) es la sección de
// STOCK de una sucursal (depósito, cocina…). `SeccionCarta` es la sección
// de la carta ("Platos Principales"); en código y UI decir siempre
// "sección de carta".
// ===================================================================

/// Sección visual de la carta pública (en restaurant-menu-design,
/// `MenuCategory`). Global — Catálogo Central, como CategoriaProducto —
/// por decisión D4 del plan: si hiciera falta un título o imagen distinto
/// por sucursal, se agrega después un override aditivo.
model SeccionCarta {
  id           String                   @id @default(cuid())
  empresaId    String                   @default(dbgenerated("app_empresa_actual()"))
  empresa      Empresa                  @relation(fields: [empresaId], references: [id])
  /// "Platos Principales" → MenuCategory.label.
  nombre       String
  /// "Del fuego" → titulo_seccion (null = se usa `nombre`).
  titulo       String?
  descripcion  String?
  /// Solo `https://` sin espacios, comillas ni paréntesis: la carta la mete
  /// en `backgroundImage: url(...)` (ver src/core/carta/armar-menu.ts).
  imagenUrl    String?
  orden        Int                      @default(0)
  /// Nunca se borra una sección: se apaga (mismo patrón que el catálogo).
  activa       Boolean                  @default(true)
  /// Lo que se ubica en esta sección, DIRECTO (docs/plan-carta-seccion-directa-2026-09-25.md): productos sueltos e ítems agrupados.
  contenidos   ContenidoCartaProducto[]
  agrupados    ItemAgrupadoCarta[]
  promos       PromoCarta[]
  /// Cupos de promos ARMABLES que eligen de ESTA sección (Task #16) — no es lo mismo que `promos` (la promo en sí, ubicada
  /// en su PROPIA sección): una promo de la sección "Menús" puede tener un cupo que elige de "Postres".
  cuposDePromo PromoCartaCupo[]

  @@unique([empresaId, nombre])
  @@unique([empresaId, id])
  @@index([activa, orden])
}

/// El texto de cara al cliente de un PV. FILA AUSENTE = NO SE MUESTRA
/// (decisión D3, opt-in — mismo criterio que DisponibilidadProducto): nada
/// interno aparece en la carta pública sin que alguien lo marque. Por eso
/// la migración NO hace backfill.
///
/// Se ubica DIRECTO en su sección de carta (docs/plan-carta-seccion-directa-2026-09-25.md): la Categoría de producto no
/// tiene ningún papel en la carta. Sin imagen propia: la carta pública solo dibuja la imagen de la SECCIÓN.
model ContenidoCartaProducto {
  id             String        @id @default(cuid())
  empresaId      String        @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  /// La carta es PROPIA de cada sucursal (ADR-009, C3; decisión del dueño 2026-10-02): el contenido de un producto es de UNA sucursal.
  sucursalId     String
  sucursal       Sucursal      @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId     String
  producto       Producto      @relation(fields: [empresaId, productoId], references: [empresaId, id])
  visibleEnCarta Boolean       @default(false)
  /// Obligatoria si `visibleEnCarta` (lo exige la Server Action, DA2); null solo en un contenido oculto.
  seccionCartaId String?
  seccionCarta   SeccionCarta? @relation(fields: [empresaId, seccionCartaId], references: [empresaId, id])
  descripcion    String?
  tags           String[]      @default([])
  /// ★ "especial" de la carta.
  especial       Boolean       @default(false)
  /// Orden dentro de su sección de carta (misma escala que ItemAgrupadoCarta.orden).
  orden          Int           @default(0)
  /// Fase 5 de la ola «precio y carta» (DEC-11): en un producto BASE con un solo eje en la carta, `true` = el nombre del producto va arriba como encabezado y las opciones debajo; `false` (default) = la
  /// base sale OCULTA (cada opción, una fila con su nombre completo). En un producto directo o en una base de dos ejes (que sale siempre como tabla) no decide nada. Lo escribe solo
  /// `guardarContenidoCartaProducto` (auditado por columna) y lo copia «copiar carta».
  mostrarNombreArriba Boolean @default(false)
  /// Carpeta VISUAL de género del POS (docs/plan-genero-carta-2026-09-26.md, G1/G2), opcional. No implica precio ni
  /// sustituibilidad (eso es ItemAgrupadoCarta) ni tiene nada que ver con Grupo (Insumo/stock) ni con CategoriaProducto (que no
  /// ubica nada en la carta): solo visual, solo del POS por ahora (G4, la carta pública `CartaV1` no lo usa).
  generoCartaId  String?
  generoCarta    GeneroCarta?  @relation(fields: [empresaId, generoCartaId], references: [empresaId, id])
  actualizadoEn  DateTime      @updatedAt

  @@unique([sucursalId, productoId])
  @@unique([empresaId, id])
  @@index([seccionCartaId])
  @@index([generoCartaId])
}

/// Ítem AGRUPADO de la carta (docs/plan-agrupacion-items-carta-2026-09-24.md): un solo renglón visible ("Gaseosa 500cc") que
/// agrupa varios PV reales y distintos (Coca-Cola 500cc, Sprite 500cc…). Lleva lo de cara al cliente (como ContenidoCartaProducto).
/// SIN precio propio (D5): el precio es el de sus opciones, que tienen que coincidir; si no, la carta muestra el mayor y el
/// admin avisa. PROPIO de cada sucursal (ADR-009 C3; antes global). Se ubica DIRECTO en su sección de carta, igual que un PV suelto
/// (docs/plan-carta-seccion-directa-2026-09-25.md). Sin imagen propia. Un solo nivel, sin árbol (no es Grupo). Nunca se borra:
/// se apaga.
model ItemAgrupadoCarta {
  id             String                    @id @default(cuid())
  empresaId      String                    @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa                   @relation(fields: [empresaId], references: [id])
  /// De UNA sucursal (la carta es propia de cada una, ADR-009 C3); la sección donde se ubica sigue siendo de la empresa.
  sucursalId     String
  sucursal       Sucursal                  @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  nombre         String
  seccionCartaId String
  seccionCarta   SeccionCarta              @relation(fields: [empresaId, seccionCartaId], references: [empresaId, id])
  descripcion    String?
  tags           String[]                  @default([])
  especial       Boolean                   @default(false)
  /// Orden dentro de su sección de carta (misma escala que ContenidoCartaProducto.orden).
  orden          Int                       @default(0)
  activo         Boolean                   @default(true)
  /// Carpeta VISUAL de género del POS (docs/plan-genero-carta-2026-09-26.md, G1/G2), opcional. Las opciones del ítem agrupado
  /// heredan este género: nunca tienen uno propio.
  generoCartaId  String?
  generoCarta    GeneroCarta?              @relation(fields: [empresaId, generoCartaId], references: [empresaId, id])
  creadoEn       DateTime                  @default(now())
  actualizadoEn  DateTime                  @updatedAt
  opciones       OpcionItemAgrupadoCarta[]

  @@unique([sucursalId, nombre])
  @@unique([empresaId, id])
  @@index([seccionCartaId])
  @@index([activo])
  @@index([generoCartaId])
}

/// Carpeta VISUAL del POS que agrupa, dentro de una sección de carta, tanto productos sueltos como ítems agrupados que
/// comparten género (p. ej. "Cerveza"; docs/plan-genero-carta-2026-09-26.md). NO implica precio ni sustituibilidad (eso lo
/// sigue manejando ItemAgrupadoCarta, que no se toca); NO es Insumo, ni Grupo (que es de stock/Insumo), ni CategoriaProducto
/// (que no ubica nada en la carta ni en el POS). PROPIO de cada sucursal (ADR-009 C3; las SECCIONES siguen siendo de la empresa): "Cerveza" aparece en cualquier sección donde
/// tenga contenido pedible, no en una sola. SOLO interno del POS por ahora (G4): la carta pública (`CartaV1`) no lo usa.
/// Nunca se borra: se apaga (mismo patrón que el resto del catálogo/carta).
model GeneroCarta {
  id         String                   @id @default(cuid())
  empresaId  String                   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa                  @relation(fields: [empresaId], references: [id])
  /// De UNA sucursal (la carta es propia de cada una, ADR-009 C3).
  sucursalId String
  sucursal   Sucursal                 @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  nombre     String
  orden      Int                      @default(0)
  activo     Boolean                  @default(true)
  creadoEn   DateTime                 @default(now())
  contenidos ContenidoCartaProducto[]
  agrupados  ItemAgrupadoCarta[]

  @@unique([sucursalId, nombre])
  @@unique([empresaId, id])
  @@index([activo, orden])
}

/// Un PV real dentro de un ítem agrupado. `productoId @unique`: un producto está en a lo sumo UN ítem agrupado (D2). Un producto
/// agrupado nunca sale suelto en la carta, aunque tenga ContenidoCartaProducto visible (D3). Quitarlo = borrar esta fila (es
/// solo una referencia).
model OpcionItemAgrupadoCarta {
  id                  String            @id @default(cuid())
  empresaId           String            @default(dbgenerated("app_empresa_actual()"))
  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  /// De la misma sucursal que su ítem agrupado (lo valida la Server Action; la FK compuesta solo ata a la empresa).
  sucursalId          String
  sucursal            Sucursal          @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  itemAgrupadoCartaId String
  itemAgrupadoCarta   ItemAgrupadoCarta @relation(fields: [empresaId, itemAgrupadoCartaId], references: [empresaId, id])
  productoId          String
  producto            Producto          @relation(fields: [empresaId, productoId], references: [empresaId, id])
  /// Orden de la opción dentro del ítem agrupado.
  orden               Int               @default(0)
  creadoEn            DateTime          @default(now())

  @@unique([sucursalId, productoId])
  @@unique([empresaId, id])
  @@index([itemAgrupadoCartaId])
}

/// Promo de la EMPRESA dentro de una sección de carta (título, descripción, precio): se define UNA vez y cada sucursal la
/// activa o la apaga con su fila de `PromoCartaSucursal` (decisión del dueño, 2026-10-01: una promo es siempre una composición;
/// un producto suelto con descuento no es una promo). `activa` es el apagado para TODA la empresa (nunca se borra, se apaga).
/// Una promo se ofrece en una sucursal solo si `PromoCarta.activa` Y su `PromoCartaSucursal` de esa sucursal está activa.
/// No referencia a `Producto` ni mueve stock directamente.
///
/// SIN ningún `PromoCartaCupo` (el caso de siempre, y el único hasta Task #16): sigue siendo puramente INFORMATIVA — el POS la
/// ignora (`selector-carta.ts`: "las promos de la carta se ignoran") y la composición real de "qué lleva" quedaba fuera del
/// sistema.
///
/// CON uno o más `PromoCartaCupo` (Task #16, docs/plan-promo-combo-2026-09-26.md): pasa a ser ARMABLE — aparece en el POS
/// (`selector-carta-consulta.ts`, cuarto parámetro) para que el mozo elija, cupo por cupo, con qué se arma cada instancia
/// (D1: mínimo/máximo por cupo). El precio acá sigue siendo el de la CABECERA congelada al agregarla (`PromoCuenta.precio`);
/// el de cada componente elegido sale de prorratear ese precio (D3, `prorratearPrecioPromo`, `src/core/pos/promo-combo.ts`).
/// Sin backfill: una promo existente sigue informativa hasta que alguien le agrega cupos a propósito. El contrato público
/// `CartaV1` no cambia (la carta pública nunca tuvo ni tiene cupos).
model PromoCarta {
  id             String               @id @default(cuid())
  empresaId      String               @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa              @relation(fields: [empresaId], references: [id])
  seccionCartaId String
  seccionCarta   SeccionCarta         @relation(fields: [empresaId, seccionCartaId], references: [empresaId, id])
  titulo         String
  descripcion    String?
  precio         Decimal              @db.Decimal(14, 2)
  orden          Int                  @default(0)
  activa         Boolean              @default(true)
  creadoEn       DateTime             @default(now())
  /// GO-3 (ADR-032, D-7): la VIGENCIA opcional de la promo, en días de calendario de la zona de la empresa (DATE local, rango inclusive). NULL = sin límite por ese lado. CHECK: desde <= hasta.
  /// Se evalúa al AGREGAR la promo a la cuenta (`promoVigenteEl`, `src/core/carta/vigencia-de-promo.ts`); lo que ya está en la mesa no cambia.
  vigenteDesde   DateTime?            @db.Date
  vigenteHasta   DateTime?            @db.Date
  /// GO-3 (D-7): máscara de los días de la semana en que vale (bit 0 = lunes … bit 6 = domingo; 1 a 127, CHECK). NULL = todos los días.
  diasDeSemana   Int?                 @db.SmallInt
  /// GO-3 (ADR-032): control OPTIMISTA de la edición de la promo (`UPDATE … WHERE version = esperada`; 0 filas = VERSION_DESACTUALIZADA). >= 1 (CHECK); lo incrementa la aplicación.
  version        Int                  @default(1)
  /// «Solo salón» (docs/diseno-promo-solo-salon-2026-10-26.md): la promo se vende desde el POS pero NO aparece en la carta pública (web, QR ni impresa). Es de la EMPRESA (como la promo) y
  /// se cambia con su caso de uso (`guardarSoloSalonPromoCarta`: control optimista con `version`, auditado). El único lector es `wherePromoOfrecidaEn(sucursalId, audiencia)` (`core/carta/promo-sucursal.ts`).
  soloSalon      Boolean              @default(false)
  cupos          PromoCartaCupo[]
  instancias     PromoCuenta[]
  sucursales     PromoCartaSucursal[]

  @@unique([empresaId, id])
  @@index([activa])
  @@index([seccionCartaId])
}

/// "Producto con descuento" (decisión del dueño, 2026-10-01: NO es una promoción — una promo es siempre una composición, `PromoCarta`). Un
/// producto de venta tiene, en UNA sucursal, un descuento en PORCENTAJE sobre su precio vigente ahí (el local si lo tiene, si no el global):
/// FILA AUSENTE = sin descuento. El % es de la sucursal (cada una lo fija o lo saca), 0 < porcentaje < 100 con 2 decimales (lo exige la Server
/// Action); se quita borrando la fila. La carta muestra el precio de lista tachado y el POS cobra el descontado; el precio de lista queda en
/// `CuentaItem.precioCartaUnitario` para medir el ahorro del cliente.
model DescuentoProductoSucursal {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  productoId String
  producto   Producto @relation(fields: [empresaId, productoId], references: [empresaId, id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  porcentaje Decimal  @db.Decimal(5, 2)

  @@unique([productoId, sucursalId])
  @@unique([empresaId, id])
  @@index([sucursalId])
}

/// Estado de UNA promo de la empresa en UNA sucursal (2026-10-01): FILA AUSENTE = la sucursal no la ofrece (opt-in, igual que
/// `DisponibilidadProducto`/`ContenidoCartaProducto`). `activa` la prende o la apaga en esa sucursal; apagada no va en la carta ni
/// en el POS. `precioLocal` (opcional) reemplaza a `PromoCarta.precio` solo en esa sucursal — mismo patrón que
/// `PrecioLocalProducto`; `null` = precio de la empresa. Nunca se borra: se apaga.
model PromoCartaSucursal {
  id           String     @id @default(cuid())
  empresaId    String     @default(dbgenerated("app_empresa_actual()"))
  empresa      Empresa    @relation(fields: [empresaId], references: [id])
  promoCartaId String
  promoCarta   PromoCarta @relation(fields: [empresaId, promoCartaId], references: [empresaId, id])
  sucursalId   String
  sucursal     Sucursal   @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  activa       Boolean    @default(true)
  precioLocal  Decimal?   @db.Decimal(14, 2)

  @@unique([promoCartaId, sucursalId])
  @@unique([empresaId, id])
  @@index([sucursalId, activa])
}

/// UN cupo de una promo ARMABLE (Task #16, docs/plan-promo-combo-2026-09-26.md, D1): "elegí entre `cantidadMinima` y
/// `cantidadMaxima` de la sección `seccionCarta`". Los elegibles de un cupo NO son una lista propia acá — son los mismos que
/// el selector del POS ya ofrece en esa sección (D5: sueltos visibles + opciones de ítems agrupados activos, disponibles en
/// la sucursal, sin "Fuera de carta"), resueltos en el momento por `selector-carta-consulta.ts`/`promo-combo.ts`; así un cupo
/// nunca queda desincronizado de lo que la carta muestra. Un producto pertenece a lo sumo a UNA `SeccionCarta`
/// (`ContenidoCartaProducto`/`ItemAgrupadoCarta` son cada uno de una sola sección), así que nunca cae en dos cupos de la
/// misma promo por accidente — `@@unique([promoCartaId, seccionCartaId])` además impide dos cupos de la MISMA sección en la
/// misma promo (se edita el que ya existe, no se duplica).
///
/// FK RESTRICT en las dos direcciones (mismo criterio que el resto de la carta/catálogo): ni la promo ni la sección se
/// pueden borrar mientras tengan un cupo — se apagan (`PromoCarta.activa`/`SeccionCarta.activa`), nunca se borran.
///
/// GO-3 (ADR-032): un cupo tiene un TIPO (`SECCION`, el de siempre; `LISTA`, una lista de productos que arma el dueño, aunque estén fuera de carta; `DEL_DIA`, el plato del día que carga la sucursal por
/// fecha). Lista cerrada como TEXT con CHECK, espejo de `TIPOS_DE_CUPO` (`src/core/pos/promo-combo.ts`). `seccionCartaId` es obligatoria si y solo si el tipo es SECCION (CHECK); fuera de SECCION
/// el cupo lleva `nombre` (CHECK; único por promo sin importar mayúsculas: índice parcial que solo vive en la migración). Un cupo ya no se borra: `activo = false` es la baja lógica (los
/// lectores de hoy filtran `tipo = 'SECCION' AND activo`, primer despliegue de «expandir y contraer»). El único `(promoCartaId, seccionCartaId)` sigue valiendo para los de sección (los NULL son distintos).
model PromoCartaCupo {
  id             String                @id @default(cuid())
  empresaId      String                @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa               @relation(fields: [empresaId], references: [id])
  promoCartaId   String
  promoCarta     PromoCarta            @relation(fields: [empresaId, promoCartaId], references: [empresaId, id])
  /// Solo en un cupo SECCION (CHECK). NULL en LISTA y DEL_DIA.
  seccionCartaId String?
  seccionCarta   SeccionCarta?         @relation(fields: [empresaId, seccionCartaId], references: [empresaId, id])
  /// D1: mínimo por cupo, 0 por defecto — un cupo puede ser opcional ("elegí hasta 2 postres, o ninguno").
  cantidadMinima Int                   @default(0)
  cantidadMaxima Int
  /// Orden de este cupo dentro de la promo (misma escala que `PromoCarta.orden`/`ContenidoCartaProducto.orden`).
  orden          Int                   @default(0)
  /// GO-3: SECCION (por defecto: todas las filas de antes), LISTA o DEL_DIA (CHECK).
  tipo           String                @default("SECCION")
  /// GO-3: el nombre del lugar («Entrada», «Plato del día»): obligatorio fuera de SECCION (CHECK), con algún carácter visible y hasta 80.
  nombre         String?
  /// GO-3: la baja lógica del cupo (nunca se borra).
  activo         Boolean               @default(true)
  entradas       EntradaDeCupo[]
  entradasDelDia EntradaDelDiaDeCupo[]

  @@unique([promoCartaId, seccionCartaId])
  @@unique([empresaId, id])
}

/// GO-3 (ADR-032): una ENTRADA de un cupo LISTA: un producto de venta (aunque no esté en la carta) con una CONFIGURACIÓN FIJA opcional de opciones de venta que define el dueño («Café · Mediano ·
/// Con leche»; D-6: el mozo no elige opciones dentro del combo). DE EMPRESA. `claveConfiguracion` es el canónico ordenado `opcionId=cantidad;…` de sus `OpcionDeEntradaDeCupo` (vacío = sin
/// configuración; `claveDeConfiguracion`, `src/core/pos/promo-combo.ts`): estable, NO la huella de la línea (que depende de versiones e importes). Único `(cupoId, productoId, claveConfiguracion)`.
/// La identidad (cupo, producto, configuración) es inmutable: la app solo cambia `orden`, `activa` y `actualizadoEn`. No se borra: se desactiva. Un cupo LISTA con UNA sola entrada activa y
/// mínimo = máximo es un COMPONENTE FIJO (no hay tabla propia). Que el producto sea PV, tenga precio de referencia (D-8) y origen de stock (D-9) lo valida la aplicación al cargarla y al vender.
model EntradaDeCupo {
  id                 String                  @id @default(cuid())
  empresaId          String                  @default(dbgenerated("app_empresa_actual()"))
  empresa            Empresa                 @relation(fields: [empresaId], references: [id])
  cupoId             String
  cupo               PromoCartaCupo          @relation(fields: [empresaId, cupoId], references: [empresaId, id])
  productoId         String
  producto           Producto                @relation(fields: [empresaId, productoId], references: [empresaId, id])
  /// El canónico de la configuración fija (CHECK de forma); vacío = sin configuración.
  claveConfiguracion String                  @default("")
  orden              Int                     @default(0)
  activa             Boolean                 @default(true)
  creadoEn           DateTime                @default(now())
  actualizadoEn      DateTime                @default(now())
  opciones           OpcionDeEntradaDeCupo[]

  @@unique([cupoId, productoId, claveConfiguracion])
  @@unique([empresaId, id])
  @@index([productoId])
}

/// GO-3: una opción de la configuración fija de una entrada (la MEDIDA «Mediano», la VARIANTE «Con leche»), con sus unidades (1 a 10, CHECK). DE EMPRESA. SOLO se agrega (la configuración es
/// parte de la identidad de la entrada: cambiarla es otra entrada). La versión vigente de la opción, el apagado en la sucursal y la validez de la combinación se revalidan al vender.
model OpcionDeEntradaDeCupo {
  id        String        @id @default(cuid())
  empresaId String        @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa       @relation(fields: [empresaId], references: [id])
  entradaId String
  entrada   EntradaDeCupo @relation(fields: [empresaId, entradaId], references: [empresaId, id])
  opcionId  String
  opcion    OpcionDeGrupo @relation(fields: [empresaId, opcionId], references: [empresaId, id])
  cantidad  Int           @default(1)
  creadoEn  DateTime      @default(now())

  @@unique([entradaId, opcionId])
  @@unique([empresaId, id])
  @@index([opcionId])
}

/// GO-3 (ADR-032, D-1): el PLATO DEL DÍA de un cupo DEL_DIA en UNA sucursal y UNA fecha (DATE local de la zona de la empresa). `PROPIA` (`sucursalId` NOT NULL; sus políticas de alcance las agrega
/// GO-3d-rls). ADR-009, familia `optin`: SIN FILA ACTIVA para la fecha de hoy = no hay plato del día y, con mínimo mayor que 0, el menú no se puede armar (falla cerrado: nunca el plato de ayer).
/// Único `(cupoId, sucursalId, fecha, productoId)`. La app solo cambia `activa`, `actualizadoPorId` y `actualizadoEn` («llevar al estado»); no borra nada.
model EntradaDelDiaDeCupo {
  id               String         @id @default(cuid())
  empresaId        String         @default(dbgenerated("app_empresa_actual()"))
  empresa          Empresa        @relation(fields: [empresaId], references: [id])
  cupoId           String
  cupo             PromoCartaCupo @relation(fields: [empresaId, cupoId], references: [empresaId, id])
  sucursalId       String
  sucursal         Sucursal       @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  /// El día de calendario de la zona de la empresa (DATE, sin hora).
  fecha            DateTime       @db.Date
  productoId       String
  producto         Producto       @relation(fields: [empresaId, productoId], references: [empresaId, id])
  activa           Boolean        @default(true)
  actualizadoPorId String
  actualizadoPor   User           @relation(fields: [actualizadoPorId], references: [id], onDelete: Restrict)
  creadoEn         DateTime       @default(now())
  actualizadoEn    DateTime       @default(now())

  @@unique([cupoId, sucursalId, fecha, productoId])
  @@unique([empresaId, id])
  @@index([sucursalId, fecha])
  @@index([productoId])
}

/// Registro público de una sucursal en el portal/carta (docs/plan-registro-tenants-2026-09-24.md, ADR-006). FILA AUSENTE = esta
/// sucursal no está en el portal (opt-in; sin backfill). Lo lee la carta pública interna; se carga en /carta/portal. Sin onDelete: RESTRICT
/// (las sucursales nunca se borran, se desactivan).
model SucursalPublica {
  id              String   @id @default(cuid())
  empresaId       String   @default(dbgenerated("app_empresa_actual()"))
  empresa         Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId      String
  sucursal        Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  /// tenant_id / URL /carta/<slug>. Se genera UNA vez desde Sucursal.nombre (slugTenant) y se puede editar; nunca se recalcula.
  slug            String
  /// null = se usa Sucursal.nombre.
  etiqueta        String?
  /// Público: subtítulo de la tarjeta del portal (restaurant-menu-design lo dibuja como `notas`).
  subtituloPortal String?
  /// Posición en el mapa del portal, % 0-100 (centro). x/y/w van juntos; h opcional (la carta usa 5).
  posX            Decimal? @db.Decimal(5, 2)
  posY            Decimal? @db.Decimal(5, 2)
  posW            Decimal? @db.Decimal(5, 2)
  posH            Decimal? @db.Decimal(5, 2)
  orden           Int      @default(0)
  publicada       Boolean  @default(false)
  actualizadoEn   DateTime @updatedAt

  @@unique([empresaId, sucursalId])
  @@unique([empresaId, slug])
  @@unique([empresaId, id])
}

/// Tema visual de la carta pública de una sucursal (las claves por sucursal del catálogo CLAVES_TEMA_V1 de
/// src/core/carta/tema.ts; los precios son convención fija del sistema y no están acá). FILA AUSENTE = la carta usa el estilo
/// por defecto (opt-in; sin backfill).
/// 1:1 con Sucursal y no con SucursalPublica (docs/plan-tema-carta-2026-09-24.md, D1): el tema se puede preparar antes de
/// agregar la sucursal al portal, y "Quitar del portal" no lo borra. Sin onDelete: RESTRICT (las sucursales nunca se borran).
model TemaCartaSucursal {
  id             String   @id @default(cuid())
  empresaId      String   @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId     String
  sucursal       Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  /// clave de SiteConfig → valor ya validado. Claves fuera del catálogo se ignoran al servir.
  valores        Json     @default("{}")
  /// false = borrador (se edita y previsualiza en motor2; la carta usa el estilo por defecto). true = la carta usa este tema.
  aplicarEnCarta Boolean  @default(false)
  actualizadoEn  DateTime @updatedAt

  @@unique([empresaId, sucursalId])
  @@unique([empresaId, id])
}

/// Apariencia del PORTAL de sucursales de una empresa (`/carta-publica/<empresa>`): la config que en restaurant-menu-design
/// vivía en la hoja maestra (portal_*, logo de la empresa, derechos) — las 22 claves de CLAVES_PORTAL_V1
/// (src/core/carta/portal.ts). 1:1 con Empresa (una fila por empresa). FILA AUSENTE = el portal usa los defaults del catálogo
/// (grilla sin imagen). Va aparte de TemaCartaSucursal porque el portal es de la empresa, no de una sucursal.
model PortalCartaEmpresa {
  id            String   @id @default(cuid())
  empresaId     String   @unique @default(dbgenerated("app_empresa_actual()"))
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  /// clave de CLAVES_PORTAL_V1 → valor ya validado. Claves fuera del catálogo o valores inválidos se ignoran al servir.
  valores       Json     @default("{}")
  actualizadoEn DateTime @updatedAt
}

// ===================================================================
// POS: mapa de mesas del salón (docs/plan-mapa-de-mesas-2026-09-24.md) y toma de pedido (docs/plan-tomar-pedido-2026-09-25.md).
//
// Tres entidades: la mesa física, la CUENTA abierta de esa mesa y sus ítems. Sin tabla de comanda/KOT propia:
// - KOT DERIVADO: «Enviar a cocina» le pone `numeroEnvio = max(numeroEnvio) + 1` de la cuenta a los ítems elegidos que seguían
//   sin enviar (transacción serializable). El «ticket» del envío n son los ítems con ese número. No cierra la puerta a una tabla
//   `EnvioCocina` futura (impresión, pantalla de cocina, ruteo por estación).
// - ANULACIÓN = FILA ESPEJO: un ítem ya enviado NUNCA se edita ni se borra. Anularlo (total o parcial) escribe un CuentaItem
//   NUEVO con cantidad NEGATIVA, el mismo producto/precio/numeroEnvio, `anulaAItemId` apuntando al original, `motivoAnulacion` y
//   quién lo hizo (más una fila de RegistroAuditoria). Lo que queda se calcula: restante = cantidad + Σ espejos. Mismo criterio
//   append-only que anularVenta/anularCompra (líneas inversas).
// - Un ítem SIN enviar (`numeroEnvio` null) es un borrador: se quita con DELETE físico, sin motivo ni auditoría.
// Invariantes validadas en la APLICACIÓN (src/server/actions/pos/cuenta.ts), no en la base: espejo ⇒ cantidad < 0, mismo
// numeroEnvio que su original y motivoAnulacion no vacío; original (anulaAItemId null) ⇒ cantidad > 0.
// - NUMERACIÓN DE LA TICKET (docs/plan-numeracion-ticket-2026-09-25.md): cada papel impreso del ticket de cierre es una fila de
//   `EjemplarTicket` (control interno, no fiscal). Número base por sucursal = max + 1 dentro de la tx serializable de `cerrarCuenta`
//   (solo con venta, después de validarla), ejemplar 1 = A. Corrección (`emitirTicketCorregido`, tras anular una línea con
//   anularVenta) = fila NUEVA con el mismo número, el ejemplar siguiente, `corrigeAId` → el A y el motivo. Nunca se edita ni se borra.
// Grounding: docs/grounding-pos-mesas-comandas-2026-09-24.md §1/§3/§6.
// ===================================================================

/// Mesa física del salón. El estado (libre/en_pedido/ocupada) NO se persiste: se deriva de su Cuenta abierta (src/core/pos/mesas.ts).
model Mesa {
  id         String   @id @default(cuid())
  empresaId  String   @default(dbgenerated("app_empresa_actual()"))
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  sucursalId String
  sucursal   Sucursal @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  numero     Int
  creadoEn   DateTime @default(now())
  cuentas    Cuenta[]

  @@unique([sucursalId, numero])
  @@unique([empresaId, id])
}

/// La CUENTA abierta de una mesa (no la comanda/KOT: ver docs/grounding-pos-mesas-comandas-2026-09-24.md §1/§6).
/// cerradaEn null = abierta. A lo sumo UNA abierta por mesa (índice único parcial manual "Cuenta_una_abierta_por_mesa_key",
/// en la migración pos_mesas_cuentas: Prisma no sabe declarar un índice con WHERE). Sin vencimiento automático (§2).
/// Se cierra con `cerrarCuenta` (registra la venta) o `liberarMesa` (cuenta sin ningún ítem, sin venta).
model Cuenta {
  id               String             @id @default(cuid())
  empresaId        String             @default(dbgenerated("app_empresa_actual()"))
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  mesaId           String
  mesa             Mesa               @relation(fields: [empresaId, mesaId], references: [empresaId, id])
  abiertaPorId     String
  abiertaPor       User               @relation("CuentaAbiertaPor", fields: [abiertaPorId], references: [id])
  abiertaEn        DateTime           @default(now())
  cerradaEn        DateTime?
  cerradaPorId     String?
  cerradaPor       User?              @relation("CuentaCerradaPor", fields: [cerradaPorId], references: [id])
  items            CuentaItem[]
  ejemplaresTicket EjemplarTicket[]
  promos           PromoCuenta[]
  agregados        AgregadoDeCuenta[]
  /// M2: la cabecera de venta de esta cuenta, una vez cerrada (a lo sumo una: `Venta.cuentaId` es único por empresa). `null` = abierta, o cerrada antes de M2.
  venta            Venta?

  /// Cuántos comensales se sentaron (docs/plan-comensales-y-limite-mesas-2026-09-26.md). Obligatorio y SIN valor por defecto al abrir
  /// la cuenta (`abrirCuenta`) — un default sesgaría la métrica de rotación que existe para medir (Reportes › Rotación de mesas).
  /// `null` = cuenta abierta ANTES de este cambio (sin backfill: no se inventan datos históricos); una cuenta nunca vuelve a `null`.
  /// Se puede corregir mientras la cuenta esté ABIERTA (`corregirComensales`: llega gente después, se corrige un error) — una vez
  /// cerrada, el dato queda congelado, igual que el precio de cada ítem.
  ///
  /// SOLO para medir rotación: NO habilita dividir la cuenta por persona. No hay entidad "comensal"/"asiento" ni relación con
  /// `CuentaItem` — ningún ítem se asocia a un comensal en particular.
  comensales Int?

  /// Cliente con descuento asignado a esta cuenta (Task #14, docs/plan-clientes-descuento-2026-09-26.md): CUALQUIER mozo con
  /// `pos_tomar_pedido` puede asignarlo (D3, `asignarClienteACuenta`), sobre una cuenta abierta, en cualquier momento antes de
  /// cerrarla. FK RESTRICT: una cuenta ya cerrada sigue apuntando a su Cliente para siempre.
  clienteId           String?
  cliente             Cliente? @relation(fields: [empresaId, clienteId], references: [empresaId, id])
  /// SNAPSHOT del `Cliente.descuentoPorcentaje` en el momento de asignarlo (D7): el % se CONGELA acá — si el % del cliente cambia
  /// después con la cuenta ya abierta, esta cuenta no se entera (nunca se vuelve a leer `Cliente.descuentoPorcentaje` para calcular
  /// lo cobrado). `null` = sin cliente asignado (el caso de siempre, sin descuento). Es el que usa `precioConDescuento`
  /// (src/core/moneda.ts) al cerrar la cuenta — `CuentaItem.precioUnitario` sigue siendo el precio de LISTA, sin cambiar de semántica.
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)

  @@unique([empresaId, id])
  @@index([mesaId])
}

/// Una instancia de promo ARMABLE agregada a una cuenta (Task #16, docs/plan-promo-combo-2026-09-26.md, análoga a `Cliente` en
/// `Cuenta`: la referencia de CATÁLOGO — `PromoCarta` — puede cambiar título/precio después; esta fila congela el snapshot con
/// el que se cobró ESTA instancia, mismo criterio que `Cuenta.descuentoPorcentaje`). Cada vez que se arma la promo en el POS
/// (paso 8a) es una fila NUEVA: dos menús del día en la misma cuenta, con elecciones distintas, son dos `PromoCuenta`
/// separadas, cada una con sus propios `CuentaItem.promoCuentaId`. FK RESTRICT a `PromoCarta`: no se borra mientras haya
/// alguna instancia vendida con ella (`PromoCarta` de por sí nunca se borra, se apaga). Sin `cerradaEn`/estado propio: el
/// estado de una promo se deriva de sus `CuentaItem` y de las `Operacion` que enlazan, igual que el resto del POS.
model PromoCuenta {
  id           String       @id @default(cuid())
  empresaId    String       @default(dbgenerated("app_empresa_actual()"))
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  cuentaId     String
  cuenta       Cuenta       @relation(fields: [empresaId, cuentaId], references: [empresaId, id])
  promoCartaId String
  promoCarta   PromoCarta   @relation(fields: [empresaId, promoCartaId], references: [empresaId, id])
  /// Precio CONGELADO al agregarla (`PromoCarta.precio` en ese momento) — lo que se prorratea entre los componentes (D3).
  precio       Decimal      @db.Decimal(14, 2)
  /// Snapshot del título en ese momento — el ticket ("1 × Menú del día") usa este, no el actual de `PromoCarta` (que puede
  /// haber cambiado de nombre después).
  titulo       String
  creadoPorId  String
  creadoPor    User         @relation(fields: [creadoPorId], references: [id])
  creadoEn     DateTime     @default(now())
  items        CuentaItem[]
  operaciones  Operacion[]

  @@unique([empresaId, id])
  @@index([cuentaId])
}

model CuentaItem {
  id              String       @id @default(cuid())
  empresaId       String       @default(dbgenerated("app_empresa_actual()"))
  empresa         Empresa      @relation(fields: [empresaId], references: [id])
  cuentaId        String
  cuenta          Cuenta       @relation(fields: [empresaId, cuentaId], references: [empresaId, id])
  productoId      String
  producto        Producto     @relation(fields: [empresaId, productoId], references: [empresaId, id])
  /// Mismo tipo que MovimientoStock.cantidad: desemboca en la venta al cerrar la cuenta. Negativa SOLO en una fila espejo (anulación).
  cantidad        Decimal      @db.Decimal(14, 4)
  /// Precio CONGELADO al agregar el ítem (Precio Local o global de ese momento, prorrateado si es un componente de promo, D3);
  /// es el que se cobra al cerrar la cuenta (antes del descuento de cliente, D2 — ese se aplica recién ahí, no acá).
  precioUnitario  Decimal      @db.Decimal(14, 2)
  /// null = sin enviar a cocina (borrador); 1..n = en qué envío salió (KOT derivado, ver el bloque de arriba).
  numeroEnvio     Int?
  creadoEn        DateTime     @default(now())
  /// Quién cargó el ítem (o quién anuló, en una fila espejo). Null en filas anteriores a «tomar pedido».
  creadoPorId     String?
  creadoPor       User?        @relation("CuentaItemCreadoPor", fields: [creadoPorId], references: [id])
  /// No nulo = esta fila es un ESPEJO que anula (parcial o totalmente) al ítem original indicado. RESTRICT: el original no se borra.
  anulaAItemId    String?
  anulaAItem      CuentaItem?  @relation("CuentaItemAnulacion", fields: [empresaId, anulaAItemId], references: [empresaId, id], onDelete: Restrict)
  anulaciones     CuentaItem[] @relation("CuentaItemAnulacion")
  /// Obligatorio en una fila espejo (validado en la aplicación).
  motivoAnulacion String?
  /// La Operacion VENTA que registró este ítem al cerrar la cuenta (una por línea neta producto+precio+promo). RESTRICT: no se borra.
  operacionId     String?
  operacion       Operacion?   @relation(fields: [empresaId, operacionId], references: [empresaId, id], onDelete: Restrict)

  /// Task #16 (docs/plan-promo-combo-2026-09-26.md): la `PromoCuenta` de la que este ítem es un COMPONENTE — null = un
  /// suelto de siempre. FK RESTRICT: no se borra mientras algún componente siga apuntándola. Junto con `precioUnitario` (y
  /// `operacionId`), forma la clave que evita mezclar un suelto con un componente del mismo producto al mismo precio
  /// (`lineasDeVenta`, D4).
  promoCuentaId       String?
  promoCuenta         PromoCuenta? @relation(fields: [empresaId, promoCuentaId], references: [empresaId, id])
  /// Precio de LISTA de UNA unidad, congelado al agregarla — con dos significados según la fila:
  ///  - componente de una promo (`promoCuentaId` puesto): el precio A LA CARTA antes de prorratear; sirve para comparar "lo que se cobró prorrateado"
  ///    contra "lo que costaría pedirlo suelto" (paso 12, margen de promos);
  ///  - suelto con descuento de producto (`DescuentoProductoSucursal`): el precio vigente ANTES del descuento (`precioUnitario` ya es el descontado);
  ///    null en un suelto sin descuento. Mide el ahorro del cliente (reporte «Descuentos de productos»).
  /// Queda congelado igual que `precioUnitario`: si el precio de carta del producto cambia después, esta fila no se entera.
  precioCartaUnitario Decimal?     @db.Decimal(14, 2)

  /// GO-1 (el «elemento configurable»): la HUELLA de las opciones que van DENTRO del precio de esta línea (SHA-256 hexadecimal de 64 caracteres, CHECK; `huellaDeOpciones`, `src/core/opciones/huella-de-opciones.ts`). NULL = una línea sin opciones (todas las
  /// de hoy) y toda línea ADICIONAL (un adicional no lleva huella). Inmutable una vez escrita (disparador `CuentaItem_opciones_chk`). Dos líneas del mismo producto con distinta huella son líneas distintas.
  huellaOpciones      String?
  /// GO-1: la línea PADRE de un ADICIONAL (otra línea de la MISMA cuenta, que no es adicional ni espejo: un solo nivel). NULL en toda línea que no es un adicional. RESTRICT: no se borra un padre con adicionales colgados. Inmutable (disparador). Un adicional no lleva promo,
  /// ni precio de carta, ni huella, y su `precioUnitario` es de 0,01 o más (CHECK `CuentaItem_adicional_chk`).
  lineaPadreId        String?
  lineaPadre          CuentaItem?  @relation("CuentaItemLineaPadre", fields: [empresaId, lineaPadreId], references: [empresaId, id], onDelete: Restrict)
  adicionales         CuentaItem[] @relation("CuentaItemLineaPadre")
  /// GO-1: la foto de las opciones elegidas en esta línea (se borra con el borrador: ON DELETE CASCADE).
  opcionesElegidas    OpcionElegidaEnLinea[]
  /// GO-3: la foto de la combinación vendida (a lo sumo una: único por `cuentaItemId`; se borra con el borrador).
  combinacionEnLinea  CombinacionEnLinea[]

  @@unique([empresaId, id])
  @@index([cuentaId])
  @@index([anulaAItemId])
  @@index([operacionId])
  @@index([promoCuentaId])
  @@index([lineaPadreId])
}

/// Ejemplar IMPRESO del ticket de cierre (control interno de comandas / guest check control; NO comprobante fiscal).
/// numero: secuencial por sucursal, sin huecos (max+1 en la tx serializable de cerrarCuenta). ejemplar: 1 = A (original), 2 = B…
/// Corrección = fila NUEVA (mismo numero, ejemplar siguiente, corrigeAId → el ejemplar A, motivo); nunca se edita ni se borra.
model EjemplarTicket {
  id           String           @id @default(cuid())
  empresaId    String           @default(dbgenerated("app_empresa_actual()"))
  empresa      Empresa          @relation(fields: [empresaId], references: [id])
  sucursalId   String
  sucursal     Sucursal         @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  cuentaId     String
  cuenta       Cuenta           @relation(fields: [empresaId, cuentaId], references: [empresaId, id])
  numero       Int
  ejemplar     Int              @default(1)
  emitidoEn    DateTime         @default(now())
  emitidoPorId String
  emitidoPor   User             @relation("EjemplarTicketEmitidoPor", fields: [emitidoPorId], references: [id])
  corrigeAId   String?
  corrigeA     EjemplarTicket?  @relation("EjemplarTicketCorreccion", fields: [empresaId, corrigeAId], references: [empresaId, id], onDelete: Restrict)
  correcciones EjemplarTicket[] @relation("EjemplarTicketCorreccion")
  motivo       String?

  @@unique([sucursalId, numero, ejemplar])
  @@unique([cuentaId, ejemplar])
  @@unique([empresaId, id])
  @@index([corrigeAId])
}

// ===================================================================
// PLATAFORMA (Fase F) — Empresa y su pertenencia de usuarios. `Empresa` sin RLS por empresa; `UsuarioEmpresa` con RLS propia.
// ===================================================================

enum EstadoEmpresa {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETING
}

model Empresa {
  id                String        @id @default(cuid())
  nombre            String        @unique
  slug              String        @unique
  cuit              String?       @unique
  zonaHoraria       String
  moneda            String
  estado            EstadoEmpresa @default(PROVISIONING)
  creadoEn          DateTime      @default(now())
  /// Política de plataforma (ADR-008/ADR-010): solo la cambia la plataforma (scripts/politica-empresa.ts), nunca la propia empresa.
  permisosEditables Boolean       @default(true)
  dosPaneles        Boolean       @default(true)
  /// M0-IVA: condición de la empresa frente al IVA. Código semántico de lista cerrada (`CONDICIONES_IVA` en src/core/fiscal/iva.ts), con el CHECK
  /// "Empresa_condicionIva_check" que agrega la migración a mano (Prisma no declara CHECK). NULL = «no declarada»: quien la lea falla cerrado, nunca supone
  /// Responsable Inscripto. La carga la plataforma (paso de datos auditado), no la propia empresa.
  condicionIva      String?
  /// Paquete 3 (M3d, ADR-029): la PERILLA de IVA de las compras. Apagada (el valor de toda empresa hoy): la factura de proveedor NO exige neto, IVA ni alícuota, todo se carga con IVA incluido. Prendida: se exigen
  /// según la letra y alimentan el IVA computable (lo hace el servidor, Etapa C: la base no lee `Empresa` desde un CHECK). La carga la plataforma, nunca la propia empresa (igual que `condicionIva`). Las ventas no dependen de ella.
  llevaIvaDeCompras Boolean       @default(false)

  usuarios                       UsuarioEmpresa[]
  sucursalRel                    Sucursal[]
  rolRel                         Rol[]
  usuarioSucursalRel             UsuarioSucursal[]
  permisoRolRel                  PermisoRol[]
  capacidadSucursalRel           CapacidadSucursal[]
  registroAuditoriaRel           RegistroAuditoria[]
  productoRel                    Producto[]
  disponibilidadProductoRel      DisponibilidadProducto[]
  insumoRel                      Insumo[]
  grupoRel                       Grupo[]
  categoriaProductoRel           CategoriaProducto[]
  margenObjetivoRel              MargenObjetivo[]
  unidadRel                      Unidad[]
  presentacionRel                Presentacion[]
  proveedorRel                   Proveedor[]
  pagoConsignanteRel             PagoConsignante[]
  proveedorPorProductoRel        ProveedorPorProducto[]
  clienteRel                     Cliente[]
  recetaVersionRel               RecetaVersion[]
  recetaSucursalRel              RecetaSucursal[]
  recetaIngredienteRel           RecetaIngrediente[]
  sustitutoRecetaIngredienteRel  SustitutoRecetaIngrediente[]
  recetaPasoRel                  RecetaPaso[]
  recetaPasoIngredienteRel       RecetaPasoIngrediente[]
  motivoMermaRel                 MotivoMerma[]
  destinoConsumoRel              DestinoConsumo[]
  seccionRel                     Seccion[]
  operacionRel                   Operacion[]
  movimientoStockRel             MovimientoStock[]
  conteoFisicoRel                ConteoFisico[]
  precioLocalProductoRel         PrecioLocalProducto[]
  rendimientoLocalIngredienteRel RendimientoLocalIngrediente[]
  frecuenciaConteoProductoRel    FrecuenciaConteoProducto[]
  stockMinimoProductoRel         StockMinimoProducto[]
  seccionHabitualProductoRel     SeccionHabitualProducto[]
  traspasoSucursalRel            TraspasoSucursal[]
  seccionCartaRel                SeccionCarta[]
  contenidoCartaProductoRel      ContenidoCartaProducto[]
  itemAgrupadoCartaRel           ItemAgrupadoCarta[]
  generoCartaRel                 GeneroCarta[]
  opcionItemAgrupadoCartaRel     OpcionItemAgrupadoCarta[]
  promoCartaRel                  PromoCarta[]
  promoCartaSucursalRel          PromoCartaSucursal[]
  descuentoProductoSucursalRel   DescuentoProductoSucursal[]
  promoCartaCupoRel              PromoCartaCupo[]
  sucursalPublicaRel             SucursalPublica[]
  temaCartaSucursalRel           TemaCartaSucursal[]
  portalCartaRel                 PortalCartaEmpresa?
  mesaRel                        Mesa[]
  cuentaRel                      Cuenta[]
  promoCuentaRel                 PromoCuenta[]
  cuentaItemRel                  CuentaItem[]
  ejemplarTicketRel              EjemplarTicket[]
  moduloEmpresaRel               ModuloEmpresa[]
  invitacionRel                  Invitacion[]
  invitacionSucursalRel          InvitacionSucursal[]
  agregadoDeCuentas              AgregadoDeCuenta[]
  ventaRel                       Venta[]
  facturaProveedorRel            FacturaProveedor[]
  facturaProveedorRenglonRel     FacturaProveedorRenglon[]
  facturaProveedorSucursalRel    FacturaProveedorSucursal[]
  facturaProveedorTributoRel     FacturaProveedorTributo[]
  puntoDeVentaDeProveedorRel     PuntoDeVentaDeProveedor[]
  conceptoDeGastoRel             ConceptoDeGasto[]
  imputacionDeGastoRel           ImputacionDeGasto[]
  reclasificacionRenglonRel      ReclasificacionRenglon[]
  notaCreditoProveedorRel        NotaCreditoProveedor[]
  notaCreditoProveedorLineaRel   NotaCreditoProveedorLinea[]
  notaCreditoProveedorImputacionRel NotaCreditoProveedorImputacion[]
  notaCreditoProveedorTributoRel NotaCreditoProveedorTributo[]
  planDeCostosRel                PlanDeCostos[]
  centroDeCostosRel              CentroDeCostos[]
  planDeCostosSucursalRel        PlanDeCostosSucursal[]
  distribucionCostoVersionRel    DistribucionCostoVersion[]
  distribucionCostoLineaRel      DistribucionCostoLinea[]
  grupoDeOpcionesRel             GrupoDeOpciones[]
  opcionDeGrupoRel               OpcionDeGrupo[]
  versionDeOpcionRel             VersionDeOpcion[]
  consumoDeOpcionRel             ConsumoDeOpcion[]
  productoAdmiteGrupoRel         ProductoAdmiteGrupo[]
  productoAdmiteOpcionRel        ProductoAdmiteOpcion[]
  precioLocalDeOpcionRel         PrecioLocalDeOpcion[]
  opcionApagadaEnSucursalRel     OpcionApagadaEnSucursal[]
  opcionElegidaEnLineaRel        OpcionElegidaEnLinea[]
  entradaDeCupoRel               EntradaDeCupo[]
  opcionDeEntradaDeCupoRel       OpcionDeEntradaDeCupo[]
  entradaDelDiaDeCupoRel         EntradaDelDiaDeCupo[]
  grupoDePrecioRel               GrupoDePrecio[]
  combinacionDeProductoRel       CombinacionDeProducto[]
  precioLocalDeCombinacionRel    PrecioLocalDeCombinacion[]
  recetaDeCombinacionVersionRel  RecetaDeCombinacionVersion[]
  recetaDeCombinacionIngredienteRel RecetaDeCombinacionIngrediente[]
  combinacionEnLineaRel          CombinacionEnLinea[]
}

enum EstadoModulo {
  ACTIVO
  INACTIVO
}

/// Registro de módulos vendibles por empresa (ADR-011, ADR-014, ADR-015). Qué módulos existen y sus dependencias es CÓDIGO (`src/core/modulos`); acá solo se
/// guarda cuáles tiene cada empresa. Los módulos fijo y de soporte NO tienen fila (se calculan). `modulo` es TEXT validado en código a propósito: agregar un
/// módulo al catálogo no requiere migración. Sin default de `empresaId` (a diferencia de las tablas de operación): quien escribe es la plataforma, siempre
/// indicando la empresa. RLS: la app lee solo su empresa; escribe únicamente `motor2_plataforma` (política + REVOKE a motor2_app + trigger), a mano en la migración.
model ModuloEmpresa {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id])
  modulo        String
  estado        EstadoModulo @default(ACTIVO)
  actualizadoEn DateTime     @default(now()) @updatedAt

  @@unique([empresaId, modulo])
}

enum EstadoInvitacion {
  PENDIENTE
  ACEPTADA
  REVOCADA
}

/// Invitación del primer gerente de una empresa en alta (E5, ADR-012 §6, ADR-020). Guarda SOLO el hash SHA-256 del token (el enlace de un solo uso viaja por mail).
/// «Vencida» no es un estado guardado: es una PENDIENTE con `venceEn` pasado. Sin default de `empresaId`: la crea la plataforma, siempre indicando la empresa.
/// RLS (a mano en la migración): `aislamiento_empresa`; `lectura_por_token` (la app, sin empresa todavía, lee por `app.invitacion_hash`); `escritura_plataforma`.
/// Privilegios: la app solo lee y actualiza las columnas de la aceptación; `motor2_plataforma` crea, reenvía y revoca (sin DELETE). Un trigger impone la máquina de
/// estados por rol. Índices únicos parciales a mano: una PENDIENTE por (empresa, email) y una PENDIENTE de gerente por empresa.
model Invitacion {
  id            String               @id @default(cuid())
  empresaId     String
  empresa       Empresa              @relation(fields: [empresaId], references: [id])
  email         String
  rolEmpresa    String
  hashToken     String               @unique
  estado        EstadoInvitacion     @default(PENDIENTE)
  venceEn       DateTime
  creadaEn      DateTime             @default(now())
  enviadaEn     DateTime?
  aceptadaEn    DateTime?
  aceptadaPorId String?
  aceptadaPor   User?                @relation("InvitacionAceptadaPor", fields: [aceptadaPorId], references: [id], onDelete: Restrict)
  cuitDeclarado String?
  revocadaEn    DateTime?
  /// Quién creó o reenvió la invitación (obligatorio en `usuario` y `vinculacion`, NULL en `gerente`; E8, ADR-024).
  invitadoPorId String?
  invitadoPor   User?                @relation("InvitacionInvitadoPor", fields: [invitadoPorId], references: [id], onDelete: Restrict)
  sucursales    InvitacionSucursal[]

  @@unique([empresaId, id])
  @@index([empresaId, creadaEn])
}

/// Las sucursales y el rol en cada una que da una invitación de tipo `usuario` (E8, ADR-024): una fila por sucursal. Las membresías NO existen hasta que la persona
/// acepta; al aceptar se revalida el permiso de `invitadoPorId` (quien otorgó ESA sucursal). Las claves foráneas compuestas garantizan que invitación, sucursal y rol son de
/// la misma empresa. RLS `aislamiento_empresa`; la app inserta y actualiza algunas columnas, sin DELETE; un trigger exige que la invitación madre sea una `usuario` PENDIENTE.
model InvitacionSucursal {
  id            String     @id @default(cuid())
  empresaId     String     @default(dbgenerated("app_empresa_actual()"))
  empresa       Empresa    @relation(fields: [empresaId], references: [id])
  invitacionId  String
  invitacion    Invitacion @relation(fields: [empresaId, invitacionId], references: [empresaId, id])
  sucursalId    String
  sucursal      Sucursal   @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  rolId         String
  rol           Rol        @relation(fields: [empresaId, rolId], references: [empresaId, id])
  notas         String?
  /// Quien otorgó ESTA sucursal con ESTE rol: su permiso se revalida al aceptar.
  invitadoPorId String
  invitadoPor   User       @relation(fields: [invitadoPorId], references: [id], onDelete: Restrict)
  creadaEn      DateTime   @default(now())

  @@unique([invitacionId, sucursalId])
}

/// Comprobante de UN "agregar al pedido" del salón (P3, I3): la clave de idempotencia que manda la pantalla, la huella del pedido y el mensaje que se devolvió. SOLO se agrega
/// (la app tiene SELECT e INSERT, nunca UPDATE ni DELETE) y vive aparte de `CuentaItem`: quitar un ítem borra filas, y la clave no puede irse con ellas (un reintento volvería a
/// agregar lo que quedó). Un reintento con la misma clave y la misma huella devuelve el mensaje guardado sin escribir nada; con otra huella, el conflicto. Por sucursal: hereda de `Cuenta`.
model AgregadoDeCuenta {
  id                String   @id @default(cuid())
  empresaId         String   @default(dbgenerated("app_empresa_actual()"))
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  cuentaId          String
  cuenta            Cuenta   @relation(fields: [empresaId, cuentaId], references: [empresaId, id])
  /// UUID que genera la pantalla. Único GLOBAL, igual que `Operacion`, `ConteoFisico` y `PagoConsignante` (ADR-028).
  claveIdempotencia String   @unique
  payloadHash       String
  resultadoMensaje  String
  creadoPorId       String
  creadoPor         User     @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn          DateTime @default(now())

  @@unique([empresaId, id])
  @@index([cuentaId])
}

/// De dónde salió una venta: una mesa (la cuenta del salón que se cierra) o el mostrador (`registrarVenta`).
enum CanalDeVenta {
  MESA
  MOSTRADOR
}

/// M2 (Paquete 2): la CABECERA de una venta. Agrupa las `Operacion` VENTA de una misma venta (hoy hay una por línea, sin nada que las una). Es una cabecera y NO la fuente de la plata:
/// la plata de las ventas sigue saliendo del Kardex (`MovimientoStock`); `importeTotal` es una COPIA del total cobrado al confirmar, que nunca se modifica (el total vigente de una venta
/// con unidades anuladas se calcula de sus líneas). Se llama `canal` y no `origen` porque `origen` ya es, en `registrarVentaEnTx`, la sección de la que sale el stock.
/// SOLO se agrega (la app tiene SELECT e INSERT, nunca UPDATE ni DELETE) y no tiene `anuladaEn`: el estado de una venta se calcula de sus operaciones. Una mesa tiene a lo sumo UNA cabecera
/// (`@@unique([empresaId, cuentaId])`: la idempotencia natural del cierre de la cuenta). NO lleva clave de idempotencia propia (la del mostrador sigue en su primera `Operacion`, en la misma
/// transacción), ni `clienteId` (ya está en `Operacion`). Por sucursal: `PROPIA`. Nada de `src/` la escribe todavía (Etapa C).
model Venta {
  id           String       @id @default(cuid())
  empresaId    String       @default(dbgenerated("app_empresa_actual()"))
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  sucursalId   String
  sucursal     Sucursal     @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  canal        CanalDeVenta
  /// La cuenta del salón que se cerró (solo MESA; CHECK: `canal = MESA` si y solo si hay cuenta).
  cuentaId     String?
  cuenta       Cuenta?      @relation(fields: [empresaId, cuentaId], references: [empresaId, id])
  /// El instante de la venta (UTC; se muestra en la zona de la empresa).
  fecha        DateTime
  /// COPIA del total cobrado (la suma de `importeDeLinea` de sus líneas al confirmar). Nunca se modifica ni es la fuente de un reporte. No negativo (CHECK).
  importeTotal Decimal      @db.Decimal(14, 2)
  usuarioId    String
  usuario      User         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  creadoEn     DateTime     @default(now())

  /// Las líneas de la venta (una `Operacion` VENTA por línea).
  operaciones Operacion[]

  @@unique([empresaId, id])
  @@unique([empresaId, cuentaId])
  @@index([sucursalId, fecha])
}

/// Paquete 3 (M3b, ADR-029): la FACTURA DE PROVEEDOR como documento de la EMPRESA (quien paga es la empresa). Una factura se carga entera y se reparte entre sucursales; cada parte es una `Operacion` COMPRA por línea y por
/// sucursal (vínculo: `FacturaProveedorSucursal.operacionId`). No tiene sucursal: es `DE_EMPRESA` (RLS por empresa) para que cada sucursal vea la cabecera de su parte. SOLO se agrega: la app tiene SELECT e INSERT, nunca
/// DELETE, y el UPDATE es POR COLUMNA (el estado, la anulación y una lista cerrada de datos que identifican la factura); el dinero (`importeTotal`, los renglones) no tiene UPDATE: un error se anula y se vuelve a cargar, o
/// va una nota de crédito. Por eso NO lleva `@updatedAt`. Los CHECK, el índice único parcial de la unicidad del número (`FacturaProveedor_unica_vigente_key`) y los privilegios por columna los agrega la migración a mano
/// (Prisma no los modela). Nada de `src/` la escribe todavía (Etapa C).
model FacturaProveedor {
  id          String    @id @default(cuid())
  empresaId   String    @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  proveedorId String
  proveedor   Proveedor @relation(fields: [empresaId, proveedorId], references: [empresaId, id])

  /// El número tal cual se tecleó, y su clave normalizada (la calcula la Etapa C): van juntos (CHECK). La unicidad vigente es `(empresaId, proveedorId, letra o '', nroFacturaNormalizado)` de las NO anuladas,
  /// con un índice único parcial que vive solo en la migración. Una pendiente de reparto también reserva su número.
  nroFactura            String?
  nroFacturaNormalizado String?
  /// La letra del comprobante (A, B, C, E, M o X), cuando se conoce: entra en la clave de unicidad (D5).
  letra                 String?
  /// El día del stock y del costo: el mediodía argentino del día que eligió quien cargó (UTC).
  fecha                 DateTime
  /// La fecha impresa en el comprobante (solo dato).
  fechaComprobante      DateTime? @db.Date
  /// El total de la factura, CON IVA incluido. No negativo (CHECK). Nunca se modifica.
  importeTotal          Decimal   @db.Decimal(14, 2)

  /// M3d: la condición de la empresa frente al IVA al momento de la carga (copia de `Empresa.condicionIva`; `CONDICIONES_IVA` de src/core/fiscal/iva.ts, CHECK en la base). NULL = no se declaró.
  condicionIvaEmpresa        String?
  /// M3d: neto e IVA del comprobante (NULL = no se desglosó; van juntos, CHECK). El resto del total son tributos, no gravado y exento. Sin CHECK de obligatoriedad: la exigencia según la perilla y la letra es del servidor.
  importeNeto                Decimal?  @db.Decimal(14, 2)
  importeIva                 Decimal?  @db.Decimal(14, 2)
  /// `PENDIENTE_DE_REPARTO` (cargada, sin repartir: su mercadería todavía no entró al stock) o `CONFIRMADA`. CHECK en la base.
  estado                     String    @default("CONFIRMADA")
  confirmadaEn               DateTime?
  confirmadaPorId            String?
  confirmadaPor              User?     @relation("FacturaProveedorConfirmadaPor", fields: [confirmadaPorId], references: [id], onDelete: Restrict)
  /// `CARGA` (la cargó una persona) o `MIGRACION` (la creó un relleno). Solo `CARGA` puede quedar pendiente.
  origen                     String    @default("CARGA")
  /// Hoy solo `CONTADO_PAGADA` (CHECK).
  condicionPago              String    @default("CONTADO_PAGADA")
  recibidaEnAdministracionEn DateTime? @db.Date
  fechaPagoDeclarada         DateTime? @db.Date
  medioPagoDeclarado         String?
  detalleLibre               String?
  /// UUID que genera la pantalla. Único GLOBAL, igual que `Operacion`, `ConteoFisico` y `PagoConsignante` (ADR-028). Va junto con la huella (CHECK).
  claveIdempotencia          String?   @unique
  payloadHash                String?
  resultadoMensaje           String?
  creadoPorId                String
  creadoPor                  User      @relation("FacturaProveedorCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn                   DateTime  @default(now())
  anuladaEn                  DateTime?
  anuladaPorId               String?
  anuladaPor                 User?     @relation("FacturaProveedorAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)

  renglones FacturaProveedorRenglon[]
  partes    FacturaProveedorSucursal[]
  /// M3d: percepciones e impuestos que trae la factura además del IVA.
  tributos  FacturaProveedorTributo[]
  /// M6: las notas de crédito del proveedor que se cargaron sobre esta factura (vigentes y anuladas).
  notasDeCredito NotaCreditoProveedor[]

  @@unique([empresaId, id])
  /// M6: el destino de la clave foránea de tres columnas de la nota de crédito: la nota es del MISMO proveedor que su factura, y corregir el proveedor de una factura con notas lo rechaza la base (23503).
  @@unique([empresaId, id, proveedorId])
  @@index([empresaId, proveedorId, fecha])
}

/// Paquete 3 (M3b, ampliado por M4.2): un renglón de la factura (lo comprado o pagado). De empresa; solo se agrega. La naturaleza es `MERCADERIA` (producto, cantidad y precio por unidad de stock) o `SIN_STOCK` (un gasto: concepto de gasto y tipo de
/// costo, sin producto; NUNCA genera `Operacion` ni Kardex), en pareo (CHECK `FacturaProveedorRenglon_pareo_naturaleza_chk`; la lista, en `FacturaProveedorRenglon_naturaleza_chk`). El precio por unidad se calcula UNA vez y se copia igual a cada parte.
/// `precioTotal` es CON IVA incluido (mayor que cero en un renglón sin stock).
model FacturaProveedorRenglon {
  id                   String           @id @default(cuid())
  empresaId            String           @default(dbgenerated("app_empresa_actual()"))
  empresa              Empresa          @relation(fields: [empresaId], references: [id])
  facturaProveedorId   String
  facturaProveedor     FacturaProveedor @relation(fields: [empresaId, facturaProveedorId], references: [empresaId, id])
  /// La posición en la factura (desde 1; única por factura).
  orden                Int
  naturaleza           String           @default("MERCADERIA")
  descripcion          String?
  productoId           String?
  producto             Producto?        @relation(fields: [empresaId, productoId], references: [empresaId, id])
  /// En unidad de STOCK del producto.
  cantidadStock        Decimal?         @db.Decimal(14, 4)
  precioPorUnidadStock Decimal?         @db.Decimal(14, 4)
  loteVencimiento      DateTime?        @db.Date
  /// El texto de conversión de unidad que se copia a cada movimiento (`MovimientoStock.detalle`).
  detalle              String?
  /// Lo pagado por el renglón, CON IVA incluido. No negativo (CHECK).
  precioTotal          Decimal          @db.Decimal(14, 2)
  /// M3d: la alícuota de IVA del renglón (`ALICUOTAS_IVA` de src/core/fiscal/iva.ts, CHECK en la base), el neto y el IVA (NULL = no se desglosó; van juntos y neto + IVA = `precioTotal` EXACTO, CHECK) y el IVA computable
  /// (NOT NULL, 0 con la perilla apagada o sin IVA discriminado; entre 0 y el IVA, CHECK). Sin CHECK de obligatoriedad: la exigencia según la perilla de la empresa y la letra es del servidor (Etapa C).
  alicuotaIva          String?
  importeNeto          Decimal?         @db.Decimal(14, 2)
  importeIva           Decimal?         @db.Decimal(14, 2)
  importeIvaComputable Decimal          @default(0) @db.Decimal(14, 2)
  creadoEn             DateTime         @default(now())
  /// M4.2: solo en un renglón `SIN_STOCK` (CHECK de pareo): el concepto de gasto y la COPIA de su tipo de costo (COSTO_DE_VENTAS, GASTO_OPERATIVO, EXTRAORDINARIO, INVERSION o RESULTADO_FINANCIERO; CHECK).
  conceptoGastoId      String?
  conceptoGasto        ConceptoDeGasto? @relation(fields: [empresaId, conceptoGastoId], references: [empresaId, id])
  tipoDeCosto          String?

  /// Las líneas del Kardex que salieron de este renglón (una por parte).
  movimientos MovimientoStock[]
  /// M4.3: cuánto de este renglón (si es `SIN_STOCK`) le toca a cada sucursal.
  imputaciones ImputacionDeGasto[]
  /// M5: las reclasificaciones (versiones) del concepto y del tipo de costo de este renglón. La versión 0 es el propio renglón.
  reclasificaciones ReclasificacionRenglon[]
  /// M6: las líneas de nota de crédito que acreditan este renglón (pertenencia a su factura y naturaleza).
  lineasDeNotaCredito NotaCreditoProveedorLinea[] @relation("LineaDeNotaDelRenglon")
  lineasDeNotaCreditoPorNaturaleza NotaCreditoProveedorLinea[] @relation("LineaDeNotaPorNaturaleza")

  @@unique([empresaId, id])
  /// M6: el destino de la clave foránea de pertenencia de la línea de nota de crédito: la línea acredita un renglón de LA factura de su nota.
  @@unique([empresaId, facturaProveedorId, id])
  @@unique([facturaProveedorId, orden])
  /// M4.2: el destino de la clave foránea con discriminador de la imputación (M4.3): solo un renglón `SIN_STOCK` se puede imputar.
  @@unique([empresaId, id, naturaleza])
  @@index([conceptoGastoId])
}

/// Paquete 3 (M3b): la parte de cada sucursal en una factura repartida (`PROPIA`: tiene `sucursalId`; las políticas de alcance las agrega M3c). Solo se agrega. `porcentajeDeclaradoBp` es la INTENCIÓN de quien cargó
/// (10000 = 100 %) y NUNCA se usa para atribuir dinero: la atribución sale del dinero de cada parte. `operacionId` es la `Operacion` COMPRA de esta parte (única; vacío en las partes que son solo gastos, M4).
model FacturaProveedorSucursal {
  id                    String           @id @default(cuid())
  empresaId             String           @default(dbgenerated("app_empresa_actual()"))
  empresa               Empresa          @relation(fields: [empresaId], references: [id])
  facturaProveedorId    String
  facturaProveedor      FacturaProveedor @relation(fields: [empresaId, facturaProveedorId], references: [empresaId, id])
  sucursalId            String
  sucursal              Sucursal         @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  porcentajeDeclaradoBp Int
  operacionId           String?
  operacion             Operacion?       @relation(fields: [empresaId, operacionId], references: [empresaId, id], onDelete: Restrict)
  /// Recepción de la mercadería (cambio del dueño, 2026-10-12): el stock de una factura entra recién cuando la factura está REPARTIDA y la parte de esta sucursal RECIBIDA. `PENDIENTE` o `RECIBIDA` (CHECK); `recibidaEn` es la FECHA DE STOCK
  /// elegida (UTC) y `recibidaPorId` quién la confirmó. UPDATE solo por columna sobre estas tres y un disparador que permite únicamente PENDIENTE a RECIBIDA (migración 20261016101500). Nada de `src/` las escribe todavía (Etapa C).
  estadoRecepcion       String           @default("PENDIENTE")
  recibidaEn            DateTime?
  recibidaPorId         String?
  recibidaPor           User?            @relation("FacturaProveedorParteRecibidaPor", fields: [recibidaPorId], references: [id], onDelete: Restrict)
  creadoEn              DateTime         @default(now())

  @@unique([empresaId, id])
  @@unique([facturaProveedorId, sucursalId])
  @@unique([empresaId, operacionId])
  @@index([sucursalId])
}

/// Paquete 3 (M3d): un tributo de la factura (percepción o impuesto que trae además del IVA). Cuelga de la cabecera, es DE EMPRESA y solo se agrega (la app tiene SELECT e INSERT). `tipo` es de lista cerrada y `importe` mayor
/// que cero (CHECK en la base). Nada de `src/` la escribe todavía (Etapa C).
model FacturaProveedorTributo {
  id                 String           @id @default(cuid())
  empresaId          String           @default(dbgenerated("app_empresa_actual()"))
  empresa            Empresa          @relation(fields: [empresaId], references: [id])
  facturaProveedorId String
  facturaProveedor   FacturaProveedor @relation(fields: [empresaId, facturaProveedorId], references: [empresaId, id])
  tipo               String
  descripcion        String?
  importe            Decimal          @db.Decimal(14, 2)
  creadoEn           DateTime         @default(now())

  @@unique([empresaId, id])
  @@index([facturaProveedorId])
}

/// Paquete 3 (M3e, C36): un punto de venta (los cinco dígitos del N.º de comprobante) con el que un proveedor factura. DE EMPRESA. `numero` de 1 a 99999 (CHECK), único por proveedor. No se borra nunca: `motor2_app` tiene SELECT, INSERT y UPDATE
/// solo de `activo` (se apaga). Nada de `src/` lo escribe todavía (Etapa C).
model PuntoDeVentaDeProveedor {
  id          String    @id @default(cuid())
  empresaId   String    @default(dbgenerated("app_empresa_actual()"))
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  proveedorId String
  proveedor   Proveedor @relation(fields: [empresaId, proveedorId], references: [empresaId, id])
  numero      Int
  activo      Boolean   @default(true)
  creadoEn    DateTime  @default(now())

  @@unique([empresaId, id])
  @@unique([proveedorId, numero])
}

model UsuarioEmpresa {
  id         String   @id @default(cuid())
  usuarioId  String
  usuario    User     @relation(fields: [usuarioId], references: [id])
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  rolEmpresa String?
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now())

  @@unique([usuarioId, empresaId])
}

/// Administrador de la plataforma (ADR-012, ADR-019): identidad APARTE de `User`, sin `empresaId` ni vínculo con ninguna empresa (nunca entra a una). Vive en la
/// base de identidad (zuluhub). Solo la lee y escribe `motor2_plataforma` (política `solo_plataforma` + REVOKE a motor2_app, a mano en la migración). Sin DELETE:
/// un administrador se desactiva (`activo`), no se borra. El primero lo crea `scripts/plataforma/crear-primer-admin.ts`, que además genera el secreto TOTP.
model AdminPlataforma {
  id                    String                           @id @default(cuid())
  /// En minúsculas y sin espacios (CHECK en la base).
  email                 String                           @unique
  nombre                String
  activo                Boolean                          @default(true)
  /// Secreto TOTP cifrado (AES-256-GCM, `core/plataforma/cifrado.ts`), nunca en claro.
  secretoTotp           String
  /// Último paso de 30 s aceptado: un código ya usado no sirve de nuevo (anti-replay).
  ultimoPasoTotp        Int?
  fallosSegundoFactor   Int                              @default(0)
  bloqueadoHasta        DateTime?
  creadoEn              DateTime                         @default(now())
  actualizadoEn         DateTime                         @default(now()) @updatedAt
  codigosDeIngreso      CodigoDeIngresoPlataforma[]
  codigosDeRecuperacion CodigoDeRecuperacionPlataforma[]
  sesiones              SesionPlataforma[]
}

/// Código de un solo uso que se manda por mail (primer factor). Solo se guarda su HMAC (`core/plataforma/codigos.ts`); vence a los 10 minutos, se invalida al
/// usarse o al pedir otro, y se agota a los 5 intentos fallidos.
model CodigoDeIngresoPlataforma {
  id               String          @id @default(cuid())
  adminId          String
  admin            AdminPlataforma @relation(fields: [adminId], references: [id])
  hashCodigo       String
  intentosFallidos Int             @default(0)
  creadoEn         DateTime        @default(now())
  venceEn          DateTime
  usadoEn          DateTime?
  invalidadoEn     DateTime?

  @@index([adminId, creadoEn])
}

/// Códigos de recuperación del segundo factor (se muestran una sola vez, al crear el administrador). Solo se guarda el hash; cada uno sirve una vez.
model CodigoDeRecuperacionPlataforma {
  id         String          @id @default(cuid())
  adminId    String
  admin      AdminPlataforma @relation(fields: [adminId], references: [id])
  hashCodigo String
  creadoEn   DateTime        @default(now())
  usadoEn    DateTime?

  @@unique([adminId, hashCodigo])
}

/// Sesión de la consola. La cookie lleva un token opaco; acá solo su hash. Nace al verificar el código del mail (`segundoFactorEn` NULL: todavía no vale) y
/// vale cuando se verifica el TOTP. Máximo 8 horas de vida y 30 minutos de inactividad (`core/plataforma/sesion.ts`).
model SesionPlataforma {
  id              String          @id @default(cuid())
  adminId         String
  admin           AdminPlataforma @relation(fields: [adminId], references: [id])
  hashToken       String          @unique
  creadaEn        DateTime        @default(now())
  ultimaActividad DateTime        @default(now())
  segundoFactorEn DateTime?
  cerradaEn       DateTime?

  @@index([adminId])
}

/// Auditoría de plataforma (ADR-012 §7, ADR-019): qué hizo un administrador de plataforma y sobre qué empresa. Como el administrador NO es un `User`,
/// `RegistroAuditoria` (cuyo `actorId` apunta a `User`) no puede registrarlo: esta tabla guarda `adminId` y `adminEmail` como texto, sin FK (el administrador
/// vive en la base de identidad; la empresa afectada, en la suya). Existe en todas las bases. Append-only (solo SELECT/INSERT, y el trigger de
/// `rechazar_mutacion_de_auditoria` frena el resto) y sin RLS por empresa: solo la ve `motor2_plataforma`.
model AuditoriaPlataforma {
  id                String   @id @default(cuid())
  adminId           String
  adminEmail        String
  /// Clave de la acción, ej. "ingreso", "cierre-de-sesion", "alta-de-empresa".
  accion            String
  /// Empresa afectada, si la acción es sobre una. NO se llama `empresaId` a propósito: esa columna implica RLS por empresa y `app_empresa_actual()` (sin FK: la fila vive en la base de esa empresa o en la de identidad).
  empresaAfectadaId String?
  detalle           Json?
  creadoEn          DateTime @default(now())

  @@index([adminId, creadoEn])
  @@index([empresaAfectadaId, creadoEn])
}

/// Paquete 3 (M4.1): un CONCEPTO DE GASTO de la empresa (alquiler, luz, honorarios, flete, descuento obtenido...): lo que se paga sin que entre mercadería al stock. Un servicio NO es un producto, es un concepto. DE EMPRESA (RLS por empresa, sin
/// sucursal: el catálogo lo comparten todas). `codigo` es la identidad estable y NO se puede cambiar (la app no tiene UPDATE sobre esa columna); `nombre` es único por empresa sin importar mayúsculas (índice sobre `lower("nombre")` solo en la
/// migración, como los demás catálogos). `tipoDeCostoPorDefecto` es TEXT con CHECK de cinco valores (COSTO_DE_VENTAS, GASTO_OPERATIVO, EXTRAORDINARIO, INVERSION, RESULTADO_FINANCIERO): es solo el valor por defecto de las cargas nuevas; cada renglón guarda su
/// copia. NO se borra (la app no tiene DELETE): se desactiva con `activo`. UPDATE solo de `nombre`, `tipoDeCostoPorDefecto` y `activo`; por eso NO lleva `@updatedAt`. Nada de `src/` la escribe todavía (Etapa C).
model ConceptoDeGasto {
  id                    String   @id @default(cuid())
  empresaId             String   @default(dbgenerated("app_empresa_actual()"))
  empresa               Empresa  @relation(fields: [empresaId], references: [id])
  /// Mayúsculas, dígitos y guion bajo, empieza con letra, hasta 40 (CHECK). Fijo.
  codigo                String
  nombre                String
  tipoDeCostoPorDefecto String
  activo                Boolean  @default(true)
  creadoEn              DateTime @default(now())

  /// Los renglones sin stock que usan este concepto (M4.2).
  renglones FacturaProveedorRenglon[]
  /// M5: las reclasificaciones de renglones que eligieron este concepto.
  reclasificaciones ReclasificacionRenglon[]
  /// M6: las líneas de notas de crédito sueltas de gasto que eligieron este concepto.
  lineasDeNotaCredito NotaCreditoProveedorLinea[]

  @@unique([empresaId, id])
  @@unique([empresaId, codigo])
  @@unique([empresaId, nombre])
}

/// Paquete 3 (M4.3): la IMPUTACIÓN por sucursal de un renglón SIN STOCK: cuánto del importe del gasto le toca a la sucursal y cuánto de eso es IVA computable (D3: se guarda, repartido en dos pasos con `repartirImporte`). `PROPIA`
/// (`sucursalId` NOT NULL; sus políticas de alcance las agrega M4.4). SOLO se agrega: la app tiene SELECT e INSERT, nunca UPDATE ni DELETE; un error se corrige anulando la factura y cargando de nuevo. La clave foránea con DISCRIMINADOR
/// `(empresaId, facturaProveedorRenglonId, naturalezaRenglon) → FacturaProveedorRenglon(empresaId, id, naturaleza)` y `naturalezaRenglon` fijo en `SIN_STOCK` (CHECK) impiden en la base imputar un renglón de mercadería. Una parte por
/// (renglón, sucursal). No tiene fecha propia (el período sale de `FacturaProveedor.fecha`) ni toca `Operacion` ni el Kardex. Que Σ importes = `precioTotal` del renglón y Σ computables = su `importeIvaComputable` lo valida la Etapa C.
model ImputacionDeGasto {
  id                        String                  @id @default(cuid())
  empresaId                 String                  @default(dbgenerated("app_empresa_actual()"))
  empresa                   Empresa                 @relation(fields: [empresaId], references: [id])
  facturaProveedorRenglonId String
  /// Siempre `SIN_STOCK` (CHECK): es la tercera columna de la clave foránea con discriminador.
  naturalezaRenglon         String                  @default("SIN_STOCK")
  renglon                   FacturaProveedorRenglon @relation(fields: [empresaId, facturaProveedorRenglonId, naturalezaRenglon], references: [empresaId, id, naturaleza], onDelete: Restrict, onUpdate: Restrict)
  sucursalId                String
  sucursal                  Sucursal                @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  /// Lo que le toca a la sucursal, CON IVA incluido. Mayor que cero (CHECK).
  importe                   Decimal                 @db.Decimal(14, 2)
  /// La parte de `importe` que es IVA computable (entre 0 y `importe`, CHECK). 0 si no se desglosó IVA.
  importeIvaComputable      Decimal                 @default(0) @db.Decimal(14, 2)
  creadoEn                  DateTime                @default(now())

  /// M7: las versiones de distribución de esta imputación entre los centros de costos de un plan.
  distribuciones DistribucionCostoVersion[]

  @@unique([empresaId, id])
  @@unique([facturaProveedorRenglonId, sucursalId])
  @@index([sucursalId])
}

/// Paquete 4 (M5, C26): la RECLASIFICACIÓN versionada de un renglón SIN STOCK de la factura de proveedor: corrige el concepto de gasto y el tipo de costo (cada versión es la foto completa de los dos). DE EMPRESA (RLS por empresa, sin
/// `sucursalId`: el renglón es uno solo para toda la empresa, y el árbitro de la concurrencia tiene que ver todas las versiones). La versión 0 es el propio renglón (no se escribe fila); cada reclasificación agrega `numero` = vigente + 1; la vigente
/// es SIEMPRE la de `numero` mayor y, si no hay ninguna, el renglón: derivado, nunca un flag ni un UPDATE. SOLO se agrega: la app tiene SELECT e INSERT, nunca UPDATE ni DELETE. La clave foránea con DISCRIMINADOR
/// `(empresaId, facturaProveedorRenglonId, naturalezaRenglon) → FacturaProveedorRenglon(empresaId, id, naturaleza)` y `naturalezaRenglon` fijo en `SIN_STOCK` (CHECK) impiden en la base reclasificar un renglón de mercadería. El único
/// `(renglón, numero)` elige UNA ganadora entre reclasificaciones simultáneas; la clave de idempotencia es única global (ADR-028) y se guarda el mensaje para reproducirlo (I3). No toca importes (no tiene columnas de dinero) y no tiene `@updatedAt`.
/// La `Proceso RECLASIFICACION` del stock es otra cosa. Nada de `src/` la escribe todavía (Etapa C).
model ReclasificacionRenglon {
  id                        String                  @id @default(cuid())
  empresaId                 String                  @default(dbgenerated("app_empresa_actual()"))
  empresa                   Empresa                 @relation(fields: [empresaId], references: [id])
  facturaProveedorRenglonId String
  /// Siempre `SIN_STOCK` (CHECK): es la tercera columna de la clave foránea con discriminador.
  naturalezaRenglon         String                  @default("SIN_STOCK")
  renglon                   FacturaProveedorRenglon @relation(fields: [empresaId, facturaProveedorRenglonId, naturalezaRenglon], references: [empresaId, id, naturaleza], onDelete: Restrict, onUpdate: Restrict)
  /// 1, 2, 3...: único por renglón (CHECK >= 1). La vigente es la de número mayor.
  numero                    Int
  conceptoGastoId           String
  conceptoGasto             ConceptoDeGasto         @relation(fields: [empresaId, conceptoGastoId], references: [empresaId, id])
  /// COSTO_DE_VENTAS, GASTO_OPERATIVO, EXTRAORDINARIO, INVERSION o RESULTADO_FINANCIERO (CHECK).
  tipoDeCosto               String
  /// Obligatorio, con al menos un carácter visible y hasta 200 (CHECK).
  motivo                    String
  /// UUID que genera la pantalla. Único GLOBAL (ADR-028).
  claveIdempotencia         String                  @unique
  payloadHash               String
  resultadoMensaje          String
  creadoPorId               String
  creadoPor                 User                    @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  /// Instante (UTC) desde el que rige la versión; vale para el período original del gasto.
  creadoEn                  DateTime                @default(now())

  @@unique([empresaId, id])
  @@unique([facturaProveedorRenglonId, numero])
  @@index([conceptoGastoId])
}

/// Paquete 4 (M6): la NOTA DE CRÉDITO DE PROVEEDOR (cabecera). DE EMPRESA (RLS por empresa, sin `sucursalId`): quien recibe el crédito es la empresa, igual que la factura; el árbitro de la unicidad del número tiene que ver todas las notas, y la sucursal
/// de una nota suelta la declaran sus imputaciones. `tipo` es `SOBRE_FACTURA` (con `facturaProveedorId`) o `SUELTA` (sin factura), en pareo (CHECK). La clave foránea de TRES columnas `(empresaId, facturaProveedorId, proveedorId) → FacturaProveedor` hace que la nota sea
/// del MISMO proveedor que su factura y que corregir el proveedor de una factura con notas dé 23503. `importeTotal` es CON IVA incluido y mayor que cero. El número es único entre las notas VIGENTES (`anuladaEn IS NULL`): índice único parcial que vive solo en la
/// migración (Prisma no modela el parcial), así una nota anulada libera su número. La clave de idempotencia es única global (ADR-028) y guarda la huella y el mensaje para reproducirlo (I3). Solo se agrega: la app tiene SELECT e INSERT y UPDATE únicamente de `anuladaEn`,
/// `anuladaPorId`, `motivoAnulacion` (las tres juntas, CHECK) y `recibidaEnAdministracionEn`; por eso NO lleva `@updatedAt`. Que Σ líneas + Σ tributos = total y que lo acreditado de un renglón (y de la factura) no pase de lo comprado NO lo decide la base: lo hace el caso de uso
/// con `SELECT … FOR UPDATE` sobre la fila de la factura (sin disparadores; ADR-029 §12). Nada de `src/` la escribe todavía (Etapa C).
model NotaCreditoProveedor {
  id                 String               @id @default(cuid())
  empresaId          String               @default(dbgenerated("app_empresa_actual()"))
  empresa            Empresa              @relation(fields: [empresaId], references: [id])
  proveedorId        String
  proveedor          Proveedor            @relation(fields: [empresaId, proveedorId], references: [empresaId, id])
  /// `SOBRE_FACTURA` o `SUELTA` (CHECK): en pareo con `facturaProveedorId`.
  tipo               String
  facturaProveedorId String?
  facturaProveedor   FacturaProveedor?    @relation(fields: [empresaId, facturaProveedorId, proveedorId], references: [empresaId, id, proveedorId], onDelete: Restrict, onUpdate: Restrict, map: "NotaCreditoProveedor_factura_fkey")
  /// El número tal cual se tecleó y su clave normalizada (la calcula la Etapa C): no vacíos (CHECK).
  nroComprobante            String
  nroComprobanteNormalizado String
  /// La letra del comprobante (A, B, C, E, M o X), cuando se conoce: entra en la clave de unicidad.
  letra                     String?
  /// El día del crédito: el mediodía argentino del día elegido (UTC). Manda el período.
  fecha                     DateTime
  /// La fecha impresa en el comprobante (solo dato).
  fechaComprobante          DateTime?            @db.Date
  /// El total de la nota, CON IVA incluido. Mayor que cero (CHECK).
  importeTotal              Decimal              @db.Decimal(14, 2)
  /// Copia de la condición de la empresa frente al IVA al momento de la carga, neto e IVA del comprobante (NULL = no se desglosó; van juntos, CHECK). Mismas reglas que la factura.
  condicionIvaEmpresa       String?
  importeNeto               Decimal?             @db.Decimal(14, 2)
  importeIva                Decimal?             @db.Decimal(14, 2)
  /// Obligatorio, con al menos un carácter visible y hasta 200 (CHECK).
  motivo                    String
  /// Hoy solo `CONFIRMADA` (CHECK): el camino a un flujo por pasos.
  estado                    String               @default("CONFIRMADA")
  /// Hoy solo `CARGA` (CHECK).
  origen                    String               @default("CARGA")
  recibidaEnAdministracionEn DateTime?           @db.Date
  /// UUID que genera la pantalla. Único GLOBAL (ADR-029 y ADR-028).
  claveIdempotencia         String               @unique
  payloadHash               String
  resultadoMensaje          String
  creadoPorId               String
  creadoPor                 User                 @relation("NotaCreditoProveedorCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn                  DateTime             @default(now())
  /// Las tres juntas o ninguna (CHECK); el motivo, con al menos un carácter visible y hasta 200.
  anuladaEn                 DateTime?
  anuladaPorId              String?
  anuladaPor                User?                @relation("NotaCreditoProveedorAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  motivoAnulacion           String?

  lineas           NotaCreditoProveedorLinea[] @relation("LineaDeLaNota")
  lineasPorFactura NotaCreditoProveedorLinea[] @relation("LineaDeLaNotaPorFactura")
  tributos         NotaCreditoProveedorTributo[]

  @@unique([empresaId, id])
  /// Destino de la clave foránea con discriminador de la línea: una línea suelta no puede colgar de una nota con factura, ni al revés.
  @@unique([empresaId, id, tipo])
  /// Destino de la clave foránea de la línea: la factura de la línea es la de su nota.
  @@unique([empresaId, id, facturaProveedorId])
  @@index([empresaId, proveedorId, fecha])
  @@index([facturaProveedorId])
}

/// Paquete 4 (M6): una LÍNEA de la nota de crédito. DE EMPRESA (espejo del renglón de la factura). En una nota sobre factura, cada línea acredita exactamente UN renglón de ESA factura (claves foráneas de pertenencia y de naturaleza); en una nota suelta, ninguna línea tiene
/// referencias y declara su naturaleza (si es un gasto, su concepto y una COPIA del tipo de costo). `admiteDevolucion` (CHECK: nota sobre factura y mercadería) es el discriminador de la imputación: solo así una imputación puede llevar una devolución. La línea sobre factura NO copia el
/// concepto ni el tipo de costo: los lectores leen la clasificación vigente del renglón (M5). Solo se agrega. Nada de `src/` la escribe todavía (Etapa C).
model NotaCreditoProveedorLinea {
  id                        String                   @id @default(cuid())
  empresaId                 String                   @default(dbgenerated("app_empresa_actual()"))
  empresa                   Empresa                  @relation(fields: [empresaId], references: [id])
  notaCreditoProveedorId    String
  /// Copia del discriminador de la nota (`SOBRE_FACTURA` o `SUELTA`): tercera columna de la clave foránea hacia la nota.
  tipoNota                  String
  nota                      NotaCreditoProveedor     @relation("LineaDeLaNota", fields: [empresaId, notaCreditoProveedorId, tipoNota], references: [empresaId, id, tipo], onDelete: Restrict, onUpdate: Restrict, map: "NotaCreditoProveedorLinea_nota_tipo_fkey")
  /// La factura de la línea (la de su nota): tercera columna de la clave foránea hacia la nota y primera de la de pertenencia del renglón. NULL en una nota suelta.
  facturaProveedorId        String?
  notaPorFactura            NotaCreditoProveedor?    @relation("LineaDeLaNotaPorFactura", fields: [empresaId, notaCreditoProveedorId, facturaProveedorId], references: [empresaId, id, facturaProveedorId], onDelete: Restrict, onUpdate: Restrict, map: "NotaCreditoProveedorLinea_nota_factura_fkey")
  /// La posición en la nota (desde 1; única por nota).
  orden                     Int
  facturaProveedorRenglonId String?
  renglon                   FacturaProveedorRenglon? @relation("LineaDeNotaDelRenglon", fields: [empresaId, facturaProveedorId, facturaProveedorRenglonId], references: [empresaId, facturaProveedorId, id], onDelete: Restrict, onUpdate: Restrict, map: "NotaCreditoProveedorLinea_renglon_factura_fkey")
  /// `MERCADERIA` o `SIN_STOCK` (CHECK). Con renglón, es la del renglón (clave foránea de naturaleza).
  naturaleza                String
  renglonPorNaturaleza      FacturaProveedorRenglon? @relation("LineaDeNotaPorNaturaleza", fields: [empresaId, facturaProveedorRenglonId, naturaleza], references: [empresaId, id, naturaleza], onDelete: Restrict, onUpdate: Restrict, map: "NotaCreditoProveedorLinea_renglon_naturaleza_fkey")
  /// `= (tipoNota = 'SOBRE_FACTURA' AND naturaleza = 'MERCADERIA')` (CHECK): es la tercera columna de la clave foránea de la imputación.
  admiteDevolucion          Boolean
  /// `RENGLON`, `REPARTO_DEL_TOTAL` (la bonificación global repartida) o `SIN_FACTURA` (CHECK, en pareo con el tipo de la nota).
  origenImporte             String
  descripcion               String?
  /// Solo en una línea suelta `SIN_STOCK` (CHECK de pareo): el concepto de gasto y la COPIA de su tipo de costo.
  conceptoGastoId           String?
  conceptoGasto             ConceptoDeGasto?         @relation(fields: [empresaId, conceptoGastoId], references: [empresaId, id])
  tipoDeCosto               String?
  /// Lo acreditado por la línea, CON IVA incluido. Mayor que cero (CHECK).
  importe                   Decimal                  @db.Decimal(14, 2)
  /// Alícuota, neto e IVA de la línea (NULL = no se desglosó; neto + IVA = `importe` EXACTO, CHECK) e IVA computable (entre 0 y el IVA, CHECK). Mismas reglas que el renglón de la factura.
  alicuotaIva               String?
  importeNeto               Decimal?                 @db.Decimal(14, 2)
  importeIva                Decimal?                 @db.Decimal(14, 2)
  importeIvaComputable      Decimal                  @default(0) @db.Decimal(14, 2)
  creadoEn                  DateTime                 @default(now())

  imputaciones NotaCreditoProveedorImputacion[]

  @@unique([empresaId, id])
  /// Destino de la clave foránea con discriminador de la imputación (M6): solo una línea de mercadería sobre factura admite una devolución.
  @@unique([empresaId, id, admiteDevolucion])
  @@unique([notaCreditoProveedorId, orden])
  @@index([facturaProveedorRenglonId])
  @@index([conceptoGastoId])
}

/// Paquete 4 (M6): la IMPUTACIÓN por sucursal de una línea de la nota de crédito: cuánto del importe de la línea es de cada sucursal y cuánto de eso es IVA computable (repartido en dos pasos con `repartirImporte`, como `ImputacionDeGasto`). `PROPIA` (`sucursalId` NOT NULL; sus
/// políticas de alcance, en la migración siguiente). Es la tabla que lleva la CANTIDAD y la DEVOLUCIÓN: puede apuntar a `Operacion` (clave foránea `(empresaId, operacionDevolucionId)`) porque la regla R8 solo restringe a las tablas DE_EMPRESA. `operacionDevolucionId` es único con la empresa:
/// una devolución se acredita una sola vez. La clave foránea con DISCRIMINADOR `(empresaId, línea, lineaAdmiteDevolucion)` y el CHECK de la devolución impiden que una línea de gasto (o una nota suelta) lleve cantidad o devolución. Solo se agrega: la app tiene SELECT e INSERT.
/// Que Σ imputaciones = importe de la línea y que la devolución sea de la sucursal y de la compra correctas lo valida la Etapa C. Nada de `src/` la escribe todavía.
model NotaCreditoProveedorImputacion {
  id                          String                    @id @default(cuid())
  empresaId                   String                    @default(dbgenerated("app_empresa_actual()"))
  empresa                     Empresa                   @relation(fields: [empresaId], references: [id])
  notaCreditoProveedorLineaId String
  /// Copia de `NotaCreditoProveedorLinea.admiteDevolucion`: tercera columna de la clave foránea hacia la línea.
  lineaAdmiteDevolucion       Boolean
  linea                       NotaCreditoProveedorLinea @relation(fields: [empresaId, notaCreditoProveedorLineaId, lineaAdmiteDevolucion], references: [empresaId, id, admiteDevolucion], onDelete: Restrict, onUpdate: Restrict, map: "NotaCreditoProveedorImputacion_linea_fkey")
  sucursalId                  String
  sucursal                    Sucursal                  @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  /// Lo que le toca a la sucursal, CON IVA incluido. Mayor que cero (CHECK).
  importe                     Decimal                   @db.Decimal(14, 2)
  /// La parte de `importe` que es IVA computable (entre 0 y `importe`, CHECK).
  importeIvaComputable        Decimal                   @default(0) @db.Decimal(14, 2)
  /// Solo con una devolución (CHECK): lo devuelto, en unidad de stock. Mayor que cero.
  cantidadStock               Decimal?                  @db.Decimal(14, 4)
  /// La `Operacion` `DEVOLUCION_PROVEEDOR` que esta imputación acredita. Solo en una línea que admite devolución (CHECK).
  operacionDevolucionId       String?
  operacionDevolucion         Operacion?                @relation(fields: [empresaId, operacionDevolucionId], references: [empresaId, id], onDelete: Restrict, onUpdate: Restrict, map: "NotaCreditoProveedorImputacion_devolucion_fkey")
  creadoEn                    DateTime                  @default(now())

  @@unique([empresaId, id])
  @@unique([notaCreditoProveedorLineaId, sucursalId], map: "NotaCreditoProveedorImputacion_linea_sucursal_key")
  @@unique([empresaId, operacionDevolucionId], map: "NotaCreditoProveedorImputacion_devolucion_key")
  @@index([sucursalId])
}

/// Paquete 4 (M6): un tributo de la nota de crédito (percepción o impuesto que acredita además del IVA). Espejo de `FacturaProveedorTributo`: cuelga de la cabecera, es DE EMPRESA y solo se agrega. `tipo` de lista cerrada e `importe` mayor que cero (CHECK).
/// Que el total de la nota sea Σ líneas + Σ tributos lo valida la Etapa C. Nada de `src/` la escribe todavía.
model NotaCreditoProveedorTributo {
  id                     String               @id @default(cuid())
  empresaId              String               @default(dbgenerated("app_empresa_actual()"))
  empresa                Empresa              @relation(fields: [empresaId], references: [id])
  notaCreditoProveedorId String
  nota                   NotaCreditoProveedor @relation(fields: [empresaId, notaCreditoProveedorId], references: [empresaId, id], map: "NotaCreditoProveedorTributo_nota_fkey")
  tipo                   String
  descripcion            String?
  importe                Decimal              @db.Decimal(14, 2)
  creadoEn               DateTime             @default(now())

  @@unique([empresaId, id])
  @@index([notaCreditoProveedorId])
}

/// Paquete 5 (M7): el PLAN de costos de la empresa (una dimensión analítica: por ejemplo «unidades de negocio»). DE EMPRESA (catálogo de la empresa, sin `sucursalId`; en qué sucursales aplica lo dice `PlanDeCostosSucursal`). El código
/// (mayúsculas, dígitos y guion bajo, empieza con letra, hasta 40; CHECK) es único por empresa y queda fijo: la app solo cambia `nombre` y `activo`. El nombre es único por empresa sin importar mayúsculas (índice sobre `lower`). No se borra:
/// la baja es desactivar. Nada de `src/` lo escribe todavía (Etapa C). No toca dinero.
model PlanDeCostos {
  id        String   @id @default(cuid())
  empresaId String   @default(dbgenerated("app_empresa_actual()"))
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  /// Mayúsculas, dígitos y guion bajo, empieza con letra, hasta 40 (CHECK). Fijo.
  codigo    String
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  /// Los centros de este plan.
  centros        CentroDeCostos[]
  /// En qué sucursales aplica el plan (ADR-009, familia `optin`).
  sucursales     PlanDeCostosSucursal[]
  /// Las versiones de distribución que eligieron este plan.
  distribuciones DistribucionCostoVersion[]

  @@unique([empresaId, id])
  @@unique([empresaId, codigo])
  @@unique([empresaId, nombre])
}

/// Paquete 5 (M7): un CENTRO de costos (unidad de negocio) de un plan. DE EMPRESA (el mismo código vale en todas las sucursales). Código fijo y único por empresa; nombre único por plan sin importar mayúsculas. `centroPadreId` queda SIEMPRE NULL en la
/// versión 1 (CHECK): la clave foránea con DISCRIMINADOR `(empresaId, planDeCostosId, centroPadreId) → CentroDeCostos(empresaId, planDeCostosId, id)` ya obliga a que el padre sea del mismo plan para cuando se habiliten los sub-centros (ADR-031).
/// Se agrega y se renombra o desactiva; no se borra. Nada de `src/` lo escribe todavía (Etapa C).
model CentroDeCostos {
  id             String          @id @default(cuid())
  empresaId      String          @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  planDeCostosId String
  plan           PlanDeCostos    @relation(fields: [empresaId, planDeCostosId], references: [empresaId, id])
  /// Mayúsculas, dígitos y guion bajo, empieza con letra, hasta 40 (CHECK). Fijo.
  codigo         String
  nombre         String
  /// Siempre NULL en la v1 (CHECK). Con la jerarquía, el padre es del mismo plan (clave foránea de tres columnas).
  centroPadreId  String?
  centroPadre    CentroDeCostos? @relation("JerarquiaDeCentros", fields: [empresaId, planDeCostosId, centroPadreId], references: [empresaId, planDeCostosId, id], onDelete: Restrict, onUpdate: Restrict)
  activo         Boolean         @default(true)
  creadoEn       DateTime        @default(now())

  hijos                CentroDeCostos[]         @relation("JerarquiaDeCentros")
  /// Las líneas de distribución que reparten a este centro.
  lineasDeDistribucion DistribucionCostoLinea[]

  @@unique([empresaId, id])
  @@unique([empresaId, planDeCostosId, id])
  @@unique([empresaId, codigo])
  @@unique([empresaId, planDeCostosId, nombre])
}

/// Paquete 5 (M7): EN QUÉ SUCURSALES aplica un plan de costos (ADR-009, familia `optin`: sin fila, o con `aplica = false`, el plan NO aplica en la sucursal y sus gastos quedan «no aplica», no «sin asignar»). `PROPIA` (`sucursalId` NOT NULL; sus
/// políticas de alcance las agrega M7.3). Una fila por (plan, sucursal); es un interruptor: la app solo cambia `aplica` (UPDATE por columna). Que no se cambie si la sucursal ya tiene gastos con ese plan lo valida la Etapa C. Nada de `src/` la escribe todavía.
model PlanDeCostosSucursal {
  id             String       @id @default(cuid())
  empresaId      String       @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa      @relation(fields: [empresaId], references: [id])
  planDeCostosId String
  plan           PlanDeCostos @relation(fields: [empresaId, planDeCostosId], references: [empresaId, id])
  sucursalId     String
  sucursal       Sucursal     @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  /// `false` es lo mismo que no tener fila (lo resuelve el embudo `planDeCostosAplica`).
  aplica         Boolean
  creadoEn       DateTime     @default(now())

  @@unique([empresaId, id])
  @@unique([planDeCostosId, sucursalId])
  @@index([sucursalId])
}

/// Paquete 5 (M7): una VERSIÓN de la distribución de la imputación de un gasto entre los centros de UN plan. Alcance `HEREDADO` de `ImputacionDeGasto` por `imputacionDeGastoId` (sin `sucursalId` propio; sus políticas de sucursal las agrega M7.3).
/// La mercadería no se distribuye (solo existen imputaciones de renglones `SIN_STOCK`). Cada (imputación, plan) tiene versiones 1, 2, 3...; la vigente es SIEMPRE la de `numero` mayor (derivada, nunca un flag ni un UPDATE); sin ninguna fila el estado es
/// «sin asignar». Corregir es agregar una versión nueva con `motivo` (obligatorio desde la 2). SOLO se agrega: la app tiene SELECT e INSERT, nunca UPDATE ni DELETE. El único `(imputación, plan, numero)` elige UNA ganadora entre versiones
/// simultáneas; la clave de idempotencia es única global (ADR-028) y se guarda el mensaje para reproducirlo (I3). Cabecera y líneas van en la MISMA transacción. Que Σ `porcentajeBp` = 10000 y que Σ importes e IVA computable sean los de la imputación
/// lo valida la Etapa C (la base no suma filas; no hay disparadores). La versión rige desde `creadoEn` (UTC) y vale para el período del gasto. No tiene `@updatedAt`. Nada de `src/` la escribe todavía.
model DistribucionCostoVersion {
  id                  String            @id @default(cuid())
  empresaId           String            @default(dbgenerated("app_empresa_actual()"))
  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  imputacionDeGastoId String
  imputacion          ImputacionDeGasto @relation(fields: [empresaId, imputacionDeGastoId], references: [empresaId, id], onDelete: Restrict)
  planDeCostosId      String
  plan                PlanDeCostos      @relation(fields: [empresaId, planDeCostosId], references: [empresaId, id])
  /// 1, 2, 3...: único por (imputación, plan) (CHECK >= 1). La vigente es la de número mayor.
  numero              Int
  /// NULL o con al menos un carácter visible y hasta 200 (CHECK). Obligatorio desde la versión 2 (CHECK).
  motivo              String?
  /// UUID que genera la pantalla. Único GLOBAL (ADR-028).
  claveIdempotencia   String            @unique
  payloadHash         String
  resultadoMensaje    String
  creadoPorId         String
  creadoPor           User              @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  /// Instante (UTC) desde el que rige la versión; vale para el período original del gasto.
  creadoEn            DateTime          @default(now())

  lineas DistribucionCostoLinea[]

  @@unique([empresaId, id])
  @@unique([empresaId, id, planDeCostosId])
  @@unique([imputacionDeGastoId, planDeCostosId, numero], map: "DistribucionCostoVersion_imputacion_plan_numero_key")
  @@index([planDeCostosId])
}

/// Paquete 5 (M7): una LÍNEA de una versión de distribución: lo que le toca a un centro (porcentaje en puntos básicos enteros, 1 a 10000, más `importe` e `importeIvaComputable` repartidos en dos pasos con `repartirImporte`). Alcance `HEREDADO` de
/// `DistribucionCostoVersion` por `distribucionCostoVersionId`. `planDeCostosId` es el discriminador copiado: las claves foráneas `(empresaId, versión, planDeCostosId)` y `(empresaId, planDeCostosId, centro)` obligan a que el centro sea del plan
/// de la versión. SOLO se agrega. Una línea por (versión, centro). `importe` puede quedar en 0,00 por el redondeo. La suma de las líneas la valida la Etapa C. Nada de `src/` la escribe todavía.
model DistribucionCostoLinea {
  id                         String                   @id @default(cuid())
  empresaId                  String                   @default(dbgenerated("app_empresa_actual()"))
  empresa                    Empresa                  @relation(fields: [empresaId], references: [id])
  distribucionCostoVersionId String
  planDeCostosId             String
  version                    DistribucionCostoVersion @relation(fields: [empresaId, distribucionCostoVersionId, planDeCostosId], references: [empresaId, id, planDeCostosId], onDelete: Restrict, onUpdate: Restrict)
  centroDeCostosId           String
  centro                     CentroDeCostos           @relation(fields: [empresaId, planDeCostosId, centroDeCostosId], references: [empresaId, planDeCostosId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Puntos básicos enteros: 1 a 10000 (CHECK).
  porcentajeBp               Int
  /// Lo que le toca al centro, CON IVA incluido. Cero o más (CHECK).
  importe                    Decimal                  @db.Decimal(14, 2)
  /// La parte de `importe` que es IVA computable (entre 0 y `importe`, CHECK).
  importeIvaComputable       Decimal                  @default(0) @db.Decimal(14, 2)

  @@unique([empresaId, id])
  @@unique([distribucionCostoVersionId, centroDeCostosId], map: "DistribucionCostoLinea_version_centro_key")
  @@index([centroDeCostosId])
}

/// GO-1 (el «elemento configurable»): un GRUPO de opciones de venta (tamaño, variante, incluida, adicional). DE EMPRESA (sin `sucursalId`, solo RLS por empresa). `tipo` es una lista cerrada guardada como TEXT con CHECK
/// (`MEDIDA`, `VARIANTE`, `INCLUIDA`, `ADICIONAL`, el espejo de `TIPOS_DE_GRUPO_DE_OPCIONES` en `src/core/opciones/tipos.ts`; un test de paridad las compara), no como enum de Postgres: agregar un valor es cambiar un CHECK, reversible. Inmutable
/// una vez creado (la app no tiene UPDATE de `tipo`). CHECK: cantidades `0 <= mínima <= máxima <= 10`; una MEDIDA elige exactamente una (1 y 1); una INCLUIDA exige mínimo 1. Nombre con algún carácter visible y hasta 80, único por empresa sin
/// importar mayúsculas (índice sobre `lower("nombre")` que solo vive en la migración). `version` es el control optimista de la edición (`UPDATE ... WHERE version = esperada`): lo aplica la aplicación en GO-2, la base solo garantiza `>= 1`. Sin
/// `@updatedAt`: rompería el privilegio por columna (la app actualiza `actualizadoEn` a mano). No se borra. Nada de `src/` la escribe todavía (GO-2).
model GrupoDeOpciones {
  id             String   @id @default(cuid())
  empresaId      String   @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa  @relation(fields: [empresaId], references: [id])
  nombre         String
  /// MEDIDA, VARIANTE, INCLUIDA o ADICIONAL (CHECK). Inmutable.
  tipo           String
  cantidadMinima Int      @default(0)
  cantidadMaxima Int      @default(1)
  activo         Boolean  @default(true)
  /// Control optimista (>= 1, CHECK). Lo incrementa la aplicación en cada edición.
  version        Int      @default(1)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @default(now())
  /// Fase 4 de la ola «precio y carta» (ADR-035, DEC-34): «se lee en la carta como», el prefijo OPCIONAL con que la carta lee cada opción («De» → «De carne»). NULL = sin prefijo. Solo VARIANTE y MEDIDA
  /// (lo aplica el caso de uso); solo lo lee la carta (ni el precio, ni la foto de la venta, ni el POS, ni el ticket). CHECK "GrupoDeOpciones_prefijo_en_carta_chk": visible, sin espacios a los costados,
  /// hasta 20 caracteres. Tiene su propio GRANT de UPDATE por columna para `motor2_app` (la tabla tiene privilegios por columna).
  prefijoEnCarta String?

  opciones          OpcionDeGrupo[]
  productosQueLoAdmiten ProductoAdmiteGrupo[]
  elegidasEnLinea   OpcionElegidaEnLinea[]

  @@unique([empresaId, id])
  @@unique([empresaId, nombre])
}

/// GO-1: una OPCIÓN de un grupo (por ejemplo «Grande» o «Leche de almendras»). DE EMPRESA. `esNinguna` marca la opción «Ninguna»/«Sin nada» del grupo (a lo sumo una por grupo: índice parcial; no lleva producto, CHECK). `productoId` es el
/// producto ANCLA de una opción de un grupo ADICIONAL (el producto que se vende y descuenta stock como línea hija): único por empresa, así que un producto respalda a una sola opción, y sin filas de disponibilidad queda oculto por la semántica «sin fila
/// = no disponible» (ADR-009, optin). `grupoId`, `productoId` y `esNinguna` son inmutables (la app no tiene UPDATE). Nombre único por grupo sin importar mayúsculas. Lo que cuesta y lo que consume una opción vive en sus VERSIONES
/// (`VersionDeOpcion`), que solo se agregan. No se borra: se desactiva.
model OpcionDeGrupo {
  id            String          @id @default(cuid())
  empresaId     String          @default(dbgenerated("app_empresa_actual()"))
  empresa       Empresa         @relation(fields: [empresaId], references: [id])
  grupoId       String
  grupo         GrupoDeOpciones @relation(fields: [empresaId, grupoId], references: [empresaId, id])
  nombre        String
  orden         Int             @default(0)
  activa        Boolean         @default(true)
  esNinguna     Boolean         @default(false)
  /// El producto ancla (solo en un ADICIONAL; NULL en las demás y en la «ninguna»). Único por empresa.
  productoId    String?
  producto      Producto?       @relation(fields: [empresaId, productoId], references: [empresaId, id])
  /// Control optimista (>= 1, CHECK).
  version       Int             @default(1)
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @default(now())

  versiones             VersionDeOpcion[]
  productosQueLaAdmiten ProductoAdmiteOpcion[]
  preciosLocales        PrecioLocalDeOpcion[]
  apagadasEnSucursal    OpcionApagadaEnSucursal[]
  elegidasEnLinea       OpcionElegidaEnLinea[]
  enEntradasDeCupo      OpcionDeEntradaDeCupo[]
  combinacionesComoEje1 CombinacionDeProducto[] @relation("CombinacionEje1")
  combinacionesComoEje2 CombinacionDeProducto[] @relation("CombinacionEje2")

  @@unique([empresaId, id])
  @@unique([grupoId, nombre])
  @@unique([empresaId, productoId])
}

/// GO-1: una VERSIÓN de una opción: la diferencia de precio y el consumo que tiene desde su `creadoEn` (UTC; se muestra en la zona de la empresa). SOLO se agrega: la app tiene SELECT e INSERT, nunca UPDATE ni DELETE; corregir es agregar la versión
/// siguiente. La vigente es SIEMPRE la de `numero` mayor (derivada, sin flag ni UPDATE: `DISTINCT ON ("opcionId") ... ORDER BY "opcionId", "numero" DESC`); dos versiones simultáneas con el mismo número dan 23505 y gana una. `tipoDeDiferencia` dice cuál
/// de `diferenciaPrecio` (MONTO) o `porcentaje` (PORCENTAJE, `DECIMAL(7,4)`, mayor que -100 y hasta 999,9999) está cargada; la otra es NULL (CHECK). `factorEscala` (> 0 y hasta 10) solo lo usa una MEDIDA. Que la diferencia de una INCLUIDA sea 0, que el
/// monto de un ADICIONAL sea >= 0,01 y que el factor solo exista en una MEDIDA lo valida la aplicación (`componerPrecioDeLinea` ya falla cerrado al vender) y la foto de la línea los repite en la base. No tiene `@updatedAt`.
model VersionDeOpcion {
  id               String        @id @default(cuid())
  empresaId        String        @default(dbgenerated("app_empresa_actual()"))
  empresa          Empresa       @relation(fields: [empresaId], references: [id])
  opcionId         String
  opcion           OpcionDeGrupo @relation(fields: [empresaId, opcionId], references: [empresaId, id], onDelete: Restrict)
  /// 1, 2, 3...: único por opción (CHECK >= 1). La vigente es la de número mayor.
  numero           Int
  /// MONTO o PORCENTAJE (CHECK), el espejo de `TIPOS_DE_DIFERENCIA`. Sin valor por defecto.
  tipoDeDiferencia String
  /// Con MONTO: la diferencia (puede ser negativa o cero). NULL con PORCENTAJE.
  diferenciaPrecio Decimal?      @db.Decimal(14, 2)
  /// Con PORCENTAJE: la diferencia (-100 < p <= 999,9999). NULL con MONTO.
  porcentaje       Decimal?      @db.Decimal(7, 4)
  /// Solo una MEDIDA (> 0 y hasta 10): cuánto escala el consumo del producto.
  factorEscala     Decimal?      @db.Decimal(8, 4)
  creadoPorId      String
  creadoPor        User          @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn         DateTime      @default(now())

  consumos        ConsumoDeOpcion[]
  elegidasEnLinea OpcionElegidaEnLinea[]

  @@unique([empresaId, id])
  @@unique([opcionId, numero])
  @@index([creadoPorId])
}

/// GO-1: una línea de CONSUMO de una versión de opción: qué insumo suma (`SUMA`) o qué ingrediente de la receta reemplaza (`REEMPLAZA`, con `reemplazaAProductoId`) y cuánto. SOLO se agrega. `cantidad` es `DECIMAL(14,4)` mayor que 0, en
/// la unidad `unidadId` (la unidad de stock del insumo: lo controla la aplicación); `mermaPorcentaje` entre 0 y 100; `escalaConLaMedida` dice si el consumo se multiplica por el factor de la MEDIDA elegida (un ADICIONAL nunca escala). Un reemplazo por
/// insumo por versión (índice parcial). `efecto` es TEXT con CHECK (`EFECTOS_DE_CONSUMO_DE_OPCION`). No tiene `@updatedAt`.
model ConsumoDeOpcion {
  id                   String          @id @default(cuid())
  empresaId            String          @default(dbgenerated("app_empresa_actual()"))
  empresa              Empresa         @relation(fields: [empresaId], references: [id])
  versionDeOpcionId    String
  versionDeOpcion      VersionDeOpcion @relation(fields: [empresaId, versionDeOpcionId], references: [empresaId, id], onDelete: Restrict)
  /// SUMA o REEMPLAZA (CHECK). REEMPLAZA exige `reemplazaAProductoId`; SUMA lo prohíbe.
  efecto               String
  insumoProductoId     String
  productoInsumo       Producto        @relation("ConsumoDeOpcionInsumo", fields: [empresaId, insumoProductoId], references: [empresaId, id])
  reemplazaAProductoId String?
  productoReemplazado  Producto?       @relation("ConsumoDeOpcionReemplazo", fields: [empresaId, reemplazaAProductoId], references: [empresaId, id])
  cantidad             Decimal         @db.Decimal(14, 4)
  unidadId             String
  unidad               Unidad          @relation(fields: [empresaId, unidadId], references: [empresaId, id])
  mermaPorcentaje      Decimal         @default(0) @db.Decimal(6, 2)
  escalaConLaMedida    Boolean         @default(false)
  orden                Int             @default(0)

  @@unique([empresaId, id])
  @@unique([versionDeOpcionId, orden])
  @@index([insumoProductoId])
}

/// GO-1: qué GRUPOS de opciones admite un producto, y con qué límites propios. DE EMPRESA (qué se ofrece de cada producto es del catálogo; apagar una opción en una sucursal es `OpcionApagadaEnSucursal`). `cantidadMinima`/`cantidadMaxima` NULL
/// = los del grupo; `modoPrecio` (ABSOLUTO o DIFERENCIA) solo lo usa una MEDIDA y NULL = el que decida la aplicación. Se edita EN EL LUGAR, con auditoría del antes y el después, y `version` es el control optimista: es configuración de lista, no lo cobrado
/// (eso queda congelado en `OpcionElegidaEnLinea`). Una fila por (producto, grupo). No se borra: se desactiva. Nada de `src/` la escribe todavía.
model ProductoAdmiteGrupo {
  id             String          @id @default(cuid())
  empresaId      String          @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  productoId     String
  producto       Producto        @relation(fields: [empresaId, productoId], references: [empresaId, id])
  grupoId        String
  grupo          GrupoDeOpciones @relation(fields: [empresaId, grupoId], references: [empresaId, id])
  orden          Int             @default(0)
  cantidadMinima Int?
  cantidadMaxima Int?
  /// ABSOLUTO o DIFERENCIA (CHECK), el espejo de `MODOS_DE_PRECIO_DE_MEDIDA`; NULL = sin definir.
  modoPrecio     String?
  activo         Boolean         @default(true)
  /// Control optimista (>= 1, CHECK).
  version        Int             @default(1)
  creadoEn       DateTime        @default(now())
  actualizadoEn  DateTime        @default(now())
  // (GO-3a declaraba acá `ejeDeCombinacion`, el eje de las combinaciones del producto: se retiró del modelo en la Fase 3 de la ola «precio y carta», paso 3.5. La columna —nulable, NULL en
  // todas las filas— sigue en la base hasta la migración de retiro, con su CHECK y su índice único parcial; Prisma no la ve ni la pide.)

  @@unique([productoId, grupoId])
  @@unique([empresaId, id])
  @@index([grupoId])
}

/// GO-1: qué OPCIONES admite un producto y a qué precio (la grilla de lista, de la empresa). DE EMPRESA. `precioAbsoluto` (>= 0,01) o una diferencia (`tipoDeDiferencia` con `diferenciaPrecio` o `porcentaje`, la otra NULL) sobreescriben la de la versión
/// de la opción para ESTE producto; no pueden estar las dos a la vez (CHECK); los tres NULL = rige la de la versión. Se edita EN EL LUGAR, con auditoría del antes y el después (es precio de lista, como `Producto.precioVenta`), con `version` como control
/// optimista; lo cobrado queda congelado en `OpcionElegidaEnLinea`. Una fila por (producto, opción). No se borra: se desactiva. Nada de `src/` la escribe todavía.
model ProductoAdmiteOpcion {
  id               String        @id @default(cuid())
  empresaId        String        @default(dbgenerated("app_empresa_actual()"))
  empresa          Empresa       @relation(fields: [empresaId], references: [id])
  productoId       String
  producto         Producto      @relation(fields: [empresaId, productoId], references: [empresaId, id])
  opcionId         String
  opcion           OpcionDeGrupo @relation(fields: [empresaId, opcionId], references: [empresaId, id])
  /// Unidades de esta opción por unidad vendida: 1 a 10 (CHECK).
  cantidadMaxima   Int           @default(1)
  /// El precio de lista de la MEDIDA en este producto (>= 0,01). NULL si no es absoluto.
  precioAbsoluto   Decimal?      @db.Decimal(14, 2)
  /// MONTO o PORCENTAJE (CHECK), o NULL.
  tipoDeDiferencia String?
  diferenciaPrecio Decimal?      @db.Decimal(14, 2)
  porcentaje       Decimal?      @db.Decimal(7, 4)
  activo           Boolean       @default(true)
  /// Control optimista (>= 1, CHECK).
  version          Int           @default(1)
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @default(now())

  @@unique([productoId, opcionId])
  @@unique([empresaId, id])
  @@index([opcionId])
}

/// GO-1: el PRECIO de una opción de un producto EN UNA SUCURSAL (la grilla local; override liviano, como `PrecioLocalProducto`, ADR-009 familia `override`: sin fila habilitada rige el precio de la empresa, el de `ProductoAdmiteOpcion` o el de la versión). `PROPIA`
/// (`sucursalId` NOT NULL; sus políticas de alcance las agrega GO-1c-rls). `precio` es `DECIMAL(14,2)` de 0,01 o más (CHECK). La app solo cambia `precio`, `habilitado` y `actualizadoEn` (UPDATE por columna), con auditoría del antes y el después, y no borra
/// nada: la baja es `habilitado = false`. Una fila por (sucursal, producto, opción). Una fila de un par que el producto no admite no hace daño: la lectura exige además la admisión (`ProductoAdmiteOpcion`). Lo cobrado queda congelado en la foto de la línea
/// (`OpcionElegidaEnLinea`). Sin `@updatedAt`: rompería el privilegio por columna. Nada de `src/` la escribe todavía (GO-2).
model PrecioLocalDeOpcion {
  id            String        @id @default(cuid())
  empresaId     String        @default(dbgenerated("app_empresa_actual()"))
  empresa       Empresa       @relation(fields: [empresaId], references: [id])
  sucursalId    String
  sucursal      Sucursal      @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  productoId    String
  producto      Producto      @relation(fields: [empresaId, productoId], references: [empresaId, id])
  opcionId      String
  opcion        OpcionDeGrupo @relation(fields: [empresaId, opcionId], references: [empresaId, id])
  /// El precio de la opción en esa sucursal (0,01 o más, CHECK).
  precio        Decimal       @db.Decimal(14, 2)
  habilitado    Boolean       @default(true)
  actualizadoEn DateTime      @default(now())

  @@unique([sucursalId, productoId, opcionId])
  @@unique([empresaId, id])
}

/// GO-1: si una opción está APAGADA en una sucursal (se acabó el ingrediente, no se ofrece hoy). `PROPIA` (`sucursalId` NOT NULL; sus políticas de alcance las agrega GO-1c-rls). ADR-009, familia `optout`: SIN FILA = PRENDIDA (`apagada = false`); solo
/// una fila con `apagada = true` la apaga. La app la crea y la actualiza con `ON CONFLICT DO UPDATE` de `apagada`, `actualizadoPorId` y `actualizadoEn`; no borra nada. Una fila por (sucursal, opción). Lo resuelve `validarOpcionesElegidas` al vender. No tiene
/// `@updatedAt`. Nada de `src/` la escribe todavía (GO-2).
model OpcionApagadaEnSucursal {
  id              String        @id @default(cuid())
  empresaId       String        @default(dbgenerated("app_empresa_actual()"))
  empresa         Empresa       @relation(fields: [empresaId], references: [id])
  sucursalId      String
  sucursal        Sucursal      @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  opcionId        String
  opcion          OpcionDeGrupo @relation(fields: [empresaId, opcionId], references: [empresaId, id])
  /// Obligatorio, sin valor por defecto: la fila dice explícitamente si está apagada.
  apagada         Boolean
  actualizadoPorId String
  actualizadoPor  User          @relation(fields: [actualizadoPorId], references: [id], onDelete: Restrict)
  actualizadoEn   DateTime      @default(now())

  @@unique([sucursalId, opcionId])
  @@unique([empresaId, id])
}

/// GO-1: la FOTO de una opción elegida en una línea de la cuenta: lo que se eligió y lo que costó, CONGELADO (I9: editar después la versión, el precio de lista o el nombre del grupo no la cambia). Alcance `HEREDADO` de `CuentaItem` por `cuentaItemId` (sin
/// `sucursalId` propio; sus políticas de sucursal las agrega GO-1d-rls). SOLO se agrega: la app tiene SELECT e INSERT, nunca UPDATE ni DELETE; al borrar el borrador de la línea la foto se borra con ella (ON DELETE CASCADE, que corre como dueño y saltea la RLS).
/// Guarda el tipo del grupo, el nombre del grupo y de la opción, la cantidad (1 a 10; una MEDIDA siempre 1), el modo de precio (solo MEDIDA), la diferencia (`tipoDeDiferencia` con su `porcentaje` de `DECIMAL(7,4)`, NULL si no hubo), el `importeUnitario` (`DECIMAL(14,2)`,
/// el que aportó la opción por unidad) y el factor de escala (solo MEDIDA). Las reglas que dependen del tipo —una INCLUIDA aporta 0, un ADICIONAL es monto fijo de 0,01 o más, el porcentaje solo en MEDIDA y VARIANTE— son CHECK. Que la opción sea del grupo, la versión de la
/// opción y la línea la correcta (un ADICIONAL en una línea con padre y con el producto ancla; las demás en una línea sin padre y con huella; nunca en un espejo) lo controla el disparador `OpcionElegidaEnLinea_coherente_chk`. Una fila por (línea, opción); a lo sumo
/// un ADICIONAL y una MEDIDA por línea (índices parciales).
model OpcionElegidaEnLinea {
  id                String          @id @default(cuid())
  empresaId         String          @default(dbgenerated("app_empresa_actual()"))
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  cuentaItemId      String
  cuentaItem        CuentaItem      @relation(fields: [empresaId, cuentaItemId], references: [empresaId, id], onDelete: Cascade)
  grupoId           String
  grupo             GrupoDeOpciones @relation(fields: [empresaId, grupoId], references: [empresaId, id], onDelete: Restrict)
  opcionId          String
  opcion            OpcionDeGrupo   @relation(fields: [empresaId, opcionId], references: [empresaId, id], onDelete: Restrict)
  versionDeOpcionId String
  versionDeOpcion   VersionDeOpcion @relation(fields: [empresaId, versionDeOpcionId], references: [empresaId, id], onDelete: Restrict)
  /// MEDIDA, VARIANTE, INCLUIDA o ADICIONAL (CHECK), el espejo de `TIPOS_DE_GRUPO_DE_OPCIONES`. Es el del grupo (lo controla el disparador).
  tipoGrupo         String
  nombreGrupo       String
  nombreOpcion      String
  /// 1 a 10 (CHECK); una MEDIDA siempre 1.
  cantidad          Int             @default(1)
  /// Solo MEDIDA: ABSOLUTO o DIFERENCIA (CHECK). NULL en las demás.
  modoPrecio        String?
  /// MONTO o PORCENTAJE (CHECK), o NULL si no hubo diferencia (precio absoluto, incluida o variante sin diferencia).
  tipoDeDiferencia  String?
  /// Solo con PORCENTAJE (-100 < p <= 999,9999, CHECK).
  porcentaje        Decimal?        @db.Decimal(7, 4)
  /// Lo que aportó la opción por unidad: el precio absoluto de la medida, la diferencia, 0 (incluida) o el recargo (adicional).
  importeUnitario   Decimal         @db.Decimal(14, 2)
  /// El importe salió de la grilla de la sucursal (`PrecioLocalDeOpcion`).
  precioDeSucursal  Boolean         @default(false)
  /// Solo MEDIDA (> 0 y hasta 10).
  factorEscala      Decimal?        @db.Decimal(8, 4)
  orden             Int             @default(0)
  creadoEn          DateTime        @default(now())

  @@unique([empresaId, id])
  @@unique([cuentaItemId, opcionId])
  @@index([opcionId])
  @@index([versionDeOpcionId])
}

/// GO-3 (ADR-032, frente A, D-4): un GRUPO DE PRECIO, la tarifa compartida entre combinaciones de uno o varios productos («Café mediano $ 3.300»). DE EMPRESA. `precio` es `DECIMAL(14,2)` de 0,01 o más (CHECK). Nombre
/// único por empresa sin importar mayúsculas (índice sobre `lower("nombre")` que solo vive en la migración). Se edita EN EL LUGAR con auditoría por columna y `version` como control optimista (D-3; la base solo garantiza `>= 1`);
/// lo cobrado queda congelado en la línea y en `CombinacionEnLinea`. No se borra: se desactiva (y no se desactiva con miembros: lo controla la aplicación). Su precio por sucursal es `PrecioLocalDeCombinacion`.
model GrupoDePrecio {
  id             String                     @id @default(cuid())
  empresaId      String                     @default(dbgenerated("app_empresa_actual()"))
  empresa        Empresa                    @relation(fields: [empresaId], references: [id])
  nombre         String
  precio         Decimal                    @db.Decimal(14, 2)
  activo         Boolean                    @default(true)
  /// Control optimista (>= 1, CHECK).
  version        Int                        @default(1)
  creadoEn       DateTime                   @default(now())
  actualizadoEn  DateTime                   @default(now())
  combinaciones  CombinacionDeProducto[]
  preciosLocales PrecioLocalDeCombinacion[]
  enLineas       CombinacionEnLinea[]

  @@unique([empresaId, id])
  @@unique([empresaId, nombre])
}

/// GO-3 (ADR-032, frente A): una COMBINACIÓN de las opciones de los ejes de un producto (`ProductoAdmiteGrupo.ejeDeCombinacion` 1 y 2): la opción del eje 1 y, si hay, la del eje 2. DE EMPRESA. Es una SOBRESCRITURA DISPERSA: sin
/// fila rige el precio aditivo de GO-1; con `activa = false` esa combinación no se vende (`COMBINACION_NO_DISPONIBLE`); con `precio` (propio, >= 0,01) o `grupoDePrecioId` (uno o ninguno, CHECK) rige ese precio. Identidad
/// (producto y opciones) INMUTABLE: la app solo cambia `activa`, `precio`, `grupoDePrecioId`, `version` y `actualizadoEn`. Única por (producto, eje 1, eje 2) con un índice por expresión que solo vive en la migración
/// (`COALESCE` del eje 2: no depende de NULLS NOT DISTINCT). Puede existir solo para tener receta propia (`RecetaDeCombinacionVersion`). No se borra: se desactiva.
model CombinacionDeProducto {
  id              String                       @id @default(cuid())
  empresaId       String                       @default(dbgenerated("app_empresa_actual()"))
  empresa         Empresa                      @relation(fields: [empresaId], references: [id])
  productoId      String
  producto        Producto                     @relation(fields: [empresaId, productoId], references: [empresaId, id])
  opcionEje1Id    String
  opcionEje1      OpcionDeGrupo                @relation("CombinacionEje1", fields: [empresaId, opcionEje1Id], references: [empresaId, id])
  /// NULL si el producto tiene un solo eje.
  opcionEje2Id    String?
  opcionEje2      OpcionDeGrupo?               @relation("CombinacionEje2", fields: [empresaId, opcionEje2Id], references: [empresaId, id])
  activa          Boolean                      @default(true)
  /// El precio propio de la combinación (>= 0,01) o NULL.
  precio          Decimal?                     @db.Decimal(14, 2)
  grupoDePrecioId String?
  grupoDePrecio   GrupoDePrecio?               @relation(fields: [empresaId, grupoDePrecioId], references: [empresaId, id])
  /// Control optimista (>= 1, CHECK).
  version         Int                          @default(1)
  creadoEn        DateTime                     @default(now())
  actualizadoEn   DateTime                     @default(now())
  preciosLocales  PrecioLocalDeCombinacion[]
  recetas         RecetaDeCombinacionVersion[]
  enLineas        CombinacionEnLinea[]

  @@unique([empresaId, id])
  @@index([grupoDePrecioId])
}

/// GO-3 (ADR-032, D-4): el precio de una combinación O de un grupo de precio EN UNA SUCURSAL (`num_nonnulls(combinacionId, grupoDePrecioId) = 1`, CHECK). `PROPIA` (sus políticas de alcance las agrega GO-3a-rls). ADR-009, familia
/// `override`: sin fila habilitada (o con la capacidad `precio_local` apagada) rige el precio de la empresa. Se lee SOLO en `src/server/lecturas/catalogo/precio-local.ts` (guardián `precio-local-en-un-solo-lugar`). La app solo
/// cambia `precio`, `habilitado` y `actualizadoEn`; no borra nada. Un precio por (sucursal, combinación) y uno por (sucursal, grupo): únicos comunes (la columna que no se usa es NULL y dos NULL son distintos).
model PrecioLocalDeCombinacion {
  id              String                 @id @default(cuid())
  empresaId       String                 @default(dbgenerated("app_empresa_actual()"))
  empresa         Empresa                @relation(fields: [empresaId], references: [id])
  sucursalId      String
  sucursal        Sucursal               @relation(fields: [empresaId, sucursalId], references: [empresaId, id])
  combinacionId   String?
  combinacion     CombinacionDeProducto? @relation(fields: [empresaId, combinacionId], references: [empresaId, id])
  grupoDePrecioId String?
  grupoDePrecio   GrupoDePrecio?         @relation(fields: [empresaId, grupoDePrecioId], references: [empresaId, id])
  /// 0,01 o más (CHECK).
  precio          Decimal                @db.Decimal(14, 2)
  habilitado      Boolean                @default(true)
  actualizadoEn   DateTime               @default(now())

  @@unique([sucursalId, combinacionId])
  @@unique([sucursalId, grupoDePrecioId])
  @@unique([empresaId, id])
}

/// GO-3 (ADR-032, frente B): una VERSIÓN de la receta PROPIA de una combinación (el flat white grande con doble shot). DE EMPRESA (v1: sin receta por sucursal). SOLO se agrega: la vigente es la de `numero` mayor (derivada) y
/// dos versiones con el mismo número dan 23505 (gana una). Una versión SIN ingredientes significa «sin excepción, vuelve a la regla general»: así se quita una excepción sin borrar nada. Se congela al agregar el ítem en
/// `CombinacionEnLinea.recetaDeCombinacionVersionId`. Tablas separadas de `RecetaVersion` a propósito (no se tocan los lectores de la receta vigente).
model RecetaDeCombinacionVersion {
  id            String                           @id @default(cuid())
  empresaId     String                           @default(dbgenerated("app_empresa_actual()"))
  empresa       Empresa                          @relation(fields: [empresaId], references: [id])
  combinacionId String
  combinacion   CombinacionDeProducto            @relation(fields: [empresaId, combinacionId], references: [empresaId, id])
  /// 1, 2, 3...: único por combinación (CHECK >= 1).
  numero        Int
  creadoPorId   String
  creadoPor     User                             @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  creadoEn      DateTime                         @default(now())
  ingredientes  RecetaDeCombinacionIngrediente[]
  enLineas      CombinacionEnLinea[]

  @@unique([empresaId, id])
  @@unique([combinacionId, numero])
  @@index([creadoPorId])
}

/// GO-3: un ingrediente de una versión de receta de combinación. DE EMPRESA. SOLO se agrega. `cantidad` `DECIMAL(14,4)` mayor que 0 en la unidad de stock del insumo (lo controla la aplicación); merma `DECIMAL(6,2)` de 0 a 100 (CHECK).
model RecetaDeCombinacionIngrediente {
  id               String                     @id @default(cuid())
  empresaId        String                     @default(dbgenerated("app_empresa_actual()"))
  empresa          Empresa                    @relation(fields: [empresaId], references: [id])
  versionId        String
  version          RecetaDeCombinacionVersion @relation(fields: [empresaId, versionId], references: [empresaId, id])
  insumoProductoId String
  productoInsumo   Producto                   @relation("RecetaDeCombinacionInsumo", fields: [empresaId, insumoProductoId], references: [empresaId, id])
  cantidad         Decimal                    @db.Decimal(14, 4)
  unidadId         String
  unidad           Unidad                     @relation(fields: [empresaId, unidadId], references: [empresaId, id])
  mermaPorcentaje  Decimal                    @default(0) @db.Decimal(6, 2)
  orden            Int                        @default(0)

  @@unique([empresaId, id])
  @@unique([versionId, orden])
  @@index([insumoProductoId])
}

/// GO-3 (ADR-032): la FOTO de la combinación vendida en una línea de la cuenta, 1 a 1 con `CuentaItem` (único por `cuentaItemId`). Alcance `HEREDADO` de `CuentaItem` (sus políticas las agrega GO-3a-rls). Guarda de dónde salió el
/// precio (`origenPrecio`: ADITIVO, PROPIO o GRUPO, CHECK), si fue de la sucursal, el grupo con su nombre copiado, el precio usado y la versión de la receta propia congelada al agregar. Se escribe solo si la línea tiene fila de
/// combinación. SOLO se agrega; se borra con el borrador de su línea (ON DELETE CASCADE, que corre como dueño). No agrega columnas a `CuentaItem`. Que sea del mismo producto que la línea lo controla la aplicación.
model CombinacionEnLinea {
  id                           String                      @id @default(cuid())
  empresaId                    String                      @default(dbgenerated("app_empresa_actual()"))
  empresa                      Empresa                     @relation(fields: [empresaId], references: [id])
  cuentaItemId                 String                      @unique
  cuentaItem                   CuentaItem                  @relation(fields: [empresaId, cuentaItemId], references: [empresaId, id], onDelete: Cascade)
  combinacionId                String
  combinacion                  CombinacionDeProducto       @relation(fields: [empresaId, combinacionId], references: [empresaId, id])
  /// ADITIVO, PROPIO o GRUPO (CHECK, coherente con las columnas de abajo).
  origenPrecio                 String
  precioDeSucursal             Boolean                     @default(false)
  grupoDePrecioId              String?
  grupoDePrecio                GrupoDePrecio?              @relation(fields: [empresaId, grupoDePrecioId], references: [empresaId, id])
  /// El nombre del grupo, copiado (la foto no cambia si el grupo se renombra).
  nombreGrupoDePrecio          String?
  /// El precio usado (PROPIO o GRUPO); NULL con ADITIVO (el precio quedó en la línea y en la foto de las opciones).
  precio                       Decimal?                    @db.Decimal(14, 2)
  recetaDeCombinacionVersionId String?
  recetaDeCombinacionVersion   RecetaDeCombinacionVersion? @relation(fields: [empresaId, recetaDeCombinacionVersionId], references: [empresaId, id])
  creadoEn                     DateTime                    @default(now())

  @@unique([empresaId, id])
  @@index([combinacionId])
}
