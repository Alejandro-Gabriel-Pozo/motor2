# Plantilla SIN secretos. Completar con la conexión de la RAMA COPIA de Neon (nunca la principal). Nunca commitear el archivo real.
DATABASE_URL=postgresql://motor2_app:<clave>@<endpoint-de-la-copia>/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:<clave>@<endpoint-de-la-copia>/neondb?sslmode=require
AUTH_SECRET=<32+ caracteres descartables>
AUTH_GOOGLE_ID=ensayo
AUTH_GOOGLE_SECRET=ensayo
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true
NODE_USE_ENV_PROXY=1   # solo para ARRANCAR (next start) detrás de un proxy HTTPS; NO para el build
PLATAFORMA_DATABASE_URL=postgresql://motor2_plataforma:<clave>@<endpoint-de-la-copia>/neondb?sslmode=require
PLATAFORMA_SECRETO_CODIGOS=<32+ caracteres>
PLATAFORMA_CLAVE_TOTP=<32 bytes en base64>
PLATAFORMA_URL_APP=http://localhost:3100
